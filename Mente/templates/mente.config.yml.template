# ⚠️ THIS IS THE TEMPLATE — not the live configuration.
# `bin/init` copies it to `mente.config.yml` and ASKS for what is missing. That file is never
# published: it carries the owner's name and their machine — INSTANCE data, not the engine's.
#
# 🔴 Why it exists, measured: the config used to travel inside the repo with the previous
# owner's name in it, so `bin/init` on someone else's clone **never asked for the owner** — it
# found the value already written and took it as truth. Personal data shipping as an engine default.

# ══ MENTE OS · INSTANCE CONFIG ══════════════════════════════════════════════
#
# ⭐ THE LINE THIS FILE DRAWS:
#
#   If you ever want other people to use Mente OS, this kind of thing is not something a normal
#   user should have to do — their focus is using the tool, not wiring it.
#
#   THE ENGINE      universal · cloned as-is · nobody edits it
#                   bin/ · hooks/ · rules/ · principles/ · the contracts
#
#   THE INSTANCE    yours · declared ONCE, here
#                   who you are · which projects are gated · which repos are siblings
#
# A new user edits THIS FILE and nothing else. If they ever have to touch bin/ to make the
# system work, this separation failed.
#
# ── WHY IT IS A FILE AND NOT HARDCODED ──────────────────────────────────────
# Measured, not assumed: four validators carried a hardcoded machine path, and every one of them
# failed SILENTLY when the path did not resolve (`if not js: return`). On any other machine the
# session watch — the guard that exists BECAUSE of a past incident — would simply go quiet.
# A guard aimed at a path that does not exist is not a guard; it is a green light.
#
# ── HOW TO ADAPT THIS FOR YOUR OWN INSTANCE ─────────────────────────────────
# Every ⬜ below is yours to fill. Everything without a ⬜ has a working default — leave it.
# 1. `owner.name`   — how you are referred to in the docs. `bin/init` asks for this.
# 2. `pillars`      — your project's architectural source(s) of truth.
# 3. `gates`        — trees the AI must NOT read without permission. Zero, one, or many.
# 4. `siblings`     — repos next to Mente/ whose uncommitted state is worth reporting.
# 5. `session.project_dir` is COMPUTED from the working directory (Claude Code derives it the
#    same way), so you normally leave it unset.
# ════════════════════════════════════════════════════════════════════════════

schema: v1

# ── WHO ─────────────────────────────────────────────────────────────────────
owner:
  # ⬜ REQUIRED. How you are referred to in the generated docs and in the checks that verify
  #    identity is not lost. `bin/init` asks for this.
  name: "{{owner}}"
  # ⬜ OPTIONAL. Names you must NEVER be called (known mistakes). Leave [] if none.
  #    Example (delete and put your own, or leave empty):  never_called: ["Jon Doe"]
  never_called: []

# ── PILLARS · your project's architectural sources of truth ──────────────────
# ⬜ The file(s) the AI treats as the ground it builds on. CLAUDE.md and PROJECT-RULES point
#    here instead of hardcoding a filename. Start from templates/ARCHITECTURE.md.template,
#    fill it in, then point at it. Leave null until the file exists.
#    Example:  architecture: "Cerebro/ARCHITECTURE.md"
pillars:
  architecture: null

# ── WHERE THE SESSION TRANSCRIPTS LIVE ──────────────────────────────────────
session:
  # Claude Code stores transcripts at ~/.claude/projects/<slug>, where <slug> is the working
  # directory with every "/" turned into "-". COMPUTED by default — do not hardcode it, or the
  # session watch goes silent on any other machine.
  #
  #   project_dir: -home-someone-myproject     # only to override the computed value
  project_dir: null

  # Thresholds calibrated against real data (rules/rule-session-close.md §4).
  size_warn_mb: 15
  size_red_mb: 50
  # A session is "heavy enough that losing it costs something" past this. A past incident came
  # from one of these.
  heavy_mb: 2

# ── HOOKS · where THIS host records which hooks it actually runs ────────────
# ⭐ A hook that exists and is not registered is a rule nobody enforces — and it
#    looks identical to one that works: the file is there, its probe is green,
#    and nothing ever calls it. ⚠️ Measured on this engine: three hooks
#    (gate-handoff, gate-accounts, watch-external) shipped wired to nothing.
#
# ⛔ The engine does NOT guess this path. Every host registers hooks
#    differently, and a guess produces a confident wrong answer — which is worse
#    than the ⬜ NOT MEASURED you get by leaving it null.
#
#    Claude Code:   .claude/settings.json
#    Leave null and `bin/check-health` reports the wiring as NOT MEASURED.
hooks:
  registry: null

# ── GATES · other trees the AI must not read without explicit permission ────
# ⬜ Declare the trees the AI must NOT read without permission. There may be ZERO, one, or many
#    — add as many entries as you need, or leave the list empty [].
#    Each becomes a deny rule + a battery check. It is cost control as much as privacy: reading
#    another Mente OS blows up token consumption (see connection/bridges/).
#
#    Copy this shape for each one (delete the example, it is not a real path):
#      - path: "~/another-project"
#        why: "a different project with its own Mente OS · opening it needs explicit approval"
gates: []

# ── SIBLINGS · repos beside Mente/ whose state is worth reporting ───────────
# ⬜ Repos next to Mente/ whose uncommitted state matters. ZERO, one, or many. Leave [] if none.
#    check-clear-ready reports uncommitted work here: the files survive a /clear, the REASON for
#    the change does not.
#    Copy this shape for each (delete the example):
#      - "my-app"
siblings: []

# ── PATHS TREATED AS OUTSIDE THIS TREE ──────────────────────────────────────
# check-links will not chase pointers into these. The tooling entries below are safe defaults
# that apply to almost everyone — keep them. Add your own repos/dirs under the ⬜ line.
outside:
  - ".claude/"
  - ".codeviz"          # generated code diagrams, sibling of Mente/
  - "workspace"
  - "node_modules"
  # ⬜ add your own repos/dirs to ignore below, one per line:
  # - "my-other-repo"

# ── SECRETS ─────────────────────────────────────────────────────────────────
secrets:
  # Never in git. Referenced, never pasted (rules/rule-config-hygiene.md §1.1).
  dir: "secrets"

# ── THE ENGINE / INSTANCE FRONTIER ──────────────────────────────────────────
# ⭐ The ENGINE is universal and cloned as-is; the INSTANCE is yours, declared once.
# That line once lived ONLY inside a code docstring: a frontier that exists only in a
# comment is a frontier no validator can consult and no new owner can ever see. Declaring
# it here is what makes it checkable.
#
# ⚠️ Three flat keys instead of one nested block: this file's parser handles TWO levels on
# purpose (a hand-written general parser is a bug generator), and a third level flattened the
# groups into a single list — losing exactly what is being declared.
#
# ⛔ The engine is not edited inside an instance. The instance never travels when the engine ships.

# universal · cloned as-is · ⛔ NOT edited here
frontier_engine:
  - "bin"
  - "hooks"
  - "rules"
  - "principles"
  - "templates"

# yours · born empty or generated · ⛔ never travels when the engine ships
frontier_instance:
  - "Cerebro"        # your project's own thinking — the pillar and the vision
  - "cache"          # the validators' local state · never travels
  - "memory"         # ⚠️ except memory/principles/, which is engine doctrine
  - "secrets"
  - "work"           # blocks and campaigns live inside it
  - "connection"

# ⚠️ contains both — engine contracts and the instance's own logs
frontier_mixed:
  - "docs"