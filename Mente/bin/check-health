#!/usr/bin/env python3
"""check-health — the two things no other validator watches.

⭐ WHAT THIS IS NOT. It is deliberately NOT "run every validator": the startup
hook already discovers and runs them all, and a second piece doing the same
thing would be a copy that drifts. ⛔ Measured before writing it: 8 of the 10
concerns a health check would cover are already owned by a specific validator,
and duplicating them would mean two answers to one question.

Two are not owned by anything, and both are about the SYSTEM rather than its
contents:

  ① ⭐ ARE THE HOOKS ACTUALLY WIRED · three validators each check one hook.
     Nothing checks the SET. ⛔ A hook that exists and is not registered with the
     host never runs, and looks installed — the failure that reads as success.

  ② 🔴 IS THIS SESSION STILL SAFE TO CONTINUE · nothing measures it. A past
     incident came from a session that grew for days: the work degrades long
     before anything breaks, and there is no error to notice.

⬜ Everything host-specific is DECLARED, never assumed: where transcripts live,
where the host registers hooks, and the thresholds. Unset means NOT MEASURED,
said out loud — ⛔ a health check that stays quiet because it could not look is
worse than none, since silence is what health looks like.

Usage: check-health [--quiet]
Exit: 0 healthy or nothing measurable · 1 something needs attention
"""
import json
import os as _os, sys as _sys
_d = _os.path.dirname(_os.path.abspath(__file__))
while _d != _os.path.dirname(_d):
    if _os.path.exists(_os.path.join(_d, "bin", "utf8.py")):
        _sys.path.insert(0, _os.path.join(_d, "bin")); break
    _d = _os.path.dirname(_d)
import utf8                                          # noqa: F401,E402
import os
import re
import subprocess
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
# ⭐ The repository, not the engine folder: git lives one level up, because
# Mente OS is a tool dropped INTO somebody's project.
REPO = os.path.dirname(ROOT)
CONFIG = os.path.join(ROOT, "mente.config.yml")
HOOKS = os.path.join(ROOT, "hooks")

# ⭐ HOW MANY CONCERNS THIS CHECK COVERS — declared here, never as a literal
# in the summary. Raise it in the same commit that adds the concern.
CONCERNS = 3

findings, gaps, notes = [], [], []


# ⭐ A NOTE IS NOT A GAP, and conflating them produced "-1 of 2 concerns
# measured". A gap is a CONCERN that could not be checked; a note is context
# about how the checking was configured. ⛔ Counting a note as a gap makes the
# summary arithmetic lie, and a health summary that cannot count is not read.


def red(msg):
    findings.append(msg)


def gap(msg):
    gaps.append(msg)


def note(msg):
    notes.append(msg)


def config():
    """The declared values. ⭐ A two-level reader, deliberately not a general
    YAML parser: a hand-written general parser is a bug generator, and this file
    has one shape."""
    out, section = {}, None
    try:
        for line in open(CONFIG, encoding="utf-8", errors="replace"):
            raw = line.rstrip("\n")
            if not raw.strip() or raw.lstrip().startswith("#"):
                continue
            if not raw.startswith((" ", "\t")):
                section = raw.split(":")[0].strip()
                continue
            m = re.match(r"\s+([\w_]+):\s*(.*?)\s*$", raw)
            if m and section:
                v = m.group(2).strip().strip('"\'')
                out["%s.%s" % (section, m.group(1))] = v
    except OSError:
        return None
    return out


# ── ① ARE THE HOOKS WIRED ───────────────────────────────────────────────────
def hooks_wired(cfg):
    """⭐ The SET of hooks, not one of them.

    ⬜ MENTE_HOOK_REGISTRY · the file where the host records which hooks it runs.
    Unset means NOT MEASURED: this engine does not know how any particular host
    registers a hook, and guessing would produce a confident wrong answer.

    ⚠️ Reports a hook the registry never NAMES. It cannot report one the host
    silently ignores — that is outside anything this engine can see, and the
    limit is stated rather than hidden.
    """
    reg = os.environ.get("MENTE_HOOK_REGISTRY") or (cfg or {}).get("hooks.registry")
    # ⛔ `null` IS "not declared". 🔴 Measured on a fresh install: the template
    # ships `registry: null`, the parser hands back the four-letter STRING, and
    # the message read "declared registry does not exist: null" — ⚠️ which tells
    # a new user their configuration is broken when it is simply untouched.
    if isinstance(reg, str) and reg.strip().lower() in ("null", "none", "~", ""):
        reg = None
    if not reg:
        gap("hook wiring · ⬜ no registry declared (MENTE_HOOK_REGISTRY or "
            "hooks.registry) · whether the hooks run was NOT checked")
        return
    path = reg if os.path.isabs(reg) else os.path.join(os.path.dirname(ROOT), reg)
    if not os.path.exists(path):
        gap("hook wiring · ⬜ declared registry does not exist: %s" % reg)
        return
    try:
        text = open(path, encoding="utf-8", errors="replace").read()
    except OSError as e:
        gap("hook wiring · ⬜ registry unreadable (%s)" % e.__class__.__name__)
        return

    try:
        names = sorted(n for n in os.listdir(HOOKS)
                       if not n.startswith(("_", "."))
                       and n != "README.md"
                       and os.path.isfile(os.path.join(HOOKS, n)))
    except OSError:
        gap("hook wiring · ⬜ hooks/ unreadable · nothing was compared")
        return

    # ⭐ A GIT HOOK IS REGISTERED BY A LINK, NOT BY TEXT. `pre-commit.sh` and
    # `pre-push.sh` live in .git/hooks/ as symlinks that git cannot carry, so
    # they will never appear in a host's settings file — ⛔ reporting them as
    # unregistered was a true statement about the wrong registry, and it teaches
    # the reader to ignore the finding.
    #
    # ⚠️ AND A LINK IS NOT THE ONLY WAY IT IS REGISTERED. 🔴 Measured 2026-09-05
    # on Windows: `os.symlink` needs a privilege a normal account lacks, so
    # `bin/init` writes a small launcher that invokes the shipped hook. The hook
    # RUNS. This check counted symlinks only and called both hooks absent —
    # ⛔ a red on a machine where nothing was wrong, which is how a real red
    # stops being read.
    githooks = os.path.join(os.path.dirname(ROOT), ".git", "hooks")
    linked = set()
    if os.path.isdir(githooks):
        for n in os.listdir(githooks):
            q = os.path.join(githooks, n)
            if os.path.islink(q):
                linked.add(os.path.basename(os.readlink(q)))
                continue
            # ⭐ A launcher counts only if it actually reaches a shipped hook —
            # a file that exists and invokes nothing is the failure itself.
            if os.path.isfile(q):
                try:
                    body = open(q, encoding="utf-8", errors="replace").read()
                except OSError as e:
                    # ⬜ CHK-CAU-003 · said out loud. An unreadable file is not
                    # a wired hook and not an absent one — it is unknown, and
                    # swallowing it would let a real gap report green.
                    gap("hook wiring · ⬜ .git/hooks/%s unreadable (%s) · "
                        "whether it wires a hook was NOT checked"
                        % (n, e.__class__.__name__))
                    continue
                for h in names:
                    if ("hooks/" + h) in body.replace("\\", "/"):
                        linked.add(h)

    absent = [n for n in names if n not in text and n not in linked]
    if absent:
        red("%d hook(s) exist and the registry never names them: %s\n"
            "   ⛔ A hook the host does not know about NEVER RUNS, and looks "
            "installed.\n"
            "   Registry: %s" % (len(absent), ", ".join(absent), reg))


# ── ② IS THIS SESSION STILL SAFE ────────────────────────────────────────────
def session(cfg):
    """🔴 The guard that exists because of a past incident.

    ⚠️ The damage is not a crash. A session that grows for days degrades the
    work long before anything breaks — the scope drifts, earlier decisions stop
    being visible, and there is NO error to notice. ⛔ By the time something
    fails, the wrong answers have already been given.

    ⬜ Where transcripts live is the host's, and the thresholds are the
    installation's.
    """
    d = os.environ.get("MENTE_SESSION_DIR") or (cfg or {}).get("session.project_dir")
    if not d or d == "null":
        gap("session weight · ⬜ no transcript directory declared "
            "(MENTE_SESSION_DIR or session.project_dir) · session size was NOT "
            "measured")
        return
    d = os.path.expanduser(d)
    if not os.path.isdir(d):
        gap("session weight · ⬜ declared transcript directory does not exist: "
            "%s" % d)
        return

    def num(key, default):
        try:
            return float((cfg or {}).get(key) or default)
        except (TypeError, ValueError):
            return float(default)

    warn = num("session.size_warn_mb", 15)
    stop = num("session.size_red_mb", 50)

    # ⭐ The CURRENT session, named by the host when it can. ⛔ Taking the newest
    # file by modification time is a guess, and it is wrong in exactly the window
    # that matters: right after a reset the new transcript is small and loses to
    # the previous one — so the guard measures a session that already ended and
    # announces an age nobody is living.
    live = os.environ.get("MENTE_SESSION_ID")
    files = []
    try:
        for n in os.listdir(d):
            p = os.path.join(d, n)
            if os.path.isfile(p):
                files.append(p)
    except OSError:
        gap("session weight · ⬜ transcript directory unreadable")
        return
    if not files:
        gap("session weight · ⬜ no transcript in %s · nothing to measure" % d)
        return

    target = None
    if live:
        target = next((p for p in files if live in os.path.basename(p)), None)
    guessed = target is None
    if target is None:
        target = max(files, key=os.path.getmtime)

    mb = os.path.getsize(target) / (1024 * 1024)
    how = " (guessed — the host named no session)" if guessed else ""
    if mb >= stop:
        red("this session is %.0f MB, past the %.0f MB limit%s\n"
            "   ⛔ The work degrades before anything breaks, and there is no "
            "error to notice.\n"
            "   Record what matters and start a fresh session." % (mb, stop, how))
    elif mb >= warn:
        red("this session is %.0f MB — watch it (limit %.0f)%s" % (mb, stop, how))


def engine_updates(cfg):
    """⭐ IS THERE A NEWER ENGINE? Said at session start, never acted upon.

    🔴 THE FAILURE, measured 2026-09-08 on a real install. Nothing in the whole
    engine mentioned updates — not a remote, not a notice, not one line of
    documentation. ⛔ So an assistant setting up a fresh copy read it as an OPEN
    QUESTION and asked the person, offering "cut the link completely" as the
    recommended answer. The person is the one who writes the engine's
    improvements; the recommended answer guaranteed their copy never sees them.

    ⭐ IT ONLY LOOKS AT WHAT IS ALREADY ON DISK. `git fetch` is a network call,
    and a health check that reaches the network is a health check that hangs on
    a plane. ⚠️ So this compares against the last fetch — which means it says
    "up to date" the day after a fetch and stays quiet until the next one.
    ⛔ That is stated in the message, never hidden: a stale comparison presented
    as current is worse than no comparison.

    ⚠️ AND IT NEVER PULLS. Bringing changes in could overwrite the person's own
    work with no warning; the decision to merge is theirs, always.
    """
    def git(*a):
        return subprocess.run(("git",) + a, cwd=REPO, capture_output=True,
                              text=True, timeout=15)
    try:
        if git("rev-parse", "--git-dir").returncode != 0:
            # ⬜ CHK-CAU-003 · SAID, never a silent return. 🔴 Caught the hour
            # this landed: returning quietly left the concern counted as
            # measured, so a folder with no git at all reported "1 of 3
            # measured" — a ✅ over a check that never ran, which is the exact
            # failure the top of this file names first.
            gap("engine updates · this folder is not a git repository · "
                "whether a newer Mente OS exists cannot be checked here")
            return
        if git("remote", "get-url", "upstream").returncode != 0:
            gap("engine updates · no `upstream` remote · this copy cannot see "
                "whether a newer Mente OS exists · ⭐ wire it once:  "
                "git remote add upstream "
                "https://github.com/for3slabs/mente-os.git")
            return
        # ⭐ THE ENGINE'S BRANCH IS ASKED, NEVER ASSUMED. 🔴 Caught the hour
        # this landed: the first version compared against `upstream/main`, and
        # a repository created with git's older default is on `master` — so
        # `rev-list` failed and the check reported "nothing fetched yet" on a
        # tree that had fetched perfectly. ⛔ A person on `master` would never
        # have seen a single update, and the reason given would have been
        # wrong. ⚠️ `symbolic-ref` answers what the remote itself says its
        # default is; the fallbacks cover a remote fetched before that ref
        # existed.
        ref = git("symbolic-ref", "--short",
                  "refs/remotes/upstream/HEAD").stdout.strip()
        cands = [ref] if ref else []
        cands += ["upstream/main", "upstream/master"]
        r, ref = None, None
        for c in cands:
            probe = git("rev-list", "--count", "HEAD..%s" % c)
            if probe.returncode == 0:
                r, ref = probe, c
                break
        if r is None:
            gap("engine updates · nothing fetched from `upstream` yet · run "
                "`git fetch upstream` once and this will say whether a newer "
                "engine exists")
            return
        try:
            behind = int(r.stdout.strip() or 0)
        except ValueError:
            gap("engine updates · git answered something unreadable · NOT "
                "MEASURED")
            return
        if behind:
            note("⭐ %d newer commit(s) in Mente OS since this copy · nothing "
                 "was changed · to see them: git log HEAD..%s · to bring them "
                 "in: git merge %s" % (behind, ref, ref))
    except (OSError, subprocess.SubprocessError) as e:
        gap("engine updates · could not reach git (%s) · whether a newer "
            "engine exists was NOT checked" % e.__class__.__name__)


def main():
    quiet = "--quiet" in sys.argv
    # ⛔ AN ABSENT CONFIG IS NOT A REASON TO MEASURE NOTHING. Found on a clean
    # clone, invisible here: mente.config.yml is an instance file, so a clone
    # legitimately lacks one — and returning early meant the environment
    # variables were ignored too. ⚠️ The checks then reported "nothing declared"
    # while the operator had declared everything, which is a health report that
    # is wrong in the confident direction.
    # ⭐ An empty config is the right default: each check already says what it
    # could not see.
    cfg = config()
    if cfg is None:
        note("no mente.config.yml · only what the environment declares was read")
        cfg = {}
    hooks_wired(cfg)
    session(cfg)
    engine_updates(cfg)

    if not quiet:
        for n in notes:
            print("· %s" % n)
        for g in gaps:
            print("⬜ NOT MEASURED · %s" % g)
    if findings:
        for f in findings:
            print("🔴 %s" % f)
        print("\n%d finding(s) · check-health" % len(findings))
        return 1
    if not quiet and not gaps:
        print("✅ hooks wired · session within its limits")
    elif not quiet:
        # ⛔ Never a bare ✅ over checks that could not run: absence of evidence
        # read as evidence is the failure this whole system names first.
        # ⭐ THE DENOMINATOR IS DECLARED ONCE, beside the checks it counts.
        # 🔴 Adding a third concern and leaving the literal `2` here printed
        # "-1 of 2 concern(s) measured" — the exact arithmetic failure this
        # file's own comment records from the first time. ⛔ A summary that
        # cannot count is a summary nobody reads.
        print("· %d of %d concern(s) measured · nothing wrong in those"
              % (CONCERNS - len(gaps), CONCERNS))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:                                     # noqa: BLE001
        # CHK-CAU-002 · a crash reports nothing, and nothing reads as fine.
        print("🔴 %s crashed · %s: %s"
              % (os.path.basename(__file__), type(e).__name__, e))
        sys.exit(1)
