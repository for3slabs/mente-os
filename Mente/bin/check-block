#!/usr/bin/env python3
"""check-block — enforces the 🔒 rows of rules/contract-block.md

Every finding names the contract ID it comes from, the expected value and
the one found, so it is actionable without opening this file.

Exit: 0 clean · 1 violations · 2 the contract itself is missing
"""
import os, re, sys, json, glob, datetime
import os as _os, sys as _sys
_d = _os.path.dirname(_os.path.abspath(__file__))
while _d != _os.path.dirname(_d):
    if _os.path.exists(_os.path.join(_d, "bin", "utf8.py")):
        _sys.path.insert(0, _os.path.join(_d, "bin")); break
    _d = _os.path.dirname(_d)
import utf8                                          # noqa: F401,E402
import plat                                          # noqa: E402
from datetime import date

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
# ⭐ ONE CONTRACT, TWO FILES. The lifecycle half and the sections half were
# split when together they passed the ceiling for their type. ⛔ A reader that
# opens only one of them sees half the rules and reports the other half as
# missing — measured the moment the split happened: the type and lane
# vocabularies live in the SECTIONS half, and this stopped finding them.
CONTRACT_PARTS = (os.path.join(ROOT, "rules", "contract-block.md"),
                   os.path.join(ROOT, "rules",
                                "contract-block-sections.md"))
CONTRACT = CONTRACT_PARTS[0]      # the half that names the rule set


def contract_text():
    """Both halves as one body of text — ⭐ the contract as it reads."""
    out = []
    for q in CONTRACT_PARTS:
        try:
            out.append(open(q, encoding="utf-8", errors="replace").read())
        except OSError:
            # ⬜ A half that cannot be read is half a contract, and the
            # caller reports that rather than measuring against it.
            continue
    return "\\n".join(out)


# ── BLK-CHK-001 · the checkpoint fields, READ FROM THE CONTRACT ─────────────
# ⛔ Hardcoding them here would make two places declare one thing, and the copy
# is the one that goes stale — measured twice in this engine already. ⭐ The
# contract's §I field table is the source; this only reads it.
_FIELD_ROW = re.compile(r"^\|\s*(?:⭐\s*)?`([a-z ]+)`\s*\|", re.M)


def checkpoint_fields():
    """The field names §I requires, in the order the contract lists them.

    ⬜ An unreadable or reworded contract yields an EMPTY list, and an empty
    list checks nothing — ⛔ said here rather than silently defaulting to a
    guessed set, because a checker measuring against its own guess reports
    defects the contract never declared.
    """
    t = contract_text()
    m = re.search(r"### I · Checkpoints.*?(?=\n### |\n---\n)", t, re.S)
    return _FIELD_ROW.findall(m.group(0)) if m else []


def _checkpoints(body):
    """The individual entries in §I.

    ⭐ Split on the heading or list marker that opens each one, because a block
    accumulates checkpoints and only reporting the first would hide the rest —
    the same `break` defect DOC-CNT-004 already paid for.
    ⚠️ A §I with no separator at all is ONE entry, not zero: an unsplittable
    body still has to carry its fields.
    """
    parts = re.split(r"\n(?=\s*(?:#{3,}\s|[-*]\s*\*\*|\|\s*\d))", body)
    return [q for q in parts if re.search(r"[A-Za-z]", q)] or [body]


def _first_line(entry):
    """A short label for the entry, so a finding says WHICH checkpoint."""
    for line in entry.strip().splitlines():
        line = line.strip(" -*#|").strip()
        if line:
            return line[:40]
    return "(unnamed)"


# ── BLK-SUB-004 · the evidence cell of a sub-block row ──────────────────────
# ⭐ The column is found by its HEADER, never by position: the contract's table
# has seven columns and inserting one ahead of `evidence` would silently move
# every check to the wrong cell.
DATE = re.compile(r"\b20\d{2}-\d{2}-\d{2}\b")


def _subblock_numbers(body):
    """The `#` cell of every sub-block row — ⭐ the level lives in the number.

    ⚠️ Read by HEADER like the evidence cell, never by position: the contract's
    table has seven columns and inserting one ahead of `#` would move the check
    to the wrong cell.
    """
    out, col = [], None
    for line in body.splitlines():
        if not line.strip().startswith("|"):
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if col is None:
            for i, c in enumerate(cells):
                if c.strip() in ("#", "no", "n"):
                    col = i
                    break
            continue
        if len(cells) <= col or set(cells[0]) <= set("- :"):
            continue
        n = cells[col].strip("`* ")
        if re.fullmatch(r"\d+(?:\.\d+)*", n):
            out.append(n)
    return out


def _subblock_evidence(body):
    """(row label, evidence cell) for each sub-block row that HAS evidence.

    ⬜ A row whose evidence cell is empty or ⬜ is unfinished work, not a defect:
    the sub-block has not produced its proof yet, and demanding one would make
    every freshly-planned row a violation.
    """
    out, col, task_col = [], None, None
    for line in body.splitlines():
        if not line.strip().startswith("|"):
            continue
        cells = [c.strip() for c in line.strip().strip("|").split("|")]
        if col is None:
            for i, c in enumerate(cells):
                name = re.sub(r"[^a-z]", "", c.lower())
                if name == "evidence":
                    col = i
                elif name == "task":
                    task_col = i
            continue
        if len(cells) <= col or set(cells[0]) <= set("- :"):
            continue
        ev = cells[col]
        if ev and "⬜" not in ev and ev not in ("—", "-"):
            # ⭐ Labelled by the TASK, not the row number: "sub-block 2" sends
            # the reader counting rows, and the task names itself.
            label = cells[task_col] if task_col is not None \
                and len(cells) > task_col else cells[0]
            out.append((label or "(unnamed)", ev))
    return out


# ── BLK-CLS-008 · the minimum evidence level each lane requires ─────────────
# ⭐ READ FROM THE CONTRACT, never listed here: the table binds lane to level,
# and a copy in code is the half that goes stale. ⛔ "Tested" is not a level —
# a change that can break a live flow needs end-to-end proof, one that renames
# a variable does not, and without a declared level both close on whichever
# proof was cheaper.
LEVEL = re.compile(r"\bL([0-5])\b")


def lane_minimum():
    """{lane: minimum level}, or an EMPTY dict if the table cannot be read.

    ⬜ Empty checks nothing, and that is said rather than defaulting to a
    guessed floor — ⛔ a checker measuring against its own guess refuses work
    on a bar the contract never set.
    """
    t = contract_text()
    m = re.search(r"### ⭐ `BLK-CLS-008`.*?(?=\n> ⚠️ \*\*A minimum)", t, re.S) \
        or re.search(r"`BLK-CLS-008`.*?(?=\n> ⚠️ \*\*A minimum)", t, re.S)
    if not m:
        return {}
    out = {}
    for line in m.group(0).splitlines():
        # ⚠️ A cell may carry a ⭐ before its value — the marker is emphasis,
        # not data, and requiring the bold to follow the pipe silently dropped
        # the `full-block` row: the one lane where the level matters most.
        row = re.match(r">\s*\|\s*`([a-z-]+)`\s*\|\s*(?:⭐\s*)?\*\*L(\d)\*\*",
                       line)
        if row:
            out[row.group(1)] = int(row.group(2))
    return out

BLOCKS = os.path.join(ROOT, "work", "blocks")

# ⭐ ONE reader for a block's sections — bin/blockread.py. It lived as four
# copies here and the comparable ones had already diverged: two could not see a
# section headed by its NAME, so every section read empty and the checks
# reported findings against a file they had never read.
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from blockread import (sections, order, body_of, SEC, NAMES,   # noqa: E402,F401
                       DEPENDS, dependencies)

# ⭐ ONE way to report many findings, shared by every validator —
# CHK-SHR-001. ⛔ Thirteen validators each inventing a grouping is
# thirteen report formats, and a reader who must learn one per
# validator learns none.
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from findings import report                                    # noqa: E402


STATUSES = {"active", "blocked", "closed"}
TYPES = {"code", "docs", "infra", "data"}
LANES = {"direct", "task", "full-block"}
OPEN_SECTIONS = ["A", "B", "C", "D"]


def declared():
    """⬜ Read the thresholds FROM the contract. ⛔ A threshold that lives only
    in code is a decision nobody knows was taken — and two rules here said
    "a declared period" while the period was a literal in this file."""
    days, ceil = 0, {}
    try:
        t = contract_text()
    except OSError:
        return days, ceil
    m = re.search(r"⬜ stale period[^|]*\|\s*(\d+)", t)
    if m:
        days = int(m.group(1))
    for sec, n in re.findall(r"\|\s*⬜ ([A-K]) `[^`]+`\s*\|\s*(\d+)\s*\|", t):
        if int(n) > 0:
            ceil[sec] = int(n)
    return days, ceil


STALE_DAYS, CEILINGS = declared()

# A section is marked either as a markdown heading (## A · Identity) or as a
# banner comment (<!-- ══ A · IDENTITY ══ -->). Reading only one shape reports
# zero sections on a block written in the other — measured against real blocks.
# The banner form must be a BANNER, not any comment that happens to contain a
# capital letter: an ordinary comment mentioning a tool name was being read as a
# section, which reported the sections out of order on a correctly ordered block.
# ⛔ A field after a `·` on the same line was invisible: `^` anchored to the
# line start, so `created: X · updated: Y` reported "no updated date" while the
# date sat in plain view. Measured on real blocks, which write it that way.
# ⭐ Same defect corrected in check-campaign — one shape, two readers, and only
# one had been fixed.
FIELD = re.compile(r"(?:^|·)[ \t]*(id|type|intent|status|lane|owner|created|updated):"
                   r"[ \t]*([^\n·]*?)[ \t]*(?=·|$)", re.M)
ISO = re.compile(r"\d{4}-\d{2}-\d{2}")

# ⬜ What a section is CALLED belongs to the installation; the engine fixes
# only WHAT must be answered. Measured: real blocks head their closing
# `## Closing`, with no letter — and a reader that requires `## K ·` finds
# nothing there, so four closed blocks passed a check that never ran.
NAMES = {"A": "identity", "B": "scope", "C": "connections",
         "D": "required standards", "E": "state", "F": "sub-?blocks",
         "G": "decisions", "H": "friction", "I": "checkpoints",
         "J": "context", "K": "closing"}

def index_files():
    """⬜ Where blocks are LISTED — the installation's: any campaign, or the
    blocks README. ⭐ ONE definition, used by both directions of the rule: if
    BLK-OPN-002 and BLK-OPN-003 disagreed about what an index is, one of them
    would be checking a file the other ignores."""
    out = glob.glob(os.path.join(ROOT, "work", "campaigns", "*", "CAMPAIGN.md"))
    readme = os.path.join(BLOCKS, "README.md")
    if os.path.exists(readme):
        out.append(readme)
    return out


# ⚠️ Words a README legitimately shows in a list without naming a block: the
# state folders, and the file every block folder holds. ⛔ Without this the rule
# reports a folder-structure diagram as a dead entry.
SKIP_INDEX_WORDS = {"active", "blocked", "archive", "none"}


def check(path, rel, ids):
    bad = []
    text = open(path, encoding="utf-8").read()
    f = dict(FIELD.findall(text))
    have = sections(text)

    # BLK-OPN-001 · the four opening sections
    missing = [s for s in OPEN_SECTIONS if s not in have]
    if missing:
        bad.append(("BLK-OPN-001", rel,
                    "missing opening section(s) %s · expected: A B C D · got: %s"
                    % (" ".join(missing), " ".join(sorted(have)) or "none")))

    # BLK-SHP-002 · sections in order
    seq = order(text)
    if seq != sorted(seq):
        bad.append(("BLK-SHP-002", rel,
                    "sections out of order · expected ascending · got: %s" % " ".join(seq)))

    # BLK-IDN-001 · id present and unique
    bid = f.get("id", "").strip("`* ")
    if not bid:
        bad.append(("BLK-IDN-001", rel, "no id declared"))
    elif bid in ids:
        bad.append(("BLK-IDN-001", rel,
                    "id %r already used by %s · resolution is exact" % (bid, ids[bid])))
    else:
        ids[bid] = rel

    # BLK-IDN-002 · type
    ty = f.get("type", "").strip("`* ")
    if ty not in TYPES:
        bad.append(("BLK-IDN-002", rel,
                    "type missing or unknown · expected one of %s · got: %r"
                    % ("|".join(sorted(TYPES)), ty)))

    # BLK-IDN-003 · intent is one sentence
    intent = f.get("intent", "").strip()
    if not intent:
        bad.append(("BLK-IDN-003", rel, "no intent"))
    elif intent.count(".") > 1 or len(intent) > 160:
        bad.append(("BLK-IDN-003", rel,
                    "intent is not one sentence · got %d chars" % len(intent)))

    # BLK-IDN-004 · status
    st = f.get("status", "").strip("`* ")
    if st not in STATUSES:
        bad.append(("BLK-IDN-004", rel,
                    "status missing or unknown · expected one of %s · got: %r"
                    % ("|".join(sorted(STATUSES)), st)))

    # lane, when declared, must be one of the three
    lane = f.get("lane", "").strip("`* ")
    if lane and lane not in LANES:
        bad.append(("BLK-IDN-004", rel,
                    "lane unknown · expected one of %s · got: %r"
                    % ("|".join(sorted(LANES)), lane)))

    # BLK-IDN-005 · updated present, ISO, and not stale
    upd = f.get("updated", "")
    m = ISO.search(upd)
    if not m:
        if "{{" not in upd:
            bad.append(("BLK-IDN-005", rel, "no updated date · expected YYYY-MM-DD"))
    else:
        try:
            d = datetime.date.fromisoformat(m.group(0))
            age = (datetime.date.today() - d).days
            if age > STALE_DAYS and st != "closed":
                bad.append(("BLK-IDN-005", rel,
                            "stale · updated %s · %d days ago · limit %d · "
                            "is it still current?" % (m.group(0), age, STALE_DAYS)))
        except ValueError:
            bad.append(("BLK-IDN-005", rel, "updated not a real date: %r" % m.group(0)))

    # BLK-SCP-001 · scope has both halves
    b = body_of(text, "B")
    if "B" in have:
        if not re.search(r"(✅|^)\s*IN\b", b, re.M) or not re.search(r"(⛔|^)\s*OUT\b", b, re.M):
            bad.append(("BLK-SCP-001", rel,
                        "scope missing a half · expected both IN and OUT · "
                        "an IN with no OUT is a wish, not a boundary"))
        else:
            # ⭐ NON-EMPTY means FILLED IN, not merely present. 🔴 Measured on a
            # fresh install: bin/new-block ends with "fill the ⬜ in §B before
            # starting" and check-block answered ✅ 0 violations on the
            # untouched template — ⛔ the engine asking for something it does
            # not then require is how a new user learns the ⬜ are decoration.
            for half, rx in (("IN", r"(?:✅|^)\s*IN\b(.*?)(?=\n\s*(?:###|##|⛔)|\Z)"),
                             ("OUT", r"(?:⛔|^)\s*OUT\b(.*?)(?=\n\s*(?:###|##)|\Z)")):
                m = re.search(rx, b, re.S | re.M)
                body = m.group(1) if m else ""
                lines = [l.strip() for l in body.splitlines()
                         if l.strip().startswith(("-", "*"))]
                if lines and all("⬜" in l for l in lines):
                    bad.append(("BLK-SCP-001", rel,
                                "§B %s carries only its ⬜ placeholder · ⭐ a "
                                "boundary nobody wrote is not a boundary · "
                                "`bin/new-block` said to fill it" % half))

    # BLK-SCP-002 · every OUT line states where it comes from.
    # An unsourced limit is an opinion enforced as a rule.
    if "B" in have:
        m = re.search(r"(?:⛔|##)\s*OUT\b(.*?)(?=\n\s*(?:###|##|<!--)|\Z)", b, re.S)
        if m:
            for line in m.group(1).splitlines():
                t = line.strip()
                if not t.startswith(("-", "*")):
                    continue
                sourced = ("DERIVED:" in t or re.search(r"[\w./-]+\.\w+:\d+", t)
                           or re.search(r"\b(deny|denied|locked|blocked by)\b", t, re.I)
                           or re.search(r"`[\w./-]+\.(md|yml|json|tsv)`", t))
                if not sourced:
                    bad.append(("BLK-SCP-002", rel,
                                "OUT line states no source: %r · expected a file "
                                "reference, a technical lock, or DERIVED: · "
                                "an unsourced limit is an opinion" % t[:55]))
                    break

    # BLK-STD-002 · each declared standard resolves
    d = body_of(text, "D")
    for ref in re.findall(r"`([A-Za-z0-9_./-]+\.md)`", d):
        cands = [os.path.join(ROOT, ref), os.path.join(os.path.dirname(path), ref)]
        if not any(os.path.exists(c) for c in cands):
            bad.append(("BLK-STD-002", rel,
                        "declared standard does not exist: %s · "
                        "a standard pointing at nothing is not a standard" % ref))

    # BLK-BLK-001 · a blocked block names what would unblock it
    if st == "blocked":
        e = body_of(text, "E")
        if not re.search(r"\b(unblock|blocked by|waiting on|needs)\b", e, re.I):
            bad.append(("BLK-BLK-001", rel,
                        "blocked with no unblocker named · "
                        "'waiting' is not a blocker"))

    # BLK-SHP-001 · ONE file per block. ⛔ Splitting a short file adds places
    # to look without adding anything to read, and the reader who must open
    # three files to know where the work stands opens none.
    sibs = [n for n in os.listdir(os.path.dirname(path))
            if n.endswith(".md") and n != "BLOCK.md"
            and not n.upper().startswith("README")]
    if sibs:
        bad.append(("BLK-SHP-001", rel,
                    "%d sibling document(s) beside BLOCK.md (%s) · one file per "
                    "block: a reader who must open three to know where the work "
                    "stands opens none" % (len(sibs), ", ".join(sorted(sibs)[:3]))))

    # BLK-SUB-003 · the parent does not close over an open sub-block — the
    # check for that lives in the closing branch above and in
    # hooks/gate-critical.py, which refuses the write itself.

    # ── BLK-SUB-004 · evidence is a claim someone else can re-run ───────────
    # ⛔ "done" and "55 documents, bin/check-document, 2026-09-01" are different
    # claims: the first cannot be re-checked, so it cannot be found wrong — ⭐ and
    # a claim that cannot be found wrong is not evidence, it is a statement.
    # ⚠️ Only rows that HAVE an evidence cell filled: an ⬜ row is a sub-block
    # nobody has finished, which is a state and not a defect.
    # ── BLK-SUB-005 · at most three levels of nesting (ADR-015) ────────────
    # ⛔ The decision fixed three — unit of work · GROUP · task — and only two
    # were built, so large work arrived flat: measured at fourteen sub-blocks
    # in one real block. ⚠️ Three is a CEILING: a block needing four is a block
    # that should have been two, and that is the finding, not a format problem.
    for num in _subblock_numbers(body_of(text, "F") or ""):
        if num.count(".") >= 2:
            bad.append(("BLK-SUB-005", rel,
                        "sub-block %r is a fourth level · ⛔ ADR-015 fixes three "
                        "(unit · group · task) · ⭐ work needing a fourth is work "
                        "that should have been two blocks" % num))

    for row, ev in _subblock_evidence(body_of(text, "F") or ""):
        if not DATE.search(ev):
            bad.append(("BLK-SUB-004", rel,
                        "sub-block %r · evidence %r names no date · ⛔ a number "
                        "with no date is correct exactly once and quoted "
                        "forever" % (row[:28], ev[:34])))

    # BLK-OPN-002 · the block is declared where blocks are LISTED.
    # ⛔ A block on disk that no index names is a block nothing knows exists:
    # it is never picked up, never closed, and never missed.
    # ⬜ Where blocks are listed is the installation's: any campaign, or a
    # blocks README. ⛔ With no index at all this is NOT MEASURED, not a pass.
    if st != "closed" and bid:
        indexes = index_files()
        if indexes and not any(
                bid in open(q, encoding="utf-8", errors="replace").read()
                for q in indexes):
            bad.append(("BLK-OPN-002", rel,
                        "%r is on disk and no index names it · nothing knows it "
                        "exists, so nobody picks it up and nobody misses it"
                        % bid))

    # BLK-BLK-002 · blocked past the ⬜ declared period → it is ASKED about.
    # ⚠️ Not accused: a blocked block is not a failure. What is a failure is one
    # blocked for a month nobody ever asks about — it stops being blocked and
    # starts being abandoned, and the two look identical from outside.
    if st == "blocked" and STALE_DAYS:
        m_up = re.search(r"^updated:\s*(\d{4}-\d{2}-\d{2})", text, re.M)
        if m_up:
            age = (date.today() - date.fromisoformat(m_up.group(1))).days
            if age > STALE_DAYS:
                bad.append(("BLK-BLK-002", rel,
                            "blocked and untouched for %d days (threshold %d) · "
                            "is it still current? — a block nobody asks about "
                            "stops being blocked and starts being abandoned"
                            % (age, STALE_DAYS)))

    # BLK-CON-001 · every dependency named. ⛔ An empty connections section is
    # not "no dependencies" — it is a question nobody answered.
    cbody = body_of(text, "C")
    if "C" in have and not re.sub(r"[\s·—-]", "", cbody):
        bad.append(("BLK-CON-001", rel,
                    "section C is empty · declare the dependencies, or write "
                    "'none' with its reason — blank and 'checked, none' are "
                    "indistinguishable"))

    # BLK-CON-002 · every id cited exists. ⛔ A dependency on a block that is
    # not on disk is context pointing at nothing, and it only surfaces when
    # somebody tries to follow it.
    # ⛔ Only a value that LOOKS like a block id is treated as one. Measured on
    # nine real blocks: `nada`, `nothing`, `the` — the word "none" in two
    # languages and an article from a prose sentence — all read as missing
    # blocks. Six false positives, and a false positive on a real tree is how
    # a check gets switched off.
    # ⬜ The "none" word is the installation's language; the SHAPE is not.
    for dep in dependencies(cbody):
        if not ids or dep in ids:
            continue
        bad.append(("BLK-CON-002", rel,
                    "names a block that exists in no state: %r · a dependency "
                    "on nothing reads as a satisfied one" % dep))

    # BLK-STD-001 · at least one standard declared. ⛔ None means there is no
    # basis on which anything could be rejected.
    dbody = body_of(text, "D")
    if "D" in have and not re.search(r"[\w]", dbody.replace("—", "")):
        bad.append(("BLK-STD-001", rel,
                    "section D declares no standard · with none, nothing in "
                    "this block can be rejected on any basis"))

    # ── BLK-CHK-001..004 · a checkpoint is EVIDENCE, not a note ────────────
    # ⛔ "backend done" satisfies a free-form shape and records nothing anybody
    # can act on. ⭐ The two fields that decide whether the work can be trusted
    # are the two nobody writes unprompted: what did NOT change, and whether the
    # scope held.
    # ⚠️ Only when §I HAS content: an empty §I is a block that has not reached a
    # checkpoint yet, which is a state, not a defect. ⭐ §I is 🟡, and demanding
    # it exist would make every fresh block fail its own contract.
    ibody = body_of(text, "I") or ""
    if re.search(r"[A-Za-z]", ibody):
        fields = checkpoint_fields()
        for entry in _checkpoints(ibody):
            missing = [f for f in fields
                       if not re.search(r"^\s*[-*|]?\s*%s\s*[:|]" % re.escape(f),
                                        entry, re.M | re.I)]
            if missing:
                bad.append(("BLK-CHK-001", rel,
                            "checkpoint %r omits %s · ⛔ a checkpoint is "
                            "evidence, not a note — the fields are named in "
                            "contract-block-sections.md §I"
                            % (_first_line(entry), ", ".join(missing))))
                continue
            # ⭐ BLK-CHK-004 · `scope` present but blank answers nothing. The
            # field exists to make the §B lock auditable, and "scope:" alone
            # reads as answered while recording nothing.
            m = re.search(r"^\s*[-*|]?\s*scope\s*[:|]\s*(.*)$", entry,
                          re.M | re.I)
            if m and not re.search(r"held|widen|narrow", m.group(1), re.I):
                bad.append(("BLK-CHK-004", rel,
                            "checkpoint %r · `scope` says %r · ⭐ it answers "
                            "`held` or `widened: <what>` — the lock of §B, made "
                            "auditable" % (_first_line(entry),
                                           m.group(1).strip()[:30])))

    # BLK-TRN-001 · `closed` requires acceptance AND sufficiency — never one.
    if st == "closed":
        kb = body_of(text, "K")
        has_acc = re.search(r"accept|acceptance|verdict|criteri", kb, re.I)
        has_suf = re.search(r"sufficien|resumable|can be resumed", kb, re.I)
        if not (has_acc and has_suf):
            missing = " and ".join(
                x for x, ok in (("acceptance", has_acc), ("sufficiency", has_suf))
                if not ok)
            bad.append(("BLK-TRN-001", rel,
                        "closed without %s · ⛔ neither one alone closes a "
                        "block: accepted-but-unresumable and resumable-but-"
                        "unaccepted are both open" % missing))

    # ⬜ CEILINGS · BLK-CTX-001 · BLK-STA-001 · BLK-SHP-003
    # ⛔ Three rules said "within its ceiling" and no ceiling was declared.
    # A `0` in the table means NOT MEASURED, and this loop measures nothing.
    for sec, cap in sorted(CEILINGS.items()):
        if sec not in have:
            continue
        n = len([l for l in body_of(text, sec).splitlines() if l.strip()])
        if n > cap:
            rid = {"J": "BLK-CTX-001", "E": "BLK-STA-001"}.get(sec, "BLK-SHP-003")
            bad.append((rid, rel,
                        "section %s runs %d lines against a declared %d · at "
                        "close, curate it — the ceiling forces curation over "
                        "what is written, never censorship while writing"
                        % (sec, n, cap)))

    # BLK-CLS-001 / 002 · closing
    if st == "closed":
        if "K" not in have:
            bad.append(("BLK-CLS-001", rel,
                        "status closed with no section K · expected: K present"))
        fbody = body_of(text, "F")
        open_rows = re.findall(r"^\|.*\b(open|active|in progress|todo)\b.*\|$",
                               fbody, re.M | re.I)
        if open_rows:
            bad.append(("BLK-CLS-002", rel,
                        "closed with %d open sub-block row(s) in section F · "
                        "closing over an open task hides it" % len(open_rows)))

        # BLK-CLS-003 · what was NOT done is stated. Silence reads as completeness.
        kbody = body_of(text, "K")
        if "K" in have and not re.search(r"not\s+completed|not\s+done|remaining|pending|debt",
                                         kbody, re.I):
            bad.append(("BLK-CLS-003", rel,
                        "closing does not state what was NOT done · expected a "
                        "'not completed' line · silence reads as completeness"))

        # ⭐ BLK-CLS-008 · the close names the evidence LEVEL reached, and it
        # clears the minimum its LANE requires. ⚠️ The lane is already measured
        # from the dependency graph (rule-working-in-a-block.md §2), so the
        # level is derived rather than being a second opinion.
        floors = lane_minimum()
        need = floors.get(lane)
        if need is not None:
            got = LEVEL.search(kbody or "")
            if not got:
                bad.append(("BLK-CLS-008", rel,
                            "closing names no evidence level · ⭐ lane %r needs "
                            "at least L%d · ⛔ \"tested\" means whatever the last "
                            "person had time for" % (lane, need)))
            elif int(got.group(1)) < need:
                bad.append(("BLK-CLS-008", rel,
                            "closing claims L%s and lane %r needs L%d · ⛔ this "
                            "block has dependents or a declared contract: "
                            "proving the piece alone proves nothing about them"
                            % (got.group(1), lane, need)))

        # ⭐ BLK-CLS-007 · a close writes a machine-readable RECORD.
        # ⛔ A verdict pasted into §K as prose cannot be re-read, compared with
        # the next close, or checked against what was measured — ⚠️ and the
        # UNKNOWN list, the most valuable part, dies with the session.
        record = os.path.join(os.path.dirname(path), "close.json")
        if not os.path.exists(record):
            bad.append(("BLK-CLS-007", rel,
                        "closed with no close.json · ⭐ run `bin/grade-block %s "
                        "--json > %s` · a verdict in prose is not state the "
                        "system holds"
                        % (bid or "<name>",
                           plat.rel(record, ROOT))))
        else:
            # ⚠️ Present is not enough: a record missing `dimensions` says
            # nothing about which of the six are still UNKNOWN, which is the
            # half this rule exists to preserve.
            try:
                rec = json.load(open(record, encoding="utf-8"))
            except Exception:                                  # noqa: BLE001
                rec = None
            if not isinstance(rec, dict) or "dimensions" not in rec:
                bad.append(("BLK-CLS-007", rel,
                            "close.json carries no `dimensions` · ⛔ which of "
                            "the six are still ⬜ UNKNOWN is the half a prose "
                            "verdict loses"))
            # ⭐ QLT-LAY-003 · the record keys the two layers apart. ⛔ A bare
            # `verdict` reads as THE verdict, and it is measurement alone:
            # whoever produces the evidence does not decide what it proves.
            elif "verdict" in rec:
                bad.append(("QLT-LAY-003", rel,
                            "close.json carries a bare `verdict` · ⭐ layer 1 is "
                            "keyed `layer1_verdict` · ⛔ a script does not sign "
                            "the closing verdict, and %d of the six dimensions "
                            "are still undeclared"
                            % sum(1 for v in rec.get("dimensions", {}).values()
                                  if v == "undeclared")))

    return bad


def main():
    quiet = "--quiet" in sys.argv
    if not os.path.exists(CONTRACT):
        print("🔴 the contract itself is missing: rules/contract-block.md")
        return 2
    if not os.path.isdir(BLOCKS):
        if not quiet:
        # ⛔ CHK-TRV-002 · an early return that says "nothing" without a ⬜
        # is a silent gap: it never reaches report(). 🔴 The sibling in
        # check-archive was found on a CLEAN CLONE and only there — git
        # stores no empty directory, so this branch never runs where the
        # author works.
            print("check-block · no work/blocks directory · nothing to check\n"
                  "⬜ NOT MEASURED · no block to check · nothing was verified here")
        return 0

    found, ids, findings = [], {}, []
    for dirpath, dirnames, filenames in os.walk(BLOCKS):
        for name in sorted(filenames):
            if name == "BLOCK.md":
                found.append(os.path.join(dirpath, name))

    for path in found:
        rel = plat.rel(path, ROOT)
        findings += check(path, rel, ids)

    # BLK-OPN-003 · THE OTHER DIRECTION of BLK-OPN-002.
    # ⭐ That rule asks "does an index name this block". This asks "does this
    # index entry still have a block" — and nothing asked it. ⛔ An entry
    # outlives the folder it named the moment a block is deleted or renamed, and
    # then the index sends every reader to work that is not there.
    # ⚠️ Measured while building bin/new-block: removing a block folder left its
    # row in the index, and the tree reported clean.
    live = set(ids)
    for q in index_files():
        try:
            text = open(q, encoding="utf-8", errors="replace").read()
        except OSError:
            continue          # ⬜ skipped, not a gap: reported by check-document
        for m in re.finditer(r"^\s*[-*]\s*`([a-z0-9][a-z0-9-]{1,48})`", text,
                             re.M):
            named = m.group(1)
            if named in live or named in SKIP_INDEX_WORDS:
                continue
            findings.append(("BLK-OPN-003", plat.rel(q, ROOT),
                             "names %r and no block by that id exists · an "
                             "entry that outlived its folder sends every reader "
                             "to work that is not there" % named))

    if not quiet:
        print("check-block · %d block(s) found" % len(found))
    # ⭐ CHK-TRV-002 lives in report(): the caller passes HOW MANY things
    # it examined. ⛔ This printed `✅ 0 violations` over an EMPTY tree —
    # worse than the silent ones, because a false tick is more
    # convincing than an absence.
    return report(findings, "rules/contract-block.md", quiet,
                  examined=len(found), subject="block")


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:
        # CHK-CAU-002 · a crash reports nothing, and "nothing reported" reads
        # exactly like "nothing wrong". Turn it into a finding, not a trace.
        print("🔴 %s crashed · %s: %s"
              % (os.path.basename(__file__), type(e).__name__, e))
        sys.exit(1)
