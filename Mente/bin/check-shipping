#!/usr/bin/env python3
"""check-shipping — enforces the 🔒 rows of rules/rule-shipping.md

⚠️ Most of that rule is 📖: a script cannot watch somebody delete a branch.
What it CAN check is that the locks the rule depends on are declared, in
place, and that nothing here contradicts them.

Exit: 0 clean · 1 violations · 2 the rule itself is missing
"""
import os, re, sys, subprocess

# ⭐ ONE way to report many findings, shared by every validator —
# CHK-SHR-001. ⛔ Thirteen validators each inventing a grouping is
# thirteen report formats, and a reader who must learn one per
# validator learns none.
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from findings import report                                    # noqa: E402

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
RULE = os.path.join(ROOT, "rules", "rule-shipping.md")
HOOKS = os.path.join(ROOT, "hooks")

# SHP-CYC-001 · every stage of the cycle has an owner. A stage with none is a
# stage nobody performs — measured: a cycle declared as ending at "propose"
# left everything after it off every map.
STAGES = ["PRE-FLIGHT", "BRANCH", "IMPLEMENT", "VERIFY", "COMMIT", "PROPOSE",
          "GROUP", "CONFLICT", "MERGE", "DETECT", "VERIFY IT TRAVELLED", "DELETE"]

# SHP-GRP-001 · the ceiling is the owner's, declared in the rule — never a
# constant here. A validator that decides a number the doctrine assigns to the
# installation is measuring a decision nobody took.
DEFAULT_CEILING = 4


def grouping_ceiling(text):
    m = re.search(r"items_per_proposal\s*[:=]\s*(\d+)", text, re.I)
    return (int(m.group(1)), "declared") if m else (DEFAULT_CEILING, "engine default")


def sh(*cmd):
    """git, read-only — bounded by ADR-031, which is where the criterion lives.
    ⛔ Never fails the check because git is absent: a
    validator that requires a tool to exist measures the toolchain, not the
    work — and reports a clean tree as broken on a machine without it."""
    try:
        r = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True,
                           timeout=20)
        return r.stdout.strip() if r.returncode == 0 else None
    except Exception:
        return None


def ok(*cmd):
    """git's EXIT STATUS as THREE states: True · False · None.

    ⛔ Folding these into two is the clobbered-value family. `merge-base
    --is-ancestor` answers by exit code with NO output, so a function that
    returns the output cannot tell "the answer is no" from "git did not run":
    both come back None, and a mis-cut branch reads as clean. Measured — the
    first version of this check failed to detect exactly that."""
    try:
        r = subprocess.run(cmd, cwd=ROOT, capture_output=True, text=True,
                           timeout=20)
        return r.returncode == 0
    except Exception:
        return None


def base_branch():
    """⬜ The base branch is the installation's to name. Same resolution as the
    hook — declared first, then the conventional names. ⛔ Returning None means
    NOT MEASURED, and it is said out loud, never treated as a pass."""
    declared = os.environ.get("MENTE_BASE_BRANCH", "").strip()
    if declared:
        return declared, "declared"
    for c in ("main", "master", "trunk"):
        if ok("git", "show-ref", "--verify", "--quiet", "refs/heads/" + c):
            return c, "conventional"
    return None, "none"


def main():
    quiet = "--quiet" in sys.argv
    if not os.path.exists(RULE):
        print("🔴 the rule itself is missing: rules/rule-shipping.md")
        return 2
    text = open(RULE, encoding="utf-8").read()
    findings = []

    # SHP-CYC-001 · no stage without an owner
    # A stage name can carry a suffix in its cell ("DETECT the merge"), so the
    # match is on the leading capitals, not the whole bold run: a detector that
    # requires the exact label reports a named stage as missing.
    rows = re.findall(r"^\|\s*\d+\s*\|\s*(?:🔴\s*|⭐\s*|🆕\s*)*\*\*([A-Z][A-Z \-]*[A-Z])"
                      r"[^|]*\|\s*(.+?)\s*\|$", text, re.M)
    named = {s.strip(): owner for s, owner in rows}
    for st in STAGES:
        if st not in named:
            findings.append(("SHP-CYC-001", "rules/rule-shipping.md",
                             "stage %r is not in the cycle table · a stage nobody "
                             "names is one nobody performs" % st))
        elif not named[st].strip(" —-"):
            findings.append(("SHP-CYC-001", "rules/rule-shipping.md",
                             "stage %r has no owner · expected the rule that "
                             "governs it" % st))

    # ── the three rules that need the REPOSITORY, not the document
    base, how = base_branch()
    branch = sh("git", "symbolic-ref", "--quiet", "--short", "HEAD")

    if base is None:
        # ⬜ NOT_MEASURED, said out loud. ⛔ Silence here reads as "the base is
        # fine", which is the exact failure SHP-BAS-001 exists to prevent.
        findings.append(("SHP-BAS-001", "(repository)",
                         "⬜ no base branch resolves · declare MENTE_BASE_BRANCH "
                         "· until then the base cannot be checked, and an "
                         "unchecked base is not a correct one"))
    elif branch and branch != base:
        # SHP-BAS-001 · the base is checked BEFORE anything opens. A branch that
        # does not descend from the base was cut from somewhere else, and after
        # the merge that is not recoverable.
        descends = ok("git", "merge-base", "--is-ancestor", base, "HEAD")
        if descends is False:
            findings.append(("SHP-BAS-001", "(repository)",
                             "branch %r does not descend from the base %r · it "
                             "was cut from somewhere else, and a wrong base is "
                             "not recoverable after the merge" % (branch, base)))

    # SHP-BAS-003 · detection, not only prevention: a branch whose ancestor is
    # ANOTHER open branch is chained, and chaining is what the rule forbids.
    if base and branch and branch != base:
        others = [b.strip().lstrip("* ") for b in (sh("git", "branch") or "").splitlines()]
        for other in others:
            if other in (branch, base) or not other:
                continue
            if ok("git", "merge-base", "--is-ancestor", other, "HEAD") is not True:
                continue          # not an ancestor of this branch
            if ok("git", "merge-base", "--is-ancestor", other, base) is not False:
                continue          # already in the base — not a chain
            findings.append(("SHP-BAS-003", "(repository)",
                             "%r is chained on the open branch %r · a real "
                             "dependency is resolved by WAITING and rebasing, "
                             "never by stacking" % (branch, other)))
            break

    # SHP-CLS-001 · the artifacts a reset must not happen without.
    # ⛔ The rule listed six and named the location of none: nothing could
    # check that any existed. ⬜ The paths are declared in the rule now, and a
    # path absent from that table is NOT MEASURED — said out loud, never
    # silently passed.
    declared_paths = [(lbl, path) for lbl, cell in
                      re.findall(r"\|\s*\d+\s*\|\s*⬜ ([^|]+?)\s*\|\s*([^|]+?)\s*\|", text)
                      for path in (re.findall(r"`([^`]+)`", cell) or [None])
                      if path]
    if not declared_paths:
        findings.append(("SHP-CLS-001", "rules/rule-shipping.md",
                         "⬜ no closing artifact declares a path · a lock over "
                         "an artifact with no address is not a lock"))
    # ⚠️ These are INSTANCE files, born from a template at install time. An
    # un-instantiated engine legitimately has none, so demanding them would
    # report every fresh clone as broken. What is checked is that a DECLARED
    # path resolves — the declaration is the engine's, the file is the
    # instance's.
    for label, rel_path in declared_paths:
        if rel_path.startswith("templates/"):
            if not os.path.exists(os.path.join(ROOT, rel_path)):
                findings.append(("SHP-CLS-001", rel_path,
                                 "%s names a template that does not exist · "
                                 "the instance would have nothing to create it "
                                 "from" % label.strip()))
            continue
        parent = os.path.dirname(os.path.join(ROOT, rel_path))
        if parent and not os.path.isdir(parent):
            findings.append(("SHP-CLS-001", rel_path,
                             "%s declares a path whose folder does not exist · "
                             "a context reset would have nowhere to write it"
                             % label.strip()))

    ceiling, origin = grouping_ceiling(text)
    # SHP-GRP-001 · the ceiling is declared, never inferred
    if origin != "declared":
        findings.append(("SHP-GRP-001", "rules/rule-shipping.md",
                         "no items_per_proposal declared · using the engine "
                         "default of %d · declare it, or every reader assumes "
                         "a different one" % ceiling))

    # SHP-LCK-001 · the lock the rule depends on is declared and present.
    # Checking that a rule NAMES a gate is not checking the gate works — that
    # is what its own probe is for. This catches a rule claiming a lock that
    # was never wired at all.
    claims_lock = bool(re.search(r"SHP-LCK-001.*?🔒", text, re.S))
    gate = None
    if os.path.isdir(HOOKS):
        for n in sorted(os.listdir(HOOKS)):
            p = os.path.join(HOOKS, n)
            # A backup or a disabled copy is not a wired gate: a detector that
            # counts one reports a lock that will never run.
            if n.endswith((".bak", ".disabled", ".orig", ".sample")) or ".bak" in n:
                continue
            if os.path.isfile(p) and not n.endswith(".md"):
                try:
                    # 🔴 THIS SPANNED THE WHOLE FILE. With re.S the `.*` crossed
                    # every line, so ANY hook containing the word "main" — every
                    # python file has `def main()` — and the word "commit"
                    # anywhere else counted as the base-branch lock. Measured
                    # the day a fourth hook was added: check-shipping reported
                    # `gate: gate-handoff.py`, and the probe that hides the real
                    # lock found the check still green.
                    # ⚠️ THE DAMAGE IS THE INVERSE OF A FALSE ALARM: it reported
                    # a lock as WIRED while the actual lock could be deleted, so
                    # the one thing this rule protects would be gone and nothing
                    # would say so.
                    # ⭐ Matched per LINE now, and both halves must appear
                    # together — that is what a branch guard actually looks
                    # like, and prose about commits on another line no longer
                    # counts as one.
                    body = open(p, encoding="utf-8").read()
                    if any(re.search(r"\b(base|main|master|trunk)\b", ln, re.I)
                           and re.search(r"\b(commit|branch|push)\b", ln, re.I)
                           and not ln.lstrip().startswith(("#", "//", "*"))
                           for ln in body.splitlines()):
                        gate = n
                        break
                except OSError:
                    pass
    if claims_lock and gate is None:
        findings.append(("SHP-LCK-001", "rules/rule-shipping.md",
                         "the rule declares a 🔒 on committing to the base and no "
                         "hook implements it · ⬜ NOT_MEASURED, not a pass · "
                         "declaring a rule is not following it"))

    if not quiet:
        print("check-shipping · %d stage(s) owned · grouping ceiling %d (%s)%s"
              % (len(named), ceiling, origin,
                 " · gate: %s" % gate if gate else " · ⬜ no gate yet"))
    if findings:
        if quiet:
            return 1          # ⭐ CHK-QUI-001 · exit code only
        return report(findings, "rules/rule-shipping.md", quiet)
    if not quiet:
        print("✅ 0 violations")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:
        # CHK-CAU-002 · a crash reports nothing, and "nothing reported" reads
        # exactly like "nothing wrong". Turn it into a finding, not a trace.
        print("🔴 %s crashed · %s: %s"
              % (os.path.basename(__file__), type(e).__name__, e))
        sys.exit(1)
