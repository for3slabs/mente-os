#!/usr/bin/env python3
"""check-decisions — enforces the 🔒 rows of rules/contract-adr.md

The folder ships empty: another installation's decisions are not yours.
With no records, this reports what it found rather than a pass — nothing
measured is not the same as nothing wrong.

Exit: 0 clean · 1 violations · 2 the contract itself is missing
"""
import os, re, sys, datetime

# ⭐ ONE way to report many findings, shared by every validator —
# CHK-SHR-001. ⛔ Thirteen validators each inventing a grouping is
# thirteen report formats, and a reader who must learn one per
# validator learns none.
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from findings import report                                    # noqa: E402

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CONTRACT = os.path.join(ROOT, "rules", "contract-adr.md")
DECISIONS = os.path.join(ROOT, "rules", "decisions")

STATUSES = {"proposed", "accepted", "superseded", "reverted"}
IMPL_STATES = {"not-started", "in-progress", "implemented", "verified"}
# DEC-FLD-003 · the FIVE the contract names, and only those. ⛔ This list held
# seven: the contract says "all five" and lists five, and the two extras were a
# stricter rule than the one written down. Eight real records were reported
# incomplete for sections their contract never required — a validator stricter
# than its own contract is a rule nobody agreed to.
SECTIONS = ["Context", "Decision", "Rationale", "Evidence", "Reverting"]
# ⭐ Recommended, never required: their absence is not a violation, and
# DEC-FLD-005 still governs the alternatives WHEN they are named.
OPTIONAL_SECTIONS = ["Rejected alternatives", "Consequences"]
# DEC-IMP-003 · a decision accepted long ago and never started is asked about.
# Not forbidden — deciding before building is normal — but it must not read
# the same as one that was done.
def pending_period():
    """⬜ Read from the contract. ⛔ A threshold that lives only in code is a
    decision nobody knows was taken — and deciding months before building is
    normal in one project and a warning sign in another."""
    try:
        t = open(os.path.join(ROOT, "rules", "contract-adr.md"),
                 encoding="utf-8", errors="replace").read()
        m = re.search(r"⬜ pending period[^|]*\|\s*(\d+)", t)
        return int(m.group(1)) if m else 0
    except OSError:
        return 0


PENDING_DAYS = pending_period()
NONE = {"—", "-", "none", "n/a", ""}
NO_EVIDENCE = re.compile(r"\bnone\b.*\bjudg?ment call\b", re.I)

FIELD = re.compile(r"^(date|status|implementation|decided-by|supersedes|"
                   r"superseded-by|applies-to|does-not-apply-to):\s*(.*?)\s*$", re.M)
ISO = re.compile(r"^\d{4}-\d{2}-\d{2}$")
# ⛔ The folder README declares `ADR-NNN-<slug>.md` and this pattern required a
# leading digit — the two contradicted each other and the contract arbitrated
# neither. ⬜ The prefix is the installation's; what the engine fixes is that
# the number is SEQUENTIAL and ZERO-PADDED, so a listing sorts correctly.
NUM = re.compile(r"^(?:[A-Za-z]+[-_])?(\d{3,})[-_ ]")


def body_of(text, name):
    m = re.search(r"^##\s+%s\s*$" % re.escape(name), text, re.M)
    if not m:
        return None
    nxt = re.search(r"^##\s+", text[m.end():], re.M)
    return (text[m.end(): m.end() + nxt.start()] if nxt else text[m.end():]).strip()


def main():
    quiet = "--quiet" in sys.argv
    if not os.path.exists(CONTRACT):
        print("🔴 the contract itself is missing: rules/contract-adr.md")
        return 2
    if not os.path.isdir(DECISIONS):
        if not quiet:
            print("check-decisions · no rules/decisions directory · "
                  "nothing measured (the folder ships empty)")
        return 0

    files = sorted(f for f in os.listdir(DECISIONS)
                   if f.endswith(".md") and f != "README.md")
    findings = []
    seen_num = {}
    records = {}

    for name in files:
        path = os.path.join(DECISIONS, name)
        rel = os.path.relpath(path, ROOT)
        if not os.path.isfile(path):
            findings.append(("DEC-FLD-001", rel,
                             "vanished between listing and reading"))
            continue
        text = open(path, encoding="utf-8").read()
        f = {k: v.strip("`* ") for k, v in FIELD.findall(text)}

        # DEC-NUM-001 · a sortable, zero-padded number in the filename
        m = NUM.match(name)
        if not m:
            findings.append(("DEC-NUM-001", rel,
                             "filename does not start with a zero-padded number · "
                             "expected NNN-name.md · got: %r" % name))
            num = None
        else:
            num = m.group(1)
            # DEC-NUM-002 · a number is never reused
            if num in seen_num:
                findings.append(("DEC-NUM-002", rel,
                                 "number %s already used by %s · a number is an "
                                 "address, and reuse makes every citation resolve "
                                 "to the wrong record" % (num, seen_num[num])))
            else:
                seen_num[num] = rel

        # DEC-ONE-001 · ONE decision per file. ⛔ Decisions kept as rows in a
        # shared table end up in TWO tables, and the two diverge without
        # either looking wrong on its own. A row cannot carry its evidence,
        # its rationale, or the way to undo it — a file can.
        dec = body_of(text, "Decision") or ""
        rows = [l for l in dec.splitlines()
                if re.match(r"^\s*\|.*\|.*\|", l) and not re.match(r"^\s*\|[\s:|-]+\|$", l)]
        if len(rows) > 2:
            findings.append(("DEC-ONE-001", rel,
                             "the decision section is a table of %d rows · one "
                             "record holds ONE decision: a row cannot carry "
                             "evidence or a way back" % (len(rows) - 1)))

        # DEC-NUM-004 · a filename never names a PERSON. ⛔ Not detectable by a
        # list of names — detectable by COMPARISON: if the filename contains the
        # value of `decided-by`, the person is in the name. ⬜ The engine cannot
        # know what a person is called; it can see that this file was named
        # after whoever took the decision.
        owner = f.get("decided-by", "").strip().strip("`*").lower()
        if owner and not owner.startswith("⬜") and owner not in NONE:
            first = re.split(r"[\s,·]", owner)[0]
            if len(first) > 2 and re.search(r"(^|-)%s(-|$)" % re.escape(first),
                                            name, re.I):
                findings.append(("DEC-NUM-004", rel,
                                 "the filename names the person who decided (%r) "
                                 "· ⭐ name the DECISION — who took it belongs in "
                                 "`decided-by`, where it is data instead of a "
                                 "permanent label the file outlives" % first))

        # DEC-FLD-001 · the five header fields
        missing = [k for k in ("date", "status", "decided-by",
                               "supersedes", "superseded-by") if k not in f]
        if missing:
            findings.append(("DEC-FLD-001", rel,
                             "missing header field(s): %s · expected all five"
                             % ", ".join(missing)))

        # ⭐ `{{date}}` is the template placeholder every engine document uses;
        # an un-instantiated record carrying it is not malformed, it is
        # un-instantiated. ⛔ Rejecting it would make the engine unable to ship
        # a single decision of its own.
        _d = f.get("date", "")
        if _d.strip() not in ("{{date}}",) and not ISO.match(_d):
            findings.append(("DEC-FLD-001", rel,
                             "date not ISO · expected YYYY-MM-DD · got: %r"
                             % f.get("date", "")))

        # DEC-FLD-002 · status in the allowed set
        st = f.get("status", "").lower()
        if st not in STATUSES:
            findings.append(("DEC-FLD-002", rel,
                             "status not allowed · expected one of %s · got: %r"
                             % ("|".join(sorted(STATUSES)), f.get("status", ""))))

        # DEC-FLD-003 · the five sections
        bodies = {}
        # ⭐ The optional ones are READ but never required: their absence is
        # not a violation, and DEC-FLD-005 still governs the alternatives when
        # they ARE named. Reading only the required list made the optional
        # rule silently unmeasurable — a check that cannot fire.
        for s in OPTIONAL_SECTIONS:
            bodies[s] = body_of(text, s)
        for s in SECTIONS:
            b = body_of(text, s)
            bodies[s] = b
            if b is None:
                findings.append(("DEC-FLD-003", rel,
                                 "missing section: %s · expected all five" % s))

        # DEC-FLD-004 · Evidence filled, or explicitly none
        ev = (bodies.get("Evidence") or "").strip()
        if bodies.get("Evidence") is not None:
            if not ev:
                findings.append(("DEC-FLD-004", rel,
                                 "Evidence is empty · expected a measurement, or "
                                 "the words admitting there is none · silence and "
                                 "an honest 'no data' look identical afterwards"))
            elif len(ev) < 12 and not NO_EVIDENCE.search(ev):
                findings.append(("DEC-FLD-004", rel,
                                 "Evidence is too short to be one · got: %r" % ev[:40]))

        # DEC-IMP-001 · both states declared
        impl = f.get("implementation", "").strip().lower()
        if not impl:
            findings.append(("DEC-IMP-001", rel,
                             "no implementation state · expected one of %s · "
                             "status says what the decision IS, not whether it "
                             "happened" % "|".join(sorted(IMPL_STATES))))
        elif impl not in IMPL_STATES:
            findings.append(("DEC-IMP-001", rel,
                             "implementation state unknown · expected one of %s "
                             "· got: %r" % ("|".join(sorted(IMPL_STATES)), impl)))

        # DEC-IMP-003 · accepted and never started, for long enough, is asked about
        if st == "accepted" and impl == "not-started" and ISO.match(f.get("date", "")):
            try:
                age = (datetime.date.today()
                       - datetime.date.fromisoformat(f["date"])).days
                if age > PENDING_DAYS:
                    findings.append(("DEC-IMP-003", rel,
                                     "accepted %d days ago and never started · "
                                     "is it still current? · decided-and-never-built "
                                     "reads exactly like decided-and-done" % age))
            except ValueError:
                pass

        # DEC-FLD-006 · supersedes says WHY, not only WHAT
        sup_raw = f.get("supersedes", "").strip()
        if sup_raw.lower() not in NONE and len(sup_raw) < 12:
            findings.append(("DEC-FLD-006", rel,
                             "supersedes names a record but no reason: %r · "
                             "expected what changed, not only which one" % sup_raw))

        # DEC-FLD-007 · the record declares where it applies
        if not f.get("applies-to", "").strip():
            findings.append(("DEC-FLD-007", rel,
                             "no applies-to · a decision with no boundary gets "
                             "applied where it was never meant to"))

        rej = (bodies.get("Rejected alternatives") or "").strip()
        if bodies.get("Rejected alternatives") is not None and rej:
            named = [l for l in rej.splitlines() if l.strip().startswith(("-", "*"))]
            if not named and "none" not in rej.lower():
                findings.append(("DEC-FLD-005", rel,
                                 "rejected alternatives not named one per line · "
                                 "expected a list · nothing can detect one being "
                                 "proposed again"))

        records[num or name] = {
            "rel": rel, "status": st,
            "supersedes": f.get("supersedes", "").strip(),
            "superseded_by": f.get("superseded-by", "").strip(),
            # DEC-NUM-003 / DEC-SRC-003 need these across records, not per file
            "applies_to": f.get("applies-to", "").strip(),
            "reason": (body_of(text, "Rationale") or "").strip(),
            "body": text,          # DEC-SUP-004 reads prose references

        }

    # DEC-SUP-* · symmetry, existence, and status
    def key(ref):
        m = re.search(r"(\d{3,})", ref or "")
        return m.group(1) if m else None

    for num, r in records.items():
        sup, by = key(r["supersedes"]), key(r["superseded_by"])
        if r["supersedes"].lower() not in NONE and sup:
            if sup not in records:
                findings.append(("DEC-SUP-002", r["rel"],
                                 "supersedes %s, which does not exist" % sup))
            elif key(records[sup]["superseded_by"]) != num:
                findings.append(("DEC-SUP-001", r["rel"],
                                 "one-sided link · %s says it supersedes %s · %s "
                                 "does not point back" % (num, sup, sup)))
        if r["superseded_by"].lower() not in NONE and by:
            if by not in records:
                findings.append(("DEC-SUP-002", r["rel"],
                                 "superseded-by %s, which does not exist" % by))
            else:
                # symmetry checked from BOTH ends: a link declared on one side
                # only is the shape a one-sided check cannot see
                if key(records[by]["supersedes"]) != num:
                    findings.append(("DEC-SUP-001", r["rel"],
                                     "one-sided link · %s says it is superseded by "
                                     "%s · %s does not point back · one of the two "
                                     "is wrong" % (num, by, by)))
                if r["status"] != "superseded":
                    findings.append(("DEC-SUP-003", r["rel"],
                                     "superseded by %s but status is %r · expected: "
                                     "superseded · two records both read as current"
                                     % (by, r["status"])))

    # DEC-SUP-004 · a record cited in PROSE must exist, or be marked planned.
    # ⛔ DEC-SUP-002 only checks the `supersedes` fields, so a reference written
    # in Consequences or Related pointed at nothing and nobody noticed.
    # ⚠️ Measured: two records announced consequences in decisions that had not
    # been written — ⭐ a promise to a reader who will follow it.
    for num, r in records.items():
        for ref in sorted(set(re.findall(r"ADR-(\d{3})", r.get("body", "")))):
            if ref == num or ref in records:
                continue
            if re.search(r"⬜[^\n]{0,60}ADR-%s|ADR-%s[^\n]{0,40}⬜" % (ref, ref),
                         r.get("body", "")):
                continue          # ⬜ declared as planned, not as present
            findings.append(("DEC-SUP-004", r["rel"],
                             "cites ADR-%s, which does not exist here · ⭐ mark "
                             "it ⬜ planned, or a reader follows a pointer to "
                             "nothing" % ref))
            break

    # DEC-NUM-003 · a REVERTED decision keeps its file and its number.
    # ⛔ Deleting it makes every citation resolve to nothing, and nothing says
    # the decision was ever taken — the reversal loses its own history.
    for num, r in records.items():
        if r["status"] == "reverted" and not r.get("reason"):
            findings.append(("DEC-NUM-003", r["rel"],
                             "reverted with no reason recorded · the record and "
                             "its number stay; what must be added is WHY, or the "
                             "reversal is indistinguishable from a mistake"))

    # DEC-SRC-003 · a record that contradicts a CURRENT one is a conflict.
    # ⚠️ What a script can measure is the SIGNAL, never the semantics: two
    # current records claiming the same subject. It reports a conflict to
    # resolve, never a verdict on which is right.
    current = [(n, r) for n, r in records.items()
               if r["status"] == "accepted" and r.get("applies_to")]
    by_subject = {}
    for n, r in current:
        for subj in re.split(r"[,·]", r["applies_to"]):
            subj = subj.strip().strip("`").lower()
            if len(subj) < 3:
                continue
            by_subject.setdefault(subj, []).append(n)
    for subj, nums in sorted(by_subject.items()):
        if len(nums) > 1:
            findings.append(("DEC-SRC-003", records[nums[0]]["rel"],
                             "%s current records claim the same subject (%r): %s · "
                             "⛔ two records, one question, and nothing says which "
                             "is current · supersede one or narrow their scope"
                             % (len(nums), subj[:40], ", ".join(sorted(nums)))))

    if not quiet:
        print("check-decisions · %d record(s)%s"
              % (len(files), " · the folder ships empty" if not files else ""))
    if findings:
        return report(findings, "rules/contract-adr.md", quiet)
    if not quiet and files:
        print("✅ 0 violations")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:
        # CHK-CAU-002 · a crash reports nothing, and "nothing reported" reads
        # exactly like "nothing wrong". Turn it into a finding, not a trace.
        print("🔴 %s crashed · %s: %s"
              % (os.path.basename(__file__), type(e).__name__, e))
        sys.exit(1)
