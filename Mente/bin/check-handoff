#!/usr/bin/env python3
"""check-handoff — enforces the 🔒 rows of rules/contract-handoff.md

Validates a delegation manifest and binds it against reality. Nothing else
opens the gate: presence is not compliance.

Usage: check-handoff <manifest.yml>
       check-handoff              (audits every manifest under work/blocks)

Exit: 0 well-formed AND bound · 1 usage · 2 malformed · 3 binding failed
"""
import os, re, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CONTRACT = os.path.join(ROOT, "rules", "contract-handoff.md")
BLOCKS = os.path.join(ROOT, "work", "blocks")

KNOWN_VERSIONS = {"v1"}
REQUIRED = ["schema_version", "handoff_id", "block", "block_path", "load",
            "task", "binding_checks", "write_back"]
TASK_FIELDS = ["objective", "success_condition", "stop_condition"]
RETURN_SECTIONS = ["objective", "work", "findings", "open-questions", "status"]
# HND-PST-002 · the five outcomes send the coordinator to different places:
# "not allowed", "the world moved" and "it broke" need three different answers.
STATUSES = {"done", "partial", "blocked", "aborted-binding-mismatch", "failed"}
WRITE_MODES = {"create-only", "append-only"}
# HND-WRT-002 · sections a specialist may never append to
COORDINATOR_ONLY = {"a", "b", "c", "d", "e", "g",
                    "identity", "scope", "connections",
                    "required standards", "state", "decisions"}
# ⬜ The agent types this installation recognises. ⛔ The list is not the gate:
# HND-GAT-001 makes anything OUTSIDE it a writer, so adding a type is a
# permission decision, and forgetting to add one fails CLOSED.
AGENT_TYPES = {"reader", "writer", "reviewer", "coordinator", "specialist"}
VAGUE = re.compile(r"^(when (done|finished|complete)|asap|as needed|n/?a|tbd)\.?$", re.I)


def parse(path):
    """A two-level reader for the manifest shape. Deliberately not a general
    YAML parser: a hand-written general parser is a bug generator, and this
    file has exactly two levels by design."""
    data = {}
    stack = [(0, data)]
    for raw in open(path, encoding="utf-8"):
        line = raw.split("#")[0].rstrip()
        if not line.strip():
            continue
        indent = len(line) - len(line.lstrip())
        while len(stack) > 1 and indent <= stack[-1][0]:
            stack.pop()
        node = stack[-1][1]
        body = line.strip()
        if body.startswith("- "):
            node.setdefault("__list__", []).append(body[2:].strip().strip('"\''))
            continue
        if ":" not in body:
            continue
        k, _, v = body.partition(":")
        k, v = k.strip(), v.strip().strip('"\'')
        if v in ("", "[]", "{}"):
            child = {} if v == "" else ([] if v == "[]" else {})
            if v == "":
                node[k] = child
                stack.append((indent, child))
            else:
                node[k] = child
        else:
            node[k] = v
    return normalise(data)


def normalise(node):
    if isinstance(node, dict):
        if set(node) == {"__list__"}:
            return node["__list__"]
        out = {k: normalise(v) for k, v in node.items() if k != "__list__"}
        if "__list__" in node:
            out["__items__"] = node["__list__"]
        return out
    return node


def items(v):
    if isinstance(v, list):
        return v
    if isinstance(v, dict):
        return v.get("__items__", [])
    return []


def check(path, rel):
    """Returns (malformed, binding) finding lists."""
    mal, bind = [], []
    try:
        raw = open(path, encoding="utf-8", errors="replace").read()
    except OSError:
        raw = ""
    d = parse(path)

    # HND-MAN-001 · every required field
    for k in REQUIRED:
        if k not in d or d[k] in ("", None):
            mal.append(("HND-MAN-001", rel,
                        "missing required field %r · expected all of: %s"
                        % (k, ", ".join(REQUIRED))))
    if mal:
        return mal, bind

    # HND-MAN-002 · an unknown schema version is refused, never guessed
    ver = str(d.get("schema_version", ""))
    if ver not in KNOWN_VERSIONS:
        mal.append(("HND-MAN-002", rel,
                    "unknown schema version %r · expected one of %s · "
                    "refuse, never guess the shape"
                    % (ver, "|".join(sorted(KNOWN_VERSIONS)))))

    # HND-MAN-003 · the task fields, and a stop condition that says something
    task = d.get("task") or {}
    for k in TASK_FIELDS:
        v = (task.get(k) or "").strip() if isinstance(task, dict) else ""
        if not v:
            mal.append(("HND-MAN-003", rel,
                        "task.%s is empty · expected: an observable condition" % k))
        elif k == "stop_condition" and VAGUE.match(v):
            mal.append(("HND-MAN-003", rel,
                        "stop_condition is not observable: %r · a specialist "
                        "with no stop condition runs until the context collapses"
                        % v))

    # HND-WRT-001 / 002 / 003 · the write scope
    wb = d.get("write_back") or {}
    art = wb.get("artifact")
    art_path = (art.get("path") if isinstance(art, dict) else art) or ""
    if not str(art_path).strip():
        mal.append(("HND-WRT-001", rel,
                    "write_back.artifact has no path · the write scope is an "
                    "allowlist, and an empty one denies the return itself"))

    # HND-WRT-004 · the MODE is granted, never assumed
    if isinstance(art, dict):
        mode = (art.get("mode") or "").strip()
        if mode not in WRITE_MODES:
            mal.append(("HND-WRT-004", rel,
                        "artifact mode missing or unknown · expected one of %s "
                        "· got: %r · create is not modify, append is not "
                        "overwrite" % ("|".join(sorted(WRITE_MODES)), mode)))

    sch = wb.get("artifact_schema")
    schema = items(sch.get("required")) if isinstance(sch, dict) else items(sch)
    if schema != RETURN_SECTIONS:
        mal.append(("HND-RET-001", rel,
                    "return schema wrong · expected %s · got %s"
                    % (RETURN_SECTIONS, schema or "nothing")))

    # the declared status set must be the five, or dispatch is impossible
    if isinstance(sch, dict) and "status" in sch:
        declared = set(items(sch.get("status")))
        if declared and declared != STATUSES:
            mal.append(("HND-RET-002", rel,
                        "status set wrong · expected %s · got %s"
                        % (sorted(STATUSES), sorted(declared))))

    # HND-GAT-004 · the gate decides on capabilities, not on names
    agent = d.get("agent") or {}
    caps = agent.get("capabilities") if isinstance(agent, dict) else None
    if not isinstance(caps, dict) or "write" not in caps:
        mal.append(("HND-GAT-004", rel,
                    "no declared capabilities · expected agent.capabilities "
                    "with read and write · a name list is correct exactly "
                    "until somebody adds another agent type"))
    # HND-GAT-005 · an UNDECLARED capability is assumed PRESENT. ⛔ Fail
    # closed: the safe reading of silence is the permissive one being absent,
    # never the restriction being absent.
    if isinstance(caps, dict):
        for cap in ("read", "write"):
            if cap not in caps:
                mal.append(("HND-GAT-005", rel,
                            "capability %r is not declared · an undeclared "
                            "capability is assumed PRESENT — declare it false "
                            "rather than leaving it out" % cap))

    # HND-GAT-001 · an unknown agent type is treated as a WRITER. ⭐ A name
    # list is correct exactly until somebody adds a fourth type, and then the
    # gate is silently permissive for it.
    atype = (agent.get("type") if isinstance(agent, dict) else None) or ""
    if atype and atype.lower() not in AGENT_TYPES:
        if not (isinstance(caps, dict) and caps.get("write") is False):
            mal.append(("HND-GAT-001", rel,
                        "unknown agent type %r · an unrecognised type is "
                        "treated as a WRITER · declare capabilities.write "
                        "explicitly rather than relying on the name" % atype))

    # HND-GAT-002 · the gate verifies the MANIFEST, not its presence. ⭐ An
    # unfilled template is a file that exists and answers nothing — and
    # "a file is there" reads exactly like "the question was answered".
    holes = re.findall(r"(?m)^\s*[\w_]+:\s*(?:⬜|<[^>]*>|TODO|TBD|\.\.\.)\s*$", raw)
    if holes:
        mal.append(("HND-GAT-002", rel,
                    "%d field(s) still carry the template placeholder · a "
                    "manifest that exists and answers nothing must not open "
                    "the gate" % len(holes)))

    for entry in items(wb.get("also_append")):
        low = entry.lower()
        for banned in COORDINATOR_ONLY:
            if re.search(r"(section|§)\s*:?\s*%s\b" % re.escape(banned), low):
                mal.append(("HND-WRT-002", rel,
                            "append targets a coordinator-owned section (%s) · "
                            "a specialist that rewrites the state it was given "
                            "is a second coordinator" % banned))
                break
        if "max_lines" not in low:
            mal.append(("HND-WRT-003", rel,
                        "append entry declares no max_lines · an unbounded "
                        "append is an unbounded writer: %s" % entry[:50]))

    if mal:
        return mal, bind

    # ── binding checks, in order · the first failure aborts
    bp = d["block_path"]
    bdir = bp if os.path.isabs(bp) else os.path.join(ROOT, bp)
    if not os.path.isdir(bdir):
        bind.append(("HND-BND-001", rel,
                     "block_path does not resolve to a directory: %r" % bp))
        return mal, bind

    bfile = os.path.join(bdir, "BLOCK.md")
    if not os.path.isfile(bfile):
        bind.append(("HND-BND-001", rel, "no BLOCK.md at %r" % bp))
        return mal, bind

    text = open(bfile, encoding="utf-8").read()
    m = re.search(r"\bid:\s*([^\n·]+)", text)
    real = (m.group(1).strip() if m else "")
    if real != d["block"]:
        bind.append(("HND-BND-001", rel,
                     "block id mismatch · manifest says %r · the block says %r · "
                     "the folder was probably renamed" % (d["block"], real)))
        return mal, bind

    for p in items((d.get("load") or {}).get("required")):
        cand = p if os.path.isabs(p) else os.path.join(bdir, p)
        if not os.path.exists(cand):
            bind.append(("HND-BND-001", rel,
                         "load.required path does not resolve: %r" % p))
    return mal, bind


def postflight(path, rel):
    """HND-PST-* · validate what came BACK.

    Validating the manifest before the specialist runs is half the problem:
    the write scope is a promise until something checks it was kept, and a
    specialist reporting `done` with nothing done reads exactly like one that
    worked.
    """
    bad = []
    d = parse(path)
    wb = d.get("write_back") or {}
    art = wb.get("artifact")
    art_path = (art.get("path") if isinstance(art, dict) else art) or ""
    bp = d.get("block_path", "")
    bdir = bp if os.path.isabs(bp) else os.path.join(ROOT, bp)
    apath = os.path.join(bdir, art_path)

    # 1 · the artifact exists
    if not os.path.isfile(apath):
        bad.append(("HND-PST-002", rel,
                    "no return artifact at %r · a claim of completion that "
                    "nothing backs" % art_path))
        return bad

    text = open(apath, encoding="utf-8").read()

    # 2 · it belongs to this handoff
    hid = d.get("handoff_id", "").strip('"')
    if hid and hid not in text and hid not in art_path:
        bad.append(("HND-PST-001", rel,
                    "the artifact does not name this handoff (%s) · it may "
                    "belong to another one" % hid))

    # 3 · its sections match the declared schema, in order
    sch = wb.get("artifact_schema")
    want = items(sch.get("required")) if isinstance(sch, dict) else items(sch)
    found = [m.group(1).strip().lower()
             for m in re.finditer(r"^##\s+(.+?)\s*$", text, re.M)]
    if [f for f in found if f in [w.lower() for w in want]] != [w.lower() for w in want]:
        bad.append(("HND-PST-001", rel,
                    "artifact sections wrong or out of order · expected %s · "
                    "got %s" % (want, found)))

    # 4 · status is one of the five
    m = re.search(r"^##\s+status\s*$(.*?)(?=^##|\Z)", text, re.M | re.S | re.I)
    st = (m.group(1).strip().splitlines() or [""])[0].strip("`* ").lower() if m else ""
    if st not in STATUSES:
        bad.append(("HND-PST-001", rel,
                    "status %r is not one of %s · prose cannot be dispatched on"
                    % (st, sorted(STATUSES))))

    # 5 · HND-STP-003 · a BOUNDARY stop names exactly what it lacked.
    # ⛔ "I could not continue" is not a report: it tells the coordinator that
    # something is missing without telling it what, so the only possible next
    # move is to ask — which is the round trip the handoff existed to avoid.
    if st == "blocked":
        blk = (m.group(1) if m else "")
        named = re.search(r"(need|requires?|missing|lack|outside|no access|"
                          r"waiting on|blocked by)\b[^\n]{6,}", blk, re.I)
        if not named:
            bad.append(("HND-STP-003", rel,
                        "a boundary stop that does not name what it lacked · "
                        "⛔ \"could not continue\" is not a report: say what "
                        "was needed and where it lives, or the coordinator's "
                        "only move is to ask"))

    # 8 · no coordinator-owned section was touched
    for entry in items(wb.get("also_append")):
        low = entry.lower()
        for banned in COORDINATOR_ONLY:
            if re.search(r"(section|§)\s*:?\s*%s\b" % re.escape(banned), low):
                bad.append(("HND-PST-001", rel,
                            "append targets a coordinator-owned section (%s)"
                            % banned))
                break
    return bad


def main():
    argv = [a for a in sys.argv[1:] if a not in ("--quiet", "--postflight")]
    post = "--postflight" in sys.argv
    quiet = "--quiet" in sys.argv
    if not os.path.exists(CONTRACT):
        print("🔴 the contract itself is missing: rules/contract-handoff.md")
        return 2

    if argv:
        targets = [a for a in argv]
        for t in targets:
            if not os.path.isfile(t):
                print("usage: check-handoff <manifest.yml>")
                return 1
    else:
        targets = []
        for dp, _, fns in os.walk(BLOCKS):
            if os.path.basename(dp) == "handoffs":
                targets += [os.path.join(dp, f) for f in sorted(fns)
                            if f.endswith((".yml", ".yaml"))]

    mal_all, bind_all = [], []
    for t in targets:
        rel = os.path.relpath(t, ROOT)
        try:
            m, b = check(t, rel)
            if post and not m and not b:
                b += postflight(t, rel)
        except Exception as e:
            # a crash reports nothing actionable — turn it into a finding
            mal_all.append(("HND-MAN-001", rel,
                            "could not be read: %s: %s" % (type(e).__name__, e)))
            continue
        mal_all += m
        bind_all += b

    if not quiet:
        print("check-handoff%s · %d manifest(s)%s"
              % (" --postflight" if post else "", len(targets),
                 " · none to bind" if not targets else ""))
    for cid, rel, msg in mal_all:
        print("🔴 %s · %s · %s" % (rel, cid, msg))
    for cid, rel, msg in bind_all:
        print("🔴 %s · %s · %s" % (rel, cid, msg))
    # ⭐ CHK-XIT-001 · both of these are VIOLATED CONTRACTS, so both are 1.
    # ⛔ They used to return 2 and 3, and 2 is the code every other validator
    # uses for "I could NOT measure" — a rejection wearing the code for a gap.
    # ⚠️ That is the exact collapse the verdict vocabulary exists to prevent: a
    # violation filed as an open question waits politely and forever.
    if mal_all or bind_all:
        print("\n%s · rule: rules/contract-handoff.md"
              % ("malformed · fix the manifest" if mal_all
                 else "binding failed · the manifest describes a world that "
                      "does not exist"))
        return 1
    # ⛔ CHK-TRV-002 · no manifest is a SKIP, never a pass. ⚠️ Silence after a
    # summary line reads exactly like a tick to anyone skimming a battery run.
    if not quiet:
        print("✅ 0 violations" if targets else
              "⬜ NOT MEASURED · no manifest to check · nothing was verified here")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:
        # CHK-CAU-002 · a crash reports nothing, and "nothing reported" reads
        # exactly like "nothing wrong". Turn it into a finding, not a trace.
        print("🔴 %s crashed · %s: %s"
              % (os.path.basename(__file__), type(e).__name__, e))
        sys.exit(1)
