#!/usr/bin/env python3
"""check-declarations — which ⬜ declarations this installation has not filled.

⭐ `⬜` IS THE MECHANISM THAT MAKES THIS ENGINE PORTABLE. A threshold, a section
name, a base branch, a code extension — the engine ships the RULE and the
installation supplies the value. ⛔ An unfilled one is NOT MEASURED, and every
rule depending on it silently measures nothing.

⚠️ AND THAT IS CORRECT AND HONEST — a threshold nobody chose should not be
invented by the engine. ⭐ What is wrong is that it is INVISIBLE: `0` reads like
a number, `null` like a value, and the rule they switch off looks enforced.

⛔ THIS IS NOT A VALIDATOR OF FAULTS. Every line it prints is a gap the owner may
leave open forever, on purpose. It exits 0 with findings — because an unfilled
declaration is a decision not yet made, never a defect.

Usage: check-declarations [--quiet]
Exit: 0 always — ⭐ CHK-QUI-001 · `--quiet` is the exit code only
"""
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
RULES = os.path.join(ROOT, "rules")
CONFIG = os.path.join(ROOT, "mente.config.yml")
# ⭐ A rule row that defers a number: it carries ⬜ and the value is 0. The rules
# say `0` = NOT MEASURED in their own words, so the marker is read, not invented.
UNSET_ROW = re.compile(r"^\|\s*⬜[^|]*\|\s*0\s*\|", re.M)
ROW_NAME = re.compile(r"^\|\s*⬜\s*([^|]+?)\s*\|")
# ⭐ An unfilled value in the instance declaration, in the three shapes the
# template ships: an empty list, an explicit null, an empty string.
UNSET_CFG = re.compile(r"^\s*([a-z_]+):\s*(null|\[\]|\"\"|'')\s*$", re.M)


def rule_gaps():
    """Every rule row that defers a value and has not received one."""
    out = []
    if not os.path.isdir(RULES):
        return None
    for name in sorted(os.listdir(RULES)):
        if not name.endswith(".md"):
            continue
        try:
            text = open(os.path.join(RULES, name), encoding="utf-8",
                        errors="replace").read()
        except OSError:
            # ⬜ An unreadable rule may defer a value nobody will ever see.
            out.append((os.path.join("rules", name), "unreadable · its "
                        "declarations were NOT counted"))
            continue
        for m in UNSET_ROW.finditer(text):
            row = text[m.start():text.find("\n", m.start())]
            n = ROW_NAME.match(row)
            out.append((os.path.join("rules", name),
                        (n.group(1) if n else row[:40]).strip()))
    return out


def config_gaps():
    """Values the instance declaration has not been given.

    ⬜ Absent config is not an empty one: a template has nothing filled by
    definition, and reporting every line would say nothing about the install.
    """
    if not os.path.exists(CONFIG):
        return None
    try:
        text = open(CONFIG, encoding="utf-8", errors="replace").read()
    except OSError:
        return None
    return [m.group(1) for m in UNSET_CFG.finditer(text)]


def main():
    quiet = "--quiet" in sys.argv
    rules = rule_gaps()
    cfg = config_gaps()

    if quiet:
        # ⭐ CHK-QUI-001 · exit code only. ⚠️ And the code is always 0: an
        # unfilled declaration is a decision pending, never a fault, so a hook
        # calling this must not be able to treat it as one.
        return 0

    if rules is None:
        print("⬜ NOT MEASURED · no rules/ · nothing defers a value here")
    else:
        print("check-declarations · %d rule value(s) deferred and unset"
              % len(rules))
        for rel, what in rules:
            print("   ⬜ %s · %s" % (rel, what))

    if cfg is None:
        # ⭐ Said, not assumed: without a config nothing distinguishes "the owner
        # left these open" from "nobody has installed this yet".
        print("⬜ NOT MEASURED · no mente.config.yml · this tree is not "
              "installed, so nothing was expected to be filled")
    elif cfg:
        print("   %d instance value(s) still at their empty default: %s"
              % (len(cfg), ", ".join(cfg)))
    else:
        print("   ✅ every instance value in mente.config.yml is filled")

    total = len(rules or []) + len(cfg or [])
    if total:
        print("\n⬜ %d declaration(s) unfilled · ⛔ each one switches its rule "
              "OFF, and that is\n   the owner's call — this reports, it never "
              "fails." % total)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:                                     # noqa: BLE001
        # CHK-CAU-002 · a crash reports nothing, and nothing reads as fine.
        print("🔴 %s crashed · %s: %s"
              % (os.path.basename(__file__), type(e).__name__, e))
        sys.exit(1)
