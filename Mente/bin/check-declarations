#!/usr/bin/env python3
"""check-declarations — which ⬜ declarations this installation has not filled.

⭐ `⬜` IS THE MECHANISM THAT MAKES THIS ENGINE PORTABLE. A threshold, a section
name, a base branch, a code extension — the engine ships the RULE and the
installation supplies the value. ⛔ An unfilled one is NOT MEASURED, and every
rule depending on it silently measures nothing.

⚠️ AND THAT IS CORRECT AND HONEST — a threshold nobody chose should not be
invented by the engine. ⭐ What is wrong is that it is INVISIBLE: `0` reads like
a number, `null` like a value, and the rule they switch off looks enforced.

⛔ THIS IS NOT A VALIDATOR OF FAULTS. Every line it prints is a gap the owner may
leave open forever, on purpose. It exits 0 with findings — because an unfilled
declaration is a decision not yet made, never a defect.

Usage: check-declarations [--quiet]
Exit: 0 always — ⭐ CHK-QUI-001 · `--quiet` is the exit code only
"""
import os
import os as _os, sys as _sys
_d = _os.path.dirname(_os.path.abspath(__file__))
while _d != _os.path.dirname(_d):
    if _os.path.exists(_os.path.join(_d, "bin", "utf8.py")):
        _sys.path.insert(0, _os.path.join(_d, "bin")); break
    _d = _os.path.dirname(_d)
import utf8                                          # noqa: F401,E402
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
RULES = os.path.join(ROOT, "rules")
CONFIG = os.path.join(ROOT, "mente.config.yml")
# ⭐ A rule row that defers a number: it carries ⬜ and the value is 0. The rules
# say `0` = NOT MEASURED in their own words, so the marker is read, not invented.
# ⭐ TWO SHAPES, and neither covers the other (CHK-SHR-002).
#   · `| ⬜ A `Identity` | 0 |`        — the row is marked, the value is 0
#   · `| tier-1 threshold | ⬜ … |`    — ⭐ the VALUE cell is the ⬜
# ⛔ Reading only the first reported 7 gaps when 27 exist: every discipline's §3
# and every ceiling in the delivery contract sat unseen, so an installation was
# never told they were waiting.
UNSET_ROW = re.compile(
    r"^\|\s*⬜[^|]*\|\s*0\s*\||^\|[^|]+\|\s*⬜\s*(?:…|\.\.\.)?\s*\|", re.M)
# ⭐ The row's NAME is its first cell, whichever shape marked it. ⚠️ Taking the
# whole line printed the pipes back at the reader, and a row whose first cell is
# itself a ⬜ has no name to give — it says so instead of showing an ellipsis.
ROW_NAME = re.compile(r"^\|\s*(?:⬜\s*)?([^|]*?)\s*\|")
# ⭐ An unfilled value in the instance declaration, in the three shapes the
# template ships: an empty list, an explicit null, an empty string.
UNSET_CFG = re.compile(r"^\s*([a-z_]+):\s*(null|\[\]|\"\"|'')\s*$", re.M)


def rule_gaps():
    """Every row that defers a value to the installation and has not got one.

    ⭐ BOTH TREES. ⛔ Reading only `rules/` reported 7 gaps when there were 36:
    the principles and the disciplines defer 29 values between them — the tier-1
    threshold, the six quality dimensions, every discipline's §3 — and an
    installation had no way to be told any of them were waiting.
    ⚠️ A validator whose reach is narrower than the thing it counts does not
    report a smaller number; it reports a WRONG one, and confidently.
    """
    out, roots = [], [RULES, os.path.join(ROOT, "memory", "principles")]
    if not any(os.path.isdir(r) for r in roots):
        return None
    for root in roots:
        if not os.path.isdir(root):
            # ⬜ SAID, never swallowed: a tree that is not there is a tree whose
            # deferred values were not counted, and the total would look
            # complete. ⚠️ Both roots ship with the engine, so an absent one is
            # an incomplete install rather than a normal state.
            out.append((os.path.relpath(root, ROOT),
                        "⬜ this tree is missing · its declarations were NOT "
                        "counted"))
            continue
        for dp, dn, fn in os.walk(root):
            dn[:] = [d for d in dn if d not in (".git", "__pycache__")]
            for name in sorted(f for f in fn if f.endswith(".md")):
                q = os.path.join(dp, name)
                rel = os.path.relpath(q, ROOT)
                try:
                    text = open(q, encoding="utf-8", errors="replace").read()
                except OSError:
                    # ⬜ An unreadable file may defer a value nobody will see.
                    out.append((rel, "unreadable · its declarations were NOT "
                                     "counted"))
                    continue
                for m in UNSET_ROW.finditer(text):
                    row = text[m.start():text.find("\n", m.start())]
                    n = ROW_NAME.match(row)
                    label = (n.group(1) if n else row[:40]).strip()
                    # ⬜ A first cell that is only the marker names nothing —
                    # said, rather than printed as an ellipsis nobody can act on.
                    if not label or label in ("…", "..."):
                        label = "⬜ an unnamed row · %s" % row.strip()[:46]
                    out.append((rel, label))
    return out


def config_gaps():
    """Values the instance declaration has not been given.

    ⬜ Absent config is not an empty one: a template has nothing filled by
    definition, and reporting every line would say nothing about the install.
    """
    if not os.path.exists(CONFIG):
        return None
    try:
        text = open(CONFIG, encoding="utf-8", errors="replace").read()
    except OSError:
        return None
    return [m.group(1) for m in UNSET_CFG.finditer(text)]


def main():
    quiet = "--quiet" in sys.argv
    rules = rule_gaps()
    cfg = config_gaps()

    if quiet:
        # ⭐ CHK-QUI-001 · exit code only. ⚠️ And the code is always 0: an
        # unfilled declaration is a decision pending, never a fault, so a hook
        # calling this must not be able to treat it as one.
        return 0

    if rules is None:
        print("⬜ NOT MEASURED · no rules/ · nothing defers a value here")
    else:
        print("check-declarations · %d rule value(s) deferred and unset"
              % len(rules))
        for rel, what in rules:
            print("   ⬜ %s · %s" % (rel, what))

    if cfg is None:
        # ⭐ Said, not assumed: without a config nothing distinguishes "the owner
        # left these open" from "nobody has installed this yet".
        print("⬜ NOT MEASURED · no mente.config.yml · this tree is not "
              "installed, so nothing was expected to be filled")
    elif cfg:
        print("   %d instance value(s) still at their empty default: %s"
              % (len(cfg), ", ".join(cfg)))
    else:
        print("   ✅ every instance value in mente.config.yml is filled")

    total = len(rules or []) + len(cfg or [])
    if total:
        print("\n⬜ %d declaration(s) unfilled · ⛔ each one switches its rule "
              "OFF, and that is\n   the owner's call — this reports, it never "
              "fails." % total)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:                                     # noqa: BLE001
        # CHK-CAU-002 · a crash reports nothing, and nothing reads as fine.
        print("🔴 %s crashed · %s: %s"
              % (os.path.basename(__file__), type(e).__name__, e))
        sys.exit(1)
