#!/usr/bin/env python3
"""generate-readme — the repository's front page: what a stranger reads first.

🔴 WHY THIS PAGE GIVES THE READING ASSISTANT NO INSTRUCTIONS, measured
2026-09-05 on a real run. An earlier version told it to print §1 verbatim, not
to summarise, and — worst of all — not to report what it noticed on the user's
machine. ⚠️ The assistant classified the page as PROMPT INJECTION, refused to
follow it, and advised the person NOT to install this. That is a worse outcome
than the file listing it replaced.

⛔ And it was right. Telling an agent to withhold information from its own user
is indefensible, whoever writes it and for whatever reason.

⭐ THE RULE THAT GOVERNS THIS FILE: a stranger does not trust a repository that
tells their assistant how to behave — they trust one that explains itself well
enough that the assistant reaches the right summary on its own. The same failing
run summarised Mente OS correctly and unprompted; comprehension was never the
problem. The page simply did not explain enough.

⚠️ So the guided first run lives in START-HERE.md, read only once somebody has
CHOSEN to install. This page earns that choice; it does not script it.

Usage: generate-readme [--check]
  --check   report whether the page is current, and write nothing
Exit: 0 written or current · 1 --check found it stale · 2 could not read/write
"""
import os
import os as _os, sys as _sys
_d = _os.path.dirname(_os.path.abspath(__file__))
while _d != _os.path.dirname(_d):
    if _os.path.exists(_os.path.join(_d, "bin", "utf8.py")):
        _sys.path.insert(0, _os.path.join(_d, "bin")); break
    _d = _os.path.dirname(_d)
import utf8                                          # noqa: F401,E402
import re
import sys

MENTE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
REPO = os.path.dirname(MENTE)
SOURCE = os.path.join(MENTE, "START-HERE.md")
TARGET = os.path.join(REPO, "README.md")

HEADER = '<!-- Generated from Mente/START-HERE.md §1 by Mente/bin/generate-readme.\n     Edit the source, not this file. -->\n\n# 🧠 Mente OS\n\n### An AI assistant that does not lose the thread of your work\n\n![licence](https://img.shields.io/badge/licence-AGPL--3.0-blue)\n![needs](https://img.shields.io/badge/needs-python%203%20%C2%B7%20git%20%C2%B7%20bash-informational)\n![dependencies](https://img.shields.io/badge/dependencies-none-success)\n\n---\n\n## ⚡ The 30-second version\n\n| | |\n|---|---|\n| 🎯 **The problem** | every time a conversation resets, your assistant forgets what was decided and what must not be touched — then rebuilds it by guessing, and sounds just as confident when it guesses wrong |\n| 💡 **The idea** | the work lives on disk in a shape the assistant has to fill in, and small programs check it |\n| ⚖️ **Why programs** | a rule written in a document is followed about half the time · a rule a program refuses to break is followed every time |\n| 👤 **Who it is for** | anyone working with an AI assistant across more than one sitting — you do not need to be a developer |\n\n---\n'

ASK = '\n---\n\n## 🚀 Getting started\n\n**1 · Make a folder for it, and clone into that folder**\n\n```bash\nmkdir mente-os && cd mente-os\ngit clone https://github.com/for3slabs/mente-os.git .\n```\n\n> 💡 The trailing `.` clones into the folder you just made instead of creating\n> another one inside it. Cloning into a folder that already has files in it will\n> fail — use an empty one.\n\n**2 · Set it up**\n\n```bash\ncd Mente\nbin/init                  # asks who you are · writes nothing until you answer\nbin/probes/run-all.py     # the engine checking itself · expect 0 failures\n```\n\n**3 · Then just talk to your assistant**\n\nYou do not learn commands. 📄 `Mente/START-HERE.md` is a walkthrough written for\nan assistant to follow with you the first time — point yours at it.\n\n---\n\n## 💬 What using it looks like\n\n| You say | What happens |\n|---|---|\n| 🏗️ *"build me X"* | it opens a **block** and asks what it may and may not touch |\n| 🧭 *"where were we?"* | it reads `memory/RESUME.md` instead of guessing |\n| 📋 *"what\'s left?"* | it reads `memory/PENDING.md` |\n| ✅ *"is this done?"* | it cannot say yes until the checks pass — that is not its opinion to give |\n| ⭐ *"let\'s close the session"* | it writes down the reasoning **before** the conversation resets and takes it with it |\n\n> ⭐ **That last one is the habit the whole system rests on.** Your files survive\n> a reset; the reasoning does not, unless somebody wrote it down first.\n\n---\n\n## 🔍 What it does to your machine — plainly\n\nYou should know this before installing anything, and it is short:\n\n| | |\n|---|---|\n| 📝 **Writes files** | inside its own folder · plus **one line** appended to your `CLAUDE.md`, if you have one |\n| 🪝 **Installs git hooks** | `pre-commit` and `pre-push`, **in this repository only** · they refuse a commit that breaks the rules you set · remove them by deleting the two links in `.git/hooks/` |\n| 🔒 **Sends nothing** | no network calls, no telemetry, no account · everything stays on your disk |\n| 📦 **Installs nothing** | no packages, no dependencies |\n\n---\n\n## 🧩 The four pieces\n\n| | |\n|---|---|\n| 📦 **Block** | one unit of work — what is being built, ⭐ **what must NOT be touched**, what it depends on, what comes next |\n| 🗺️ **Campaign** | several blocks under one mission, so switching between them does not restart the reason |\n| 🚦 **Gates** | they run on their own and stop what should not happen — a destructive change with no way back, closing work that is not finished |\n| 🧠 **Memory** | `RESUME.md` (where we left off) and `PENDING.md` (what is postponed) — ⭐ you never write either by hand |\n\n---\n\n## 🗂️ Where to look next\n\n| | |\n|---|---|\n| 📄 `Mente/START-HERE.md` | the guided first run, written for an assistant to follow with you |\n| ⚡ `Mente/QUICKSTART.md` | clone → `bin/init` → tests, for a developer in a hurry |\n| 🛠️ `Mente/CAPABILITIES.md` | every command, and what each one refuses to do |\n| 📐 `Mente/rules/decisions/` | why it is built this way — one file per decision |\n\n---\n\n## 🧰 What it needs\n\nPython 3 · git · bash. Most machines already have all three; on Windows, Git\nBash brings them together.\n\n## 📜 Licence\n\n**AGPL-3.0** — use it, change it, and if you run it as a service, publish your\nchanges.\n'


def quoted_body():
    """START-HERE §1 — the quoted block, exactly as the script orders it shown.

    ⛔ Bounded by the NEXT heading, never by a line count: a source that grows
    would be silently truncated, and the visitor would get half an explanation
    with nothing reporting it.
    """
    try:
        text = open(SOURCE, encoding="utf-8").read()
    except OSError as e:
        print("🔴 cannot read %s (%s)" % (SOURCE, e.__class__.__name__),
              file=sys.stderr)
        sys.exit(2)
    m = re.search(r"^## 1 · SHOW THIS, VERBATIM\s*\n(.*?)(?=^## |\Z)",
                  text, re.S | re.M)
    if not m:
        print("🔴 START-HERE.md has no '## 1 · SHOW THIS, VERBATIM' section · "
              "the front page cannot be generated from a source that moved",
              file=sys.stderr)
        sys.exit(2)
    body = m.group(1).strip("\n")
    # ⚠️ Only the quoted lines travel. Anything unquoted in §1 is an aside to the
    # assistant, and a stranger reading the front page must not see it.
    kept = [l for l in body.split("\n") if l.startswith(">") or not l.strip()]
    while kept and not kept[0].strip():
        kept.pop(0)
    while kept and not kept[-1].strip():
        kept.pop()
    if not kept:
        print("🔴 §1 carries no quoted block to show", file=sys.stderr)
        sys.exit(2)
    return "\n".join(kept)


def render():
    return "%s\n## 📖 What it is, in full\n\n%s\n%s" % (
        HEADER, quoted_body(), ASK)


def main():
    check = "--check" in sys.argv
    want = render()
    have = open(TARGET, encoding="utf-8").read() if os.path.isfile(TARGET) else None
    if have == want:
        # ⭐ CHK-IND-002 · the count, not a bare tick: a green with no number
        # looks the same whether it compared a page or compared nothing.
        print("✅ README.md is current · %d line(s) generated from "
              "START-HERE.md §1" % len(want.split("\n")))
        return 0
    if check:
        # ⭐ Names the fix, never only the fault. A report a person cannot act on
        # is a report that gets ignored.
        print("🔴 README.md is STALE · START-HERE.md §1 changed and the front "
              "page did not\n   Fix: Mente/bin/generate-readme", file=sys.stderr)
        return 1
    try:
        open(TARGET, "w", encoding="utf-8").write(want)
    except OSError as e:
        print("🔴 cannot write %s (%s)" % (TARGET, e.__class__.__name__),
              file=sys.stderr)
        return 2
    print("🤖 README.md written from START-HERE.md §1")
    return 0


sys.exit(main())
