#!/usr/bin/env python3
"""check-declared — every engine file must be declared in pieces.tsv.

check-structure walks the TABLE and verifies each row has its file. This walks
the DISK and verifies each file has its row. Without it, a piece that is built
and never declared is invisible: nothing reports it when it disappears.

Usage:
  bin/check-declared            report undeclared files
  bin/check-declared --quiet    exit code only

Exit codes: 0 clean · 1 undeclared files found · 2 pieces.tsv missing
"""
import os
import sys

MENTE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
os.chdir(MENTE)

TABLE = "pieces.tsv"
# ⭐ The table an installation RECEIVES. bin/init copies it, so a row that lives
# in one and not the other means a fresh install starts with a different map
# than the one verified here — and nothing downstream would ever say so.
TEMPLATE = os.path.join("templates", "pieces.tsv.template")

# Folders walked, and which file extensions count as a declarable piece there.
# An empty tuple means every file counts.
SCAN = {
    "bin": (),
    "hooks": (),
    "rules": (".md",),
    "templates": (".template",),
    "memory/principles": (".md",),
    "memory/principles/expertise": (".md",),
    # ⭐ The engine now ships decisions of its own, and an undeclared one would
    # be invisible to the piece table. ⛔ But this folder must start EMPTY in an
    # installation, so only what the engine SHIPS is checked — a record the
    # owner writes there is theirs and is not declarable.
    "rules/decisions": (".md",),
}
# ⛔ `docs/architecture` was listed here and exists nowhere — not in the tree,
# not in pieces.tsv, not created by anything. Every clean clone printed
# "⬜ NOT MEASURED · docs/architecture does not exist" on its first run, which
# is a validator complaining about its own configuration. ⭐ A scan target that
# nothing produces is not a gap in the tree; it is a gap in the scan.

# Never a declarable piece: runtime artefacts, folder documentation, and the
# per-folder READMEs, which are declared as a group rather than one by one.
SKIP_NAMES = {"README.md", "__pycache__", ".gitkeep", ".DS_Store"}
SKIP_SUFFIX = (".pyc", ".pyo", ".swp", "~")


def declared_paths(table=None):
    """Every path the table declares → the rows that declare it.

    ⭐ A dict of LISTS, not a set. The set this returned could not represent the
    one defect it was standing over: eight paths declared twice, each pair with a
    different name, class and description. A repeat was absorbed on the way in, so
    the walk below compared against a table that looked clean by construction.
    ⛔ A reader that cannot represent a defect can never report it.
    """
    table = table or TABLE
    if not os.path.exists(table):
        return None
    out = {}
    for n, line in enumerate(open(table, encoding="utf-8", errors="replace"), 1):
        if line.startswith("#") or not line.strip():
            continue
        f = [c.strip() for c in line.rstrip("\n").split("\t")]
        if len(f) >= 2 and f[0] != "pieza":
            out.setdefault(f[1].replace("repo:", "").lstrip("./"), []).append((n, f[0]))
    return out


def is_declarable(name, exts):
    if name in SKIP_NAMES or name.startswith("."):
        return False
    if name.endswith(SKIP_SUFFIX):
        return False
    return not exts or name.endswith(exts)


def main():
    quiet = "--quiet" in sys.argv

    declared = declared_paths()
    if declared is None:
        if not quiet:
            print(f"🔴 {TABLE} not found — nothing can tell a declared piece "
                  f"from an undeclared one.", file=sys.stderr)
        return 2

    # DOC-IDS-002 · ONE PATH, ONE ROW. Two rows for the same file are two answers
    # to "what is this piece", and whoever reads the first never learns there is a
    # second. Measured here: eight paths carried a placeholder row written before
    # the piece existed AND the real row — different name, different class,
    # different description. ⚠️ Same shape as a duplicated decision table: the
    # copies do not stay equal, they diverge, and nothing says which one is true.
    # 🔴 BOTH TABLES, and the second was the one that mattered. Eight duplicate
    # rows were cleaned from the live table and left untouched in the template —
    # so every FRESH INSTALL still received them, and the tree that had been
    # fixed reported clean. ⛔ A rule that measures one of two copies leaves the
    # copy that travels unmeasured, which is the worse half.
    repeats = {p: rows for p, rows in declared.items() if len(rows) > 1}
    tpl_rows = declared_paths(TEMPLATE)
    if tpl_rows:
        for path, rows in tpl_rows.items():
            if len(rows) > 1:
                repeats.setdefault("%s (in %s)"
                                   % (path, os.path.basename(TEMPLATE)), rows)

    # DOC-IDS-003 · THE TABLE AND ITS TEMPLATE DECLARE THE SAME ENGINE PIECES.
    # ⛔ They were kept in step by hand, which is the arrangement that holds
    # until the day it does not. A piece present in the live table and absent
    # from the template is a piece every fresh install is missing from its map,
    # and the install itself cannot notice: it has nothing to compare against.
    # ⚠️ One direction only — the live table legitimately grows with the
    # owner's own pieces, and those must NOT be pushed back into the template.
    drift = []
    tpl = declared_paths(TEMPLATE)
    if tpl is None:
        drift = None                      # ⬜ said out loud below, not a pass
    else:
        # ⭐ Only paths under a SCANNED folder count — those are the engine's
        # own. ⛔ Without that filter every row an owner adds for their project
        # would be reported as template drift, and a checker that fires on
        # correct behaviour is one that gets switched off.
        drift = sorted(p for p in declared
                       if p not in tpl and p.split("/")[0] in
                       {f.split("/")[0] for f in SCAN})

    missing = []

    scanned = 0
    skipped = []
    for folder, exts in SCAN.items():
        if not os.path.isdir(folder):
            skipped.append(folder)      # ⬜ CHK-CAU-003 · said out loud below
            continue
        for name in sorted(os.listdir(folder)):
            path = os.path.join(folder, name)
            if not os.path.isfile(path):
                continue
            if not is_declarable(name, exts):
                continue
            scanned += 1
            if path not in declared:
                missing.append(path)

    # CHK-IND-002 · say WHAT WAS MEASURED, never a bare ✅. ⛔ If the walk
    # found nothing, this printed the same green — absence of evidence read as
    # evidence, which is the exact failure the quality contract names.
    if not missing and not repeats and not drift:
        if not quiet:
            for sk in skipped:
                print("⬜ NOT MEASURED · %s does not exist · nothing in it was "
                      "checked" % sk)
            if not scanned:
                print("⬜ NOT MEASURED · no engine file was found to check · "
                      "a green over zero files is not a pass")
            else:
                print("✅ %d engine file(s) checked · every one is declared in %s"
                      % (scanned, TABLE))
        return 0

    if quiet:
        return 1

    if drift is None:
        print(f"⬜ NOT MEASURED · {TEMPLATE} is absent · whether a fresh install "
              "receives the same map cannot be checked\n")
    elif drift:
        print(f"🟡 {len(drift)} engine piece(s) are in {TABLE} and not in "
              f"{TEMPLATE}.\n")
        print("   bin/init copies the template, so a fresh install starts with a")
        print("   map missing these — and has nothing to compare against.\n")
        for p in drift:
            print(f"   ⬜ {p}")
        print(f"\n   Copy the row into {TEMPLATE}.\n")

    if repeats:
        print(f"🟡 {len(repeats)} path(s) are declared more than once in {TABLE}.\n")
        print("   Two rows for one path are two answers to what that piece is, and")
        print("   the reader of the first never learns the second exists.\n")
        for path, rows in sorted(repeats.items()):
            print(f"   ⬜ {path}")
            for n, name in rows:
                print(f"        line {n}: {name}")
        print("\n   Keep the row the rest of the tree refers to; delete the other.\n")

    if not missing:
        return 1

    print(f"🟡 {len(missing)} file(s) exist and {TABLE} does not declare them.\n")
    print("   An undeclared piece is one that check-structure stays silent about")
    print("   the day it disappears, and that a fresh clone cannot verify it received.\n")
    for p in missing:
        print(f"   ⬜ {p}")
    print(f"\n   Add one row per file to {TABLE}: "
          f"pieza <TAB> ruta <TAB> governance <TAB> clase <TAB> que_es")
    return 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:
        # CHK-CAU-002 · a crash reports nothing, and "nothing reported" reads
        # exactly like "nothing wrong". Turn it into a finding, not a trace.
        print("🔴 %s crashed · %s: %s"
              % (os.path.basename(__file__), type(e).__name__, e))
        sys.exit(1)
