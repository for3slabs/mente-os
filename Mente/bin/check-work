#!/usr/bin/env python3
"""check-work — enforces the 🔒 rows of rules/rule-working-in-a-block.md

Most of that rule is 📖 discipline: a script can check that a friction was
logged, never that the work stopped to think. This checks only what is
mechanically observable, and says so.

Exit: 0 clean · 1 violations · 2 the rule itself is missing
"""
import os, re, sys, collections

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
RULE = os.path.join(ROOT, "rules", "rule-working-in-a-block.md")
BLOCKS = os.path.join(ROOT, "work", "blocks")

# ⭐ ONE reader for a block's sections — bin/blockread.py. It lived as four
# copies here and the comparable ones had already diverged: two could not see a
# section headed by its NAME, so every section read empty and the checks
# reported findings against a file they had never read.
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from blockread import (sections, order, body_of, SEC, NAMES,   # noqa: E402,F401
                       DEPENDS, dependencies)

# ⭐ ONE way to report many findings, shared by every validator —
# CHK-SHR-001. ⛔ Thirteen validators each inventing a grouping is
# thirteen report formats, and a reader who must learn one per
# validator learns none.
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from findings import report                                    # noqa: E402


LANES = {"direct", "task", "full-block"}
# WRK-FRI-003 · the threshold is the OWNER's, declared in the rule — never a
# constant here. A validator that decides a number the doctrine says belongs to
# the installation is measuring a decision nobody took.
DEFAULT_THRESHOLD = 3


def friction_threshold():
    """Read it from the rule. Fall back only if the rule does not declare it,
    and say which was used."""
    try:
        t = open(RULE, encoding="utf-8").read()
    except OSError:
        return DEFAULT_THRESHOLD, "default"
    m = re.search(r"friction[_ ]threshold\s*[:=]\s*(\d+)", t, re.I)
    if m:
        return int(m.group(1)), "declared"
    return DEFAULT_THRESHOLD, "engine default"

SEC = re.compile(r"^##\s*([A-K])\s*[·.:-]", re.M)
FIELD = re.compile(r"\b(id|lane|status):\s*([^\n·]+?)\s*(?=·|$)", re.M)
# WRK-FRI-002 · a friction line carries its four fields
FRICTION = re.compile(r"^\s*[-*]?\s*(\d{4}-\d{2}-\d{2})\s*·\s*rule:\s*([^·\n]+?)\s*·"
                      r".*?reason:\s*(\S.*)$", re.M | re.I)
FRICTION_LOOSE = re.compile(r"^\s*[-*]?\s*\d{4}-\d{2}-\d{2}\s*·", re.M)


def main():
    quiet = "--quiet" in sys.argv
    if not os.path.exists(RULE):
        print("🔴 the rule itself is missing: rules/rule-working-in-a-block.md")
        return 2
    if not os.path.isdir(BLOCKS):
        if not quiet:
            print("check-work · no work/blocks directory · nothing to check")
        return 0

    blocks = []
    for dirpath, _, filenames in os.walk(BLOCKS):
        for name in sorted(filenames):
            if name == "BLOCK.md":
                blocks.append(os.path.join(dirpath, name))

    findings = []
    ids = set()
    # rule name -> set of distinct block ids that logged friction against it
    friction = collections.defaultdict(set)

    for path in blocks:
        rel = os.path.relpath(path, ROOT)
        text = open(path, encoding="utf-8").read()
        f = dict(FIELD.findall(text))
        bid = f.get("id", "").strip("`* ") or rel
        ids.add(bid)
        lane = f.get("lane", "").strip("`* ")

        # WRK-LAN-003 · the lane is declared and valid
        if not lane:
            findings.append(("WRK-LAN-003", rel,
                             "no lane declared · expected one of %s"
                             % "|".join(sorted(LANES))))
        elif lane not in LANES:
            findings.append(("WRK-LAN-003", rel,
                             "lane unknown · expected one of %s · got: %r"
                             % ("|".join(sorted(LANES)), lane)))

        # WRK-LAN-002 · declared dependents force full-block
        deps = dependencies(body_of(text, "C"))
        if deps and lane and lane != "full-block":
            findings.append(("WRK-LAN-002", rel,
                             "%d declared dependent(s) but lane is %r · "
                             "expected: full-block · the lane comes from the graph"
                             % (len(deps), lane)))

        # WRK-ISO-002 · every declared connection resolves to a block that exists
        for d in deps:
            d = d.strip("`,. ")
            findings.append(("__dep__", rel, d))

        # WRK-FIX-003 · a full-block change declares its propagation. The lane
        # already says the piece has dependents; §C and §F are where that lands,
        # and a full-block with neither declares a propagation it never mapped.
        if lane == "full-block":
            has_c = bool(dependencies(body_of(text, "C")))
            has_f = bool(re.search(r"^\|.*\|.*\|", body_of(text, "F"), re.M))
            if not has_c and not has_f:
                findings.append(("WRK-FIX-003", rel,
                                 "lane is full-block but neither connections nor "
                                 "sub-blocks declare the propagation · expected: "
                                 "the graph that forced this lane, written down"))

        # WRK-FRI-002 · each friction line carries its four fields
        h = body_of(text, "H")
        loose = FRICTION_LOOSE.findall(h)
        full = FRICTION.findall(h)
        if len(loose) > len(full):
            findings.append(("WRK-FRI-002", rel,
                             "%d friction entr(ies) missing a field · expected "
                             "date · rule · block · reason · got %d complete of %d"
                             % (len(loose) - len(full), len(full), len(loose))))
        for _, rname, _ in full:
            friction[rname.strip().strip("`")].add(bid)

    # resolve the deferred dependency checks now that every id is known
    real = []
    for cid, rel, payload in findings:
        if cid != "__dep__":
            real.append((cid, rel, payload))
            continue
        if payload not in ids:
            real.append(("WRK-ISO-002", rel,
                         "connection points at a block that does not exist: %r · "
                         "resolution is exact, no fuzzy match" % payload))
    findings = real

    # WRK-FRI-003 · a rule chafing in N distinct blocks is flagged for review
    threshold, origin = friction_threshold()
    flagged = [(r, bs) for r, bs in friction.items() if len(bs) >= threshold]

    if not quiet:
        print("check-work · %d block(s) · %d rule(s) with logged friction · "
              "threshold %d (%s)"
              % (len(blocks), len(friction), threshold, origin))
    # WRK-FRI-005 · the agent never infers N. If the rule declares no threshold,
    # say the engine default was used — an undeclared number silently becomes
    # whatever this code happens to hold.
    if origin != "declared":
        findings.append(("WRK-FRI-005", "rules/rule-working-in-a-block.md",
                         "no friction_threshold declared · using the engine "
                         "default of %d · declare it, or every reader assumes "
                         "a different N" % threshold))

    for r, bs in sorted(flagged):
        print("🔔 RULE REVIEW · %r · friction in %d distinct blocks: %s · "
              "WRK-FRI-003 · the owner decides, never the agent"
              % (r, len(bs), ", ".join(sorted(bs))))

    # ⭐ CHK-TRV-002 lives in report(): the caller passes HOW MANY things
    # it examined. ⛔ This printed `✅ 0 violations` over an EMPTY tree —
    # worse than the silent ones, because a false tick is more
    # convincing than an absence.
    return report(findings, "rules/rule-working-in-a-block.md", quiet,
                  examined=len(blocks), subject="block")


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:
        # CHK-CAU-002 · a crash reports nothing, and "nothing reported" reads
        # exactly like "nothing wrong". Turn it into a finding, not a trace.
        print("🔴 %s crashed · %s: %s"
              % (os.path.basename(__file__), type(e).__name__, e))
        sys.exit(1)
