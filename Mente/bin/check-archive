#!/usr/bin/env python3
"""check-archive — enforces the 🔒 rows of rules/contract-archive.md

⭐ A validator that demands a file whose content is undefined produces empty
files that satisfy the check and teach nothing. This one checks the CONTENT
of the two written files, not only that they exist.

Exit: 0 clean · 1 violations · 2 the contract itself is missing
"""
import os, re, sys, glob
import os as _os, sys as _sys
_d = _os.path.dirname(_os.path.abspath(__file__))
while _d != _os.path.dirname(_d):
    if _os.path.exists(_os.path.join(_d, "bin", "utf8.py")):
        _sys.path.insert(0, _os.path.join(_d, "bin")); break
    _d = _os.path.dirname(_d)
import utf8                                          # noqa: F401,E402
import plat                                          # noqa: E402

# ⭐ ONE way to report many findings, shared by every validator —
# CHK-SHR-001. ⛔ Thirteen validators each inventing a grouping is
# thirteen report formats, and a reader who must learn one per
# validator learns none.
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from findings import report                                    # noqa: E402

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CONTRACT = os.path.join(ROOT, "rules", "contract-archive.md")
ARCHIVE = os.path.join(ROOT, "work", "blocks", "archive")
BLOCKS = os.path.join(ROOT, "work", "blocks")

REQUIRED_FILES = ["SUMMARY.md", "connections.md", "BLOCK.md"]
# ⭐ Together these satisfy BLK-ARC-002 from the block contract: an
# archive carries a summary AND what it affected. ⛔ The block
# contract declares the lock; this file is where it is measured.
# ARC-SUM-001 · the fields the summary must answer. Matched on intent, not on
# an exact heading: a contract that pins the wording makes every installation
# that phrases it differently fail for a reason that is not a defect.
# ⬜ Heading names are the installation's. The engine fixes WHAT must be
# answered, never what it is called — an installation writing in another
# language is not in violation; one that omits a field is. Declared in the
# project rules as:  archive_field <field> = <regex>
def load_aliases():
    p = os.path.join(ROOT, "PROJECT-RULES.md")
    out = {}
    if os.path.exists(p):
        # ⛔ `[\w-]+` stops at the first space, and EVERY field name here is
        # several words ("what was built"). The mechanism existed, was
        # documented, and could never match a single alias — built and never
        # connected. Measured: declaring three aliases changed nothing.
        try:
            src = open(p, encoding="utf-8", errors="replace").read()
        except OSError:
            return out            # ⬜ no project rules · nothing to alias
        for m in re.finditer(r"archive_field\s+([\w -]+?)\s*=\s*(.+)", src):
            out[m.group(1).strip()] = m.group(2).strip()
    return out


SUMMARY_FIELDS = {
    "what it was for": r"\b(what it was for|intent|purpose)\b",
    "what was built": r"\b(what was built|delivered|completed)\b",
    "the quality verdict": r"\b(verdict|quality)\b",
    "what was learned": r"\b(learn(ed|ings)?|lesson)\b",
    "what was left out": r"\b(left out|not (done|completed)|remaining|pending)\b",
}
CONNECTION_FIELDS = {
    "pieces owned": r"\b(piece|owned|scope)\b",
    "blocks that depended on it": r"\b(depend|dependent|depended)\b",
    "what is still open": r"\b(still open|open|moved to|unfinished)\b",
}
# ARC-NEV-001 · a credential never reaches an archive, not even an expired one
SECRET = re.compile(
    r"(?i)\b(api[_-]?key|secret|token|password|passwd|private[_-]?key)\b\s*[:=]\s*\S{8,}"
    r"|\b[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}\b")


def body(text, pattern):
    """The section under a heading that matches the pattern.

    ⚠️ The field patterns contain their own groups, so the body cannot be
    group(1): it returned the matched WORD instead of the content, and every
    field read as filled. A named group is the only safe way to address it.
    """
    # The last section runs to the Related line, not to the end of the file:
    # without that boundary an empty field reads as filled by the pointer line
    # that follows it.
    m = re.search(r"^#{1,4}[^\n]*(?:%s)[^\n]*$(?P<body>.*?)"
                  r"(?=^#{1,4}\s|^Related:|\Z)" % pattern,
                  text, re.M | re.S | re.I)
    return m.group("body").strip() if m else None


def check(d, rel):
    bad = []
    # ARC-SHP-001 · all three files present
    for f in REQUIRED_FILES:
        if not os.path.isfile(os.path.join(d, f)):
            bad.append(("ARC-SHP-001", rel,
                        "no %s · an archive missing one of its three files is "
                        "not consultable" % f))
    if bad:
        return bad

    alias = load_aliases()
    sfields = {k: "%s|%s" % (v, alias[k]) if k in alias else v
               for k, v in SUMMARY_FIELDS.items()}
    cfields = {k: "%s|%s" % (v, alias[k]) if k in alias else v
               for k, v in CONNECTION_FIELDS.items()}
    summary = open(os.path.join(d, "SUMMARY.md"), encoding="utf-8").read()
    conns = open(os.path.join(d, "connections.md"), encoding="utf-8").read()
    # ARC-SHP-003 / ARC-DEL-002 read the block file itself, which until now was
    # only checked for existence. ⛔ Guarded: a file present at listing time can
    # be gone at read time, and an unguarded open turns that into a crash.
    try:
        block = open(os.path.join(d, "BLOCK.md"),
                     encoding="utf-8", errors="replace").read()
    except OSError:
        block = ""            # ⬜ unreadable · ARC-SHP-001 already reported it

    # ARC-SHP-002 · the two written files are DOCUMENTS
    for name, text in (("SUMMARY.md", summary), ("connections.md", conns)):
        for field in ("Status", "Type", "Updated", "Owner"):
            if not re.search(r"\*\*%s:\*\*" % field, text):
                bad.append(("ARC-SHP-002", "%s/%s" % (rel, name),
                            "no %s in the header · these are documents, and the "
                            "document contract applies to them" % field))
                break

    # ARC-SHP-003 · the folder name carries the CLOSING period.
    # ⭐ Two blocks with the same name in different periods are two entries,
    # not a conflict — ⛔ but dating by the OPENING makes a block that ran for
    # months file itself under a period it did not close in, and the archive
    # then sorts by when work started, which nobody looks for.
    name = os.path.basename(d.rstrip("/"))
    m_per = re.search(r"_(\d{4})-(\d{2})$", name)
    if not m_per:
        bad.append(("ARC-SHP-003", rel,
                    "the folder name carries no closing period · expected "
                    "`<name>_YYYY-MM` · without it two closings of one block "
                    "collide instead of filing as two entries"))
    else:
        m_closed = re.search(r"^closed:\s*(\d{4})-(\d{2})", block, re.M)
        if m_closed and m_closed.group(1, 2) != m_per.group(1, 2):
            bad.append(("ARC-SHP-003", rel,
                        "the folder says %s-%s and the block closed %s-%s · the "
                        "name carries the CLOSING period, never the opening one"
                        % (m_per.group(1), m_per.group(2),
                           m_closed.group(1), m_closed.group(2))))

    # ARC-DEL-002 · and with it BLK-ARC-001: an archived block keeps its
    # name, because renaming breaks every pointer at once. · an archived block keeps its NAME. ⛔ Renaming breaks every
    # pointer at once, and no pointer says so — they resolve to nothing and
    # each reader concludes the block never existed.
    m_id = re.search(r"^\s*id:\s*([^\n·]+)", block, re.M)
    if m_id:
        bid = m_id.group(1).strip()
        stem = re.sub(r"_\d{4}-\d{2}$", "", name)
        # ⛔ Not string equality. Real ids carry a kind prefix and the period
        # inside (`blk-<name>-YYYY-MM`) while the folder is `<name>_YYYY-MM` —
        # comparing them literally called all six real archives renamed. The
        # rule says the block KEEPS ITS NAME, and the name is what survives
        # once the decoration is stripped from both sides.
        core = re.sub(r"^(?:blk|block)-|-\d{4}-\d{2}$", "", bid)
        if core != stem:
            bad.append(("ARC-DEL-002", rel,
                        "the folder is %r and the block declares id %r · an "
                        "archived block keeps its name: renaming breaks every "
                        "pointer at once, and none of them says so"
                        % (stem, bid)))

    # ARC-SUM-001 · every required field answered
    for label, pat in sfields.items():
        b = body(summary, pat)
        if b is None:
            bad.append(("ARC-SUM-001", "%s/SUMMARY.md" % rel,
                        "no section for %r · a missing field is not an omission, "
                        "it is a false record" % label))

    # ARC-LRN-001 · the one section that is not consolidation
    learned = body(summary, sfields["what was learned"])
    if learned is not None and len(learned.strip()) < 20:
        bad.append(("ARC-LRN-001", "%s/SUMMARY.md" % rel,
                    "'what was learned' is empty · the only section that is not "
                    "a copy, and the reason anybody opens this file"))

    # ARC-SUM-002 · an empty "left out" is a lie
    left = body(summary, sfields["what was left out"])
    if left is not None and len(left.strip()) < 8:
        bad.append(("ARC-SUM-002", "%s/SUMMARY.md" % rel,
                    "'what was left out' is empty · no block closes having done "
                    "everything · silence says nobody looked"))

    # ARC-CON-001 · what the connections file must answer
    for label, pat in cfields.items():
        if body(conns, pat) is None:
            bad.append(("ARC-CON-001", "%s/connections.md" % rel,
                        "no section for %r · the next block cannot tell what "
                        "this closing changed for it" % label))

    # ARC-CON-002 · every id named EXISTS. ⚠️ A pointer to nothing reads as a
    # promise: the reader assumes the block is somewhere and stops looking.
    for cited in re.findall(r"`([a-z][\w-]*(?:[-_][\w-]+)+)`", conns):
        if re.search(r"\.(md|py|sh|tsv|yml|json|ts|js)$", cited):
            continue                     # a file, not a block id
        found = glob.glob(os.path.join(BLOCKS, "**", cited, "BLOCK.md"),
                          recursive=True) or \
                glob.glob(os.path.join(BLOCKS, "**", cited + "_*", "BLOCK.md"),
                          recursive=True)
        if not found:
            bad.append(("ARC-CON-002", "%s/connections.md" % rel,
                        "names %r, which exists in no state · a pointer to "
                        "nothing reads as a promise, and the reader stops "
                        "looking" % cited))
            break

    # ARC-CON-003 · anything still open names WHERE IT MOVED.
    # ⛔ A block does not close over an open sub-block: if one is still open it
    # moves first, and this file says where. ⚠️ An orphaned sub-block is work
    # that disappears silently, and the archive is the last moment anybody
    # would notice.
    still = body(conns, cfields.get("what is still open", r"still open"))
    if still and still.strip() and not re.search(
            r"(?i)\b(moved to|now in|picked up by|→|->|continues in|"
            r"transferred to)\b", still):
        if not re.match(r"(?i)^\s*[-*]?\s*(none|nothing|—|-)\s*$",
                        still.strip()):
            bad.append(("ARC-CON-003", "%s/connections.md" % rel,
                        "something is still open and the file does not say "
                        "WHERE IT MOVED · an orphaned sub-block is work that "
                        "disappears silently, and this is the last moment "
                        "anybody would notice"))

    # ARC-NEV-001 · no credential, not even an expired one
    for name, text in (("SUMMARY.md", summary), ("connections.md", conns),
                       ("BLOCK.md", block)):
        m = SECRET.search(text)
        if m:
            bad.append(("ARC-NEV-001", "%s/%s" % (rel, name),
                        "a credential-shaped value is in the archive · what is "
                        "written stays in the record, and a leaked secret is "
                        "ROTATED, never deleted"))
            break
    return bad


def main():
    quiet = "--quiet" in sys.argv
    if not os.path.exists(CONTRACT):
        print("🔴 the contract itself is missing: rules/contract-archive.md")
        return 2
    if not os.path.isdir(ARCHIVE):
        # ⛔ CHK-TRV-002 · "nothing measured" with no ⬜ is a silent gap, and
        # this early return never reaches report(). 🔴 Found on a CLEAN CLONE
        # and only there: git stores no empty directory, so the folder exists
        # in the working tree and never in a fresh install — ⚠️ the branch the
        # author cannot walk is the one that stayed mute.
        if not quiet:
            print("check-archive · no archive directory\n"
                  "⬜ NOT MEASURED · no archived block to check · nothing was "
                  "verified here")
        return 0

    dirs = [os.path.join(ARCHIVE, n) for n in sorted(os.listdir(ARCHIVE))
            if os.path.isdir(os.path.join(ARCHIVE, n))]
    findings = []
    for d in dirs:
        findings += check(d, plat.rel(d, ROOT))

    if not quiet:
        print("check-archive · %d archived block(s)%s"
              % (len(dirs), " · nothing measured" if not dirs else ""))
    # ⭐ CHK-TRV-002 lives in report(): the caller passes HOW MANY things
    # it examined, and the reporter turns 0 into ⬜ rather than silence.
    # ⛔ Fifteen validators each wrote that tick; one had forgotten it,
    # which is how a duplicated line fails — one straggler at a time.
    return report(findings, "rules/contract-archive.md", quiet,
                  examined=len(dirs), subject="archived block")


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:
        # CHK-CAU-002 · a crash reports nothing, and "nothing reported" reads
        # exactly like "nothing wrong". Turn it into a finding, not a trace.
        print("🔴 %s crashed · %s: %s"
              % (os.path.basename(__file__), type(e).__name__, e))
        sys.exit(1)
