#!/usr/bin/env python3
"""secrets-lease — the credential that lets an agent READ secrets/, tied to the context.

⭐ THE DESIGN IN ONE LINE: permission is born when the context loads and dies when
the context reloads.

⛔ WHY NOT SIMPLY FORBID THE FOLDER. Blocking it outright is technically perfect
and operationally useless: the agent can then neither connect to anything nor
record where a new credential lives, and the workaround is asking a person to
paste the value into the conversation — ⚠️ which puts the secret in a transcript,
the exact outcome the block existed to prevent. Governed access turns
*impossible* into *possible, with permission and with a record*.

⭐ WHY TIED TO THE CONTEXT AND NOT TO A CLOCK. A grant "valid for 60 minutes"
corresponds to nothing real, and it expires mid-task — which trains everyone to
re-open it reflexively, and a permission renewed by reflex is not a permission.
A context reload is a real event: the agent re-reads its own startup from
scratch. Granting there makes the permission part of startup, like the rules
themselves — read once, valid while that load lasts, renewed by the next one.

⛔ THIS IS NOT LIFTING A RESTRICTION FOR CONVENIENCE. Writing still asks, every
time, permission or not. What this opens is READING.

⬜ WHERE THE LEASE LIVES is the installation's, because the folder it guards may
be read-only to the very process that must grant. Default: the engine root.

Usage:
  bin/secrets-lease open [--source <what reloaded>]   grant (called by the startup hook)
  bin/secrets-lease check                             live? exit 0 yes · 1 no
  bin/secrets-lease log <op> <file> [reason]          append to the access log
  bin/secrets-lease status                            human-readable state
  bin/secrets-lease close                             revoke now

Exit: 0 ok · 1 no permission, or a malformed call
"""
import json
import os
import stat
import sys
from datetime import datetime

MENTE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
# ⬜ Both paths are the installation's. ⚠️ The lease must NOT live inside the
# folder it guards: a host may deny writes there, and then the grantor itself
# could not issue. It is gitignored — a committed lease is one that travels to
# another machine, which is the opposite of tying it to THIS context.
LEASE = os.environ.get("MENTE_SECRETS_LEASE") or os.path.join(MENTE, ".secrets-lease.json")
SECRETS = os.environ.get("MENTE_SECRETS_DIR") or os.path.join(MENTE, "secrets")
LOG = os.path.join(SECRETS, ".access-log.md")

HEADER = (
    "# Access log · `secrets/`\n"
    "**Status:** current · **Type:** append-only\n\n"
    "## Purpose\n\n"
    "Who opened this folder, when, and why. Written by `bin/secrets-lease`,\n"
    "never by hand. ⛔ It records the NAME of the file, **never its content** —\n"
    "a log that copies the secret has duplicated it.\n\n"
    "| when | what | file | reason |\n|---|---|---|---|\n"
)


def harden():
    """Make the secrets folder private. ⭐ Idempotent, and it only TIGHTENS.

    ⛔ WHY HERE AND NOT IN AN INSTALLER. Git stores only the executable bit, so
    a cloned secrets/ arrives at whatever the umask gives — measured: 755,
    world-readable, in a folder whose README promises 700. An installer would
    fix that once; ⚠️ the exposure returns the moment somebody recreates the
    folder, and nothing would be watching. This runs before anything reads.

    ⚠️ Never loosens. If an owner hardened the folder further, that is theirs to
    keep — a grantor that reset the mode every run would be undoing a decision
    it knows nothing about. Reports what it changed; ⛔ never blocks on failure,
    because a permission that could not be set is a finding for check-config,
    not a reason to refuse the work.
    """
    changed = []
    try:
        if not os.path.isdir(SECRETS):
            os.makedirs(SECRETS, mode=0o700, exist_ok=True)
            return ["created %s as 700" % os.path.basename(SECRETS)]
        mode = stat.S_IMODE(os.stat(SECRETS).st_mode)
        if mode & 0o077:
            os.chmod(SECRETS, mode & 0o700)
            changed.append("folder %o → %o" % (mode, mode & 0o700))
        for name in sorted(os.listdir(SECRETS)):
            # ⛔ README.md ships in git, which cannot carry a 600 — it arrives
            # 644 in every clone and holds no credential. Tightening it would
            # be undone by the next pull, and a fix that does not survive is
            # noise. check-config exempts it for the same reason.
            if name == "README.md":
                continue
            f = os.path.join(SECRETS, name)
            m = stat.S_IMODE(os.stat(f).st_mode)
            if m & 0o077:
                os.chmod(f, m & (0o700 if os.path.isdir(f) else 0o600))
                changed.append("%s %o → private" % (name, m))
    except OSError as e:
        return ["⚠️ could not harden %s (%s) — check-config will report it"
                % (os.path.basename(SECRETS), e.__class__.__name__)]
    return changed


def read():
    try:
        with open(LEASE, encoding="utf-8") as fh:
            d = json.load(fh)
        return d if isinstance(d, dict) else None
    except (OSError, ValueError):
        return None


def live():
    """Present means live. ⭐ There is deliberately NO clock check: expiry is by
    context, not by minutes. The startup hook REWRITES this file on the next
    load, which is both how the old grant dies and how the new one is born."""
    return read() is not None


def log(op, target, reason=""):
    """Append one line. ⛔ Never the content — only which file, when, and why."""
    stamp = datetime.now().strftime("%Y-%m-%d %H:%M")
    line = "| %s | %s | `%s` | %s |\n" % (
        stamp, op.upper()[:8], os.path.basename(target), reason or "—")
    try:
        os.makedirs(SECRETS, exist_ok=True)
        fresh = not os.path.exists(LOG)
        with open(LOG, "a", encoding="utf-8") as fh:
            # 🔴 600 FROM BIRTH, not after. `open()` creates 644 — readable by
            # every user on the machine, inside a folder that requires 600. The
            # log holds no secret, but it does hold WHICH file was consulted and
            # when: a map of where to look. Tightened with the handle already
            # open, so it never exists even briefly with loose permissions.
            try:
                os.chmod(LOG, 0o600)
            except OSError:
                pass
            if fresh:
                fh.write(HEADER)
            fh.write(line)
        return True
    except OSError:
        return False        # ⛔ the log never blocks the work it records


def main():
    args = sys.argv[1:]
    if not args:
        print(__doc__)
        return 1
    cmd = args[0]

    if cmd == "open":
        src = args[args.index("--source") + 1] if "--source" in args and len(
            args) > args.index("--source") + 1 else "startup"
        # ⭐ Harden BEFORE issuing. A permission granted over a world-readable
        # folder is a permission to read something everyone could already read.
        for line in harden():
            print("🔐 %s" % line)
        try:
            with open(LEASE, "w", encoding="utf-8") as fh:
                json.dump({"opened": datetime.now().isoformat(timespec="seconds"),
                           "source": src}, fh, indent=1)
            os.chmod(LEASE, 0o600)
        except OSError as e:
            print("🔴 could not issue the lease · %s" % e.__class__.__name__)
            return 1
        print("🔑 secrets permission OPEN (%s) — lives until the context reloads" % src)
        return 0

    if cmd == "check":
        return 0 if live() else 1

    if cmd == "close":
        try:
            os.remove(LEASE)
        except OSError:
            pass
        print("🔒 secrets permission revoked")
        return 0

    if cmd == "log":
        if len(args) < 3:
            print("usage: bin/secrets-lease log <op> <file> [reason]")
            return 1
        return 0 if log(args[1], args[2], " ".join(args[3:])) else 1

    if cmd == "status":
        d = read()
        if not d:
            print("🔒 no permission — it opens on the next context load")
            return 1
        print("🔑 permission LIVE since %s (source: %s)"
              % (d.get("opened", "?"), d.get("source", "?")))
        print("   it dies when the context reloads, and is renewed there")
        if os.path.exists(LOG):
            n = sum(1 for ln in open(LOG, encoding="utf-8", errors="replace")
                    if ln.startswith("| 2"))
            print("   log: %d access(es) recorded in secrets/.access-log.md" % n)
        return 0

    print("🔴 unknown command: %s" % cmd)
    return 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:                                     # noqa: BLE001
        print("🔴 %s crashed · %s: %s"
              % (os.path.basename(__file__), type(e).__name__, e))
        sys.exit(1)
