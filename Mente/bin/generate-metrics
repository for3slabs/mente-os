#!/usr/bin/env python3
"""generate-metrics — 🤖 rebuilds docs/METRICS.md · the only place a live number belongs.

⭐ THE RULE THIS SERVES: a live number is never written into prose. A number
copied by hand is correct exactly once — every document repeating it becomes
wrong the moment the value moves, ⛔ and nothing announces it. The document keeps
reading as confident as the day it was typed.

So documents name the METRIC and this file holds the VALUE.

⛔ EVERY NUMBER HERE IS MEASURED WHEN THIS RUNS. Nothing is remembered, nothing
is passed in, and a number that cannot be measured is written as ⬜ NOT MEASURED
rather than omitted — ⚠️ an absent row and a zero look identical in a table, and
only one of them means "we did not look".

⭐ The output carries the do-not-edit header, and that is not decoration: between
a hand edit and the next run, the file states something the tree does not while
still being read as measured truth.

Usage: generate-metrics [--check]
  --check   report whether the file is current, and write nothing
Exit: 0 written or current · 1 --check found it stale · 2 could not write
"""
import os
import re
import subprocess
import sys
from datetime import date

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(ROOT, "docs", "METRICS.md")

HEADER = (
    "<!-- 🤖 GENERATED by bin/generate-metrics — DO NOT EDIT BY HAND.\n"
    "     Hand edits are lost on the next run. Regenerate: bin/generate-metrics -->\n\n"
    "# METRICS — every live number in this installation\n\n"
    "**Status:** current · **Type:** generated · **Updated:** %s · "
    "**Owner:** 🤖 bin/generate-metrics\n"
    "**Scope:** ⚠️ INSTANCE — measured on THIS machine, never committed.\n\n"
    "## Purpose\n\n"
    "> ## ⭐ THIS IS THE ONLY PLACE A LIVE NUMBER BELONGS.\n"
    "> ⛔ A number copied into prose is correct exactly once. Documents name the\n"
    "> metric; this file holds the value.\n\n"
    "> ## ⭐ WHAT `rules.enforced_pct` DOES NOT COVER\n"
    "> ⛔ It is computed over rows already in a **rule table**. A contract or rule\n"
    "> declaring none contributes nothing to either half — ⚠️ so doctrine can grow\n"
    "> without enforcement and this percentage cannot fall, which is the drift it\n"
    "> exists to detect. ⭐ `rules.unenforceable_docs` and `rules.unenforceable_lines`\n"
    "> say how much sits outside it.\n\n"
    "⚠️ Every row below was measured when this file was generated. ⛔ Reading it\n"
    "later tells you what was true THEN — regenerate before quoting it.\n\n"
    "---\n\n")


def sh(*args, cwd=ROOT):
    """⭐ Three states, never two: output, empty, or COULD NOT RUN. ⛔ Returning
    "" for a failed command turns "we could not measure" into "the value is
    zero", and a zero in a metrics table is read as a fact."""
    try:
        r = subprocess.run(args, cwd=cwd, capture_output=True, text=True,
                           timeout=120)
        return r.stdout.strip() if r.returncode == 0 else None
    except (OSError, subprocess.SubprocessError):
        return None


def count_files(folder, suffix):
    """How many files of one kind a folder holds, or None if it is not there.

    ⭐ A SUFFIX IS A FILTER, NOT A GUARD. It selects the kind being counted; it
    never gives up on an object it should have measured. ⛔ The `executable`
    parameter this once carried became dead the moment the three counts that
    needed it grew their own precise rules — and a parameter nothing passes is
    the kind of leftover that makes a later reader think it matters.
    """
    d = os.path.join(ROOT, folder)
    if not os.path.isdir(d):
        return None
    return len([n for n in os.listdir(d)
                if n.endswith(suffix) and os.path.isfile(os.path.join(d, n))])


def battery():
    """The battery's own numbers — ⛔ NOT by running it.

    🔴 THE FIRST VERSION RAN IT, AND THAT WAS A RECURSION. The battery runs every
    probe; one of those probes exercises this generator; this generator ran the
    battery. Each level spawned the whole suite again, and the run never
    finished. ⚠️ It looked like slowness, which is the worst disguise for a loop.

    ⭐ And even without the loop it was the wrong design: a metric that costs a
    full verification run to read is one nobody regenerates, and a metrics file
    nobody regenerates is a stale number wearing a measured face.

    So the battery's result is READ from the last run's report if one exists,
    and reported as ⬜ NOT MEASURED otherwise. ⚠️ The value is dated by the file
    that holds it — the caller is told to run the battery, never lied to.
    """
    report = os.path.join(ROOT, "cache", "last-battery.txt")
    try:
        text = open(report, encoding="utf-8", errors="replace").read()
    except OSError:
        # ⛔ FOUR values, like every other exit from this function. Changing the
        # signature and missing one return path is how a caller unpacks two
        # into four and the whole generator dies — measured 2026-09-02: it took
        # ten probe cases down at once and each looked like a different defect.
        return None, None, None, None
    m = re.search(r"checks:\s*(\d+)\s*·\s*failed:\s*(\d+)", text)
    # ⭐ The DURATION too, per probe. ⛔ A total compared against a total with a
    # different probe count is the arithmetic that turned 28% growth into an
    # apparent 3.3× degradation — measured 2026-09-02, comparing 38 probes
    # against a comment written when there were 14.
    d = re.search(r"seconds:\s*([\d.]+)\s*·\s*probes:\s*(\d+)\s*·\s*"
                  r"per_probe:\s*([\d.]+)", text)
    if m:
        return (int(m.group(1)), int(m.group(2)),
                d.group(1) if d else None, d.group(3) if d else None)
    return (None, None, None, None)


# ⭐ E-21 · THE ONE MEASUREMENT THIS ENGINE OWES ITSELF.
# ⛔ Designing a lot and validating a little is the failure mode that produces
# systems nobody can trust, and a governance engine is the easiest place in the
# world to commit it — because writing a rule FEELS like solving the problem.
# ⚠️ The test cannot be argued: how much of what this engine declares can it
# actually check? A ratio that is only ever stated in prose is the answer.
_RULE_ROW = re.compile(
    r"^\|\s*`([A-Z]{3}-[A-Z]+-\d+)`\s*\|[^|]*\|\s*(🔒|🟡|📖|⬜)\s*\|", re.M)


def enforcement():
    """Every declared rule counted by the level it is held at.

    ⭐ The four levels are the contract's own vocabulary, not this file's:
    🔒 a script refuses · 🟡 something prompts · 📖 discipline · ⬜ not measured.
    ⚠️ Read from the rule TABLES, so a rule described only in prose is not
    counted — ⛔ and that is the honest direction to be wrong in: a rule nothing
    can find is a rule nothing enforces.
    """
    lv, skipped = {}, []
    for dp, dn, fn in os.walk(ROOT):
        dn[:] = [d for d in dn if d not in (".git", "__pycache__", "cache")]
        for f in fn:
            if not f.endswith(".md"):
                continue
            q = os.path.join(dp, f)
            try:
                text = open(q, encoding="utf-8", errors="replace").read()
            except OSError:
                # ⛔ CHK-CAU-003 · a skip is SAID, never counted as a pass. An
                # unreadable document could hold twenty rules, and swallowing it
                # would drop the total silently — ⚠️ the exact defect this
                # metric exists to catch, committed by the metric itself.
                skipped.append(os.path.relpath(q, ROOT))
                continue
            for _, mark in _RULE_ROW.findall(text):
                lv[mark] = lv.get(mark, 0) + 1
    return lv, skipped


def unenforceable():
    """⭐ E-49 · what `rules.enforced_pct` does NOT measure, counted.

    ⛔ The ratio is computed over rows already in a rule table. A `contract` or
    `rule` that declares none is criterion nothing can count — ⚠️ so doctrine
    can grow without enforcement and the percentage cannot fall, which is the
    exact drift it exists to detect.

    ⭐ Reported rather than fixed: a principle is meant to be read and reasoned
    with, and forcing every paragraph into an id-shaped row would turn criterion
    into a checklist. ⛔ What is not defensible is the ratio staying silent
    about what it left out.
    """
    files, lines, unread = 0, 0, []
    for dp, dn, fn in os.walk(ROOT):
        dn[:] = [d for d in dn if d not in (".git", "__pycache__", "cache")]
        for f in fn:
            if not f.endswith(".md"):
                continue
            try:
                t = open(os.path.join(dp, f), encoding="utf-8",
                         errors="replace").read()
            except OSError:
                # ⛔ CHK-CAU-003 · a skip is SAID. ⚠️ A document that could not
                # be read is one this count did not see, and an undercount here
                # makes the exclusion look smaller than it is — the opposite of
                # what this metric exists to disclose.
                unread.append(os.path.relpath(os.path.join(dp, f), ROOT))
                continue
            m = re.search(r"\*\*Type:\*\*\s*([a-z-]+)", t)
            if not m or m.group(1) not in ("contract", "rule"):
                continue
            if not _RULE_ROW.search(t):
                files += 1
                lines += len(t.splitlines())
    return files, lines, unread


def dimensions():
    """⭐ ADR-014 · how much of LAYER 2 this installation has actually declared.

    ⛔ `bin/grade-block` counts the empty rows for one block; nothing said how
    many are unfilled across the installation — ⚠️ and that number is what says
    whether layer 2 exists here at all. Six undeclared means every quality
    verdict is layer 1 wearing a review's shape.

    ⬜ An unreadable contract yields None, said rather than reported as zero
    undeclared, which would read as "fully declared".
    """
    q = os.path.join(ROOT, "rules", "contract-quality-verdict.md")
    try:
        t = open(q, encoding="utf-8", errors="replace").read()
    except OSError:
        return None, None
    # ⚠️ TWO tables carry numbered dimension rows: §5 asks what each dimension
    # JUDGES, and the block below declares what makes it pass HERE. ⛔ Reading
    # both gave 5 + 6 = 11 rows where six dimensions exist — and only the
    # second one is the declaration this measures.
    m = re.search(r"### ⬜ DECLARE YOUR CRITERION(.*?)(?=\n### |\n---)", t, re.S)
    if not m:
        return None, None
    rows = re.findall(r"^\|\s*(\d)\s*\|\s*([a-z ]+?)\s*\|([^|]*)\|",
                      m.group(1), re.M)
    if not rows:
        return None, None
    return len(rows), sum(1 for _, _, v in rows if "⬜ undeclared" in v)


def backlog():
    """How much of the engine's own backlog is closed, versus still written.

    ⛔ A backlog cannot refuse, and neither can a document: if the written half
    keeps growing while the enforced half does not, the engine is proving its
    own diagnosis right.
    """
    q = os.path.join(ROOT, "docs", "ENGINE-BACKLOG.md")
    try:
        text = open(q, encoding="utf-8", errors="replace").read()
    except OSError:
        return None, None
    e = re.findall(r"^## (E-\d+) · (✅ CLOSED)?", text, re.M)
    return sum(1 for _, c in e if c), len(e)


# ⭐ DOC-SIZ-003 · the ceiling is measured in LINES, and the closest document to
# its ceiling is the one worth knowing about. ⛔ "How big is the biggest" is not
# the question — a 700-line contract under a 700 ceiling is fine and a 260-line
# entry-point over a 250 one is not.
def closest_to_ceiling():
    """The document with the smallest margin left, as (name, used, ceiling).

    ⬜ Returns None when the ceiling table cannot be read — ⛔ said rather than
    reported as "everything is comfortable", which is what an absent row reads
    as in a table of numbers.
    """
    q = os.path.join(ROOT, "rules", "contract-document.md")
    try:
        table = open(q, encoding="utf-8", errors="replace").read()
    except OSError:
        return None
    caps = {}
    for line in table.splitlines():
        m = re.match(r"^\|([^|]+)\|\s*\*{0,2}(?:⭐\s*)?\*{0,2}(\d+)\s*lines",
                     line)
        if m:
            for n in re.findall(r"`([a-z-]+)`", m.group(1)):
                caps[n] = int(m.group(2))
    if not caps:
        return None
    worst, unread = None, []
    for dp, dn, fn in os.walk(ROOT):
        dn[:] = [d for d in dn if d not in (".git", "__pycache__", "cache")]
        for f in fn:
            if not f.endswith(".md"):
                continue
            try:
                text = open(os.path.join(dp, f), encoding="utf-8",
                            errors="replace").read()
            except OSError:
                # ⛔ CHK-CAU-003 · a skip is said out loud. ⚠️ Here it is folded
                # into the same counter enforcement() already reports as
                # `rules.documents_unread` — one document that could not be
                # read is one document neither measurement saw.
                unread.append(os.path.relpath(os.path.join(dp, f), ROOT))
                continue
            m = re.search(r"^\*\*Status:.*?\*\*Type:\*\*\s*([a-z-]+)", text,
                          re.M)
            cap = caps.get(m.group(1)) if m else None
            if not cap:
                continue
            used = len(text.splitlines())
            if worst is None or used / cap > worst[1] / worst[2]:
                worst = (os.path.relpath(os.path.join(dp, f), ROOT), used, cap)
    return worst, unread


def rows():
    out = []

    def add(name, value, unit=""):
        # ⬜ A value that could not be measured is SAID, never dropped: an absent
        # row and a zero look identical in a table.
        out.append((name, "⬜ NOT MEASURED" if value is None
                    else "%s%s" % (value, unit)))

    checks, failed, secs, per = battery()
    add("battery.checks", checks)
    add("battery.failed", failed)
    # ⬜ From the LAST recorded run, never by running it — that was a recursion.
    add("battery.seconds", secs)
    add("battery.seconds_per_probe", per)
    # ⭐ E-21 · declared versus enforced, the ratio the engine is judged on.
    lv, unread = enforcement()
    total = sum(lv.values())
    add("rules.declared", total or None)
    for mark, name in (("🔒", "locked"), ("🟡", "prompted"),
                       ("📖", "discipline"), ("⬜", "unmeasured")):
        add("rules.%s" % name, lv.get(mark, 0) if total else None)
    # ⚠️ A percentage, because the count alone hides the direction: 207 locked
    # is good news or bad depending entirely on what it is 207 OUT OF.
    add("rules.enforced_pct",
        round(100.0 * lv.get("🔒", 0) / total, 1) if total else None, "%")
    # ⬜ Said out loud: a count taken over documents some of which could not be
    # read is a count with a known hole, and the reader must be told its size.
    add("rules.documents_unread", len(unread) if not unread else
        "%d · %s" % (len(unread), " ".join(unread[:3])))
    # ⭐ DOC-SIZ-003 · the ceiling has a unit, so it has a live number.
    _got = closest_to_ceiling()
    w, w_unread = _got if _got else (None, [])
    add("documents.closest_to_ceiling",
        "%s (%d/%d lines)" % w if w else None)
    # ⬜ Said, never swallowed: a document that could not be read is one this
    # measurement did not see, and an absent row reads as "nothing to report".
    if w_unread:
        add("documents.unread", "%d · %s" % (len(w_unread),
                                             " ".join(w_unread[:3])))
    # ⭐ E-49 · the ratio says what it does NOT cover. ⛔ A percentage whose
    # denominator is silent about its own gap reads as complete.
    u_files, u_lines, u_unread = unenforceable()
    add("rules.unenforceable_docs", u_files)
    add("rules.unenforceable_lines", u_lines)
    if u_unread:
        add("rules.unenforceable_unread",
            "%d · %s" % (len(u_unread), " ".join(u_unread[:3])))
    # ⭐ ADR-014 · the criterion belongs to the owner, so the engine reports how
    # much of it is still missing rather than filling it in.
    _all, _un = dimensions()
    add("dimensions.declared", (_all - _un) if _all is not None else None)
    add("dimensions.undeclared", _un)
    done, all_ = backlog()
    add("backlog.closed", done)
    add("backlog.entries", all_)
    add("backlog.closed_pct",
        round(100.0 * done / all_, 1) if all_ else None, "%")
    # ⚠️ `validators` means check-*, not "every executable in bin/". The first
    # version counted the generators and the grader too, so the number was true
    # of nothing anybody would ask about.
    d = os.path.join(ROOT, "bin")
    add("validators", len([n for n in os.listdir(d)
                           if n.startswith("check-")
                           and os.access(os.path.join(d, n), os.X_OK)])
        if os.path.isdir(d) else None)
    # ⚠️ The harness and the fixtures module are not probes.
    pd = os.path.join(ROOT, "bin", "probes")
    add("probes", len([n for n in os.listdir(pd) if n.startswith("probe-")
                       and n.endswith(".py")]) if os.path.isdir(pd) else None)
    # ⚠️ A README is not a hook, and neither is the shared helper.
    hd = os.path.join(ROOT, "hooks")
    add("hooks", len([n for n in os.listdir(hd)
                      if not n.startswith(("_", ".")) and n != "README.md"
                      and os.path.isfile(os.path.join(hd, n))])
        if os.path.isdir(hd) else None)
    add("rules", count_files("rules", suffix=".md"))
    # ⭐ DECISIONS, not files. ⛔ count_files counted README.md as a decision:
    # 26 reported where 25 exist, and a number inflated by its own folder's
    # readme is a number nobody can reconcile with the tree.
    # ⚠️ And the count alone hid the useful half — how many are still WAITING.
    _dec = os.path.join(ROOT, "rules", "decisions")
    _st = {}
    try:
        for _f in sorted(os.listdir(_dec)):
            if not _f.startswith("ADR-") or not _f.endswith(".md"):
                continue
            # ⛔ CHK-TRV-002 · the outer try covers listdir, not each READ. An
            # unguarded open here turns one unreadable record into a crash, and
            # a crash reports nothing at all.
            try:
                _t = open(os.path.join(_dec, _f), encoding="utf-8",
                          errors="replace").read()
            except OSError:
                # ⬜ NOT MEASURED, said out loud: an unreadable record is one
                # decision this count did not see, and it surfaces as its own
                # row rather than vanishing into the total.
                _st["unreadable"] = _st.get("unreadable", 0) + 1
                continue
            # ⚠️ A SUPERSEDED record is not debt, whatever its implementation
            # field says. ⛔ Measured: ADR-020 reads `not-started` and its own
            # body says it was superseded before implementation — counting it
            # as pending asks somebody to build a decision that was replaced.
            _su = re.search(r"^status:\s*superseded\b", _t, re.M)
            _m = re.search(r"^implementation:\s*([a-z-]+)", _t, re.M)
            _k = "superseded" if _su else (_m.group(1) if _m else "undeclared")
            _st[_k] = _st.get(_k, 0) + 1
    except OSError:
        _st = None
    add("decisions", sum(_st.values()) if _st else None)
    # ⬜ A decision written and not built is a decision that holds only while
    # somebody remembers it — E-35 and E-37 were both found that way.
    # ⬜ Said, never swallowed — the same rule the skip above obeys.
    if _st and _st.get("unreadable"):
        add("decisions.unreadable", _st["unreadable"])
    add("decisions.pending",
        sum(v for k, v in _st.items() if k in ("not-started", "in-progress"))
        if _st else None)
    add("templates", count_files("templates", suffix=".template"))

    # pieces declared
    try:
        n = sum(1 for l in open(os.path.join(ROOT, "pieces.tsv"),
                                encoding="utf-8", errors="replace")
                if l.strip() and not l.startswith("#")
                and not l.startswith("piece\t"))
        add("pieces.declared", n)
    except OSError:
        add("pieces.declared", None)

    # blocks by state
    # ⭐ WALKED RECURSIVELY, the way check-block walks them. ⛔ The first version
    # looked one level down and counted `active/`, `archive/` and `blocked/` —
    # the STATE folders — as three blocks with no contract. ⚠️ Two pieces
    # disagreeing about where a block lives is how one of them reports a tree
    # nobody has.
    bd = os.path.join(ROOT, "work", "blocks")
    if os.path.isdir(bd):
        states = {}
        for dirpath, _dirnames, filenames in os.walk(bd):
            if "BLOCK.md" not in filenames:
                # ⬜ skipped, and NOT a gap: a directory without a contract file
                # is not a block. The objects this loop measures are BLOCK.md
                # files, and check-block finds them the same way.
                continue
            f = os.path.join(dirpath, "BLOCK.md")
            try:
                t = open(f, encoding="utf-8", errors="replace").read()
            except OSError:
                # ⬜ CHK-CAU-003 · a block that cannot be read must not vanish
                # from the count. ⛔ Dropping it makes blocks.total quietly LOW
                # in the one file the system treats as the source of numbers,
                # and a total that is wrong downward is never questioned.
                states["unreadable"] = states.get("unreadable", 0) + 1
                continue
            m = re.search(r"^status:\s*(\w+)", t, re.M | re.I)
            k = (m.group(1).lower() if m else "unknown")
            states[k] = states.get(k, 0) + 1
        add("blocks.total", sum(states.values()))
        for k in sorted(states):
            add("blocks.%s" % k, states[k])
    else:
        add("blocks.total", None)

    return out


def render():
    body = HEADER % date.today().isoformat()
    body += "| Metric | Value |\n|---|---|\n"
    for name, value in rows():
        body += "| `%s` | %s |\n" % (name, value)
    body += ("\n---\n\n⭐ **Every value above was measured when this ran.** ⛔ A "
             "row reading ⬜ NOT MEASURED\nis a gap, never a zero — the two look "
             "the same in a table and mean opposite things.\n\n"
             "Related: `docs/README.md` (why generated files are never hand-"
             "edited) · `CAPABILITIES.md`.\n")
    return body


def main():
    check = "--check" in sys.argv
    body = render()

    if check:
        try:
            current = open(OUT, encoding="utf-8").read()
        except OSError:
            print("🟡 %s does not exist · run bin/generate-metrics"
                  % os.path.relpath(OUT, ROOT))
            return 1
        # ⚠️ The date line changes every day and is not a stale measurement, so
        # it is excluded from the comparison. ⛔ Including it would report every
        # file as stale the day after it was written, and a check that always
        # fires is one nobody reads.
        strip = lambda t: re.sub(r"\*\*Updated:\*\* \d{4}-\d{2}-\d{2}", "", t)
        if strip(current) != strip(body):
            print("🟡 %s is stale · the tree changed since it was written"
                  % os.path.relpath(OUT, ROOT))
            return 1
        print("✅ %s is current" % os.path.relpath(OUT, ROOT))
        return 0

    try:
        os.makedirs(os.path.dirname(OUT), exist_ok=True)
        open(OUT, "w", encoding="utf-8").write(body)
    except OSError as e:
        print("🔴 could not write %s · %s" % (OUT, e.__class__.__name__))
        return 2
    n = body.count("\n| `")
    gaps = body.count("NOT MEASURED")
    print("🤖 %s · %d metric(s)%s" % (os.path.relpath(OUT, ROOT), n,
                                      " · ⬜ %d not measured" % gaps if gaps else ""))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:                                     # noqa: BLE001
        print("🔴 %s crashed · %s: %s"
              % (os.path.basename(__file__), type(e).__name__, e))
        sys.exit(2)
