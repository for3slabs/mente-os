#!/usr/bin/env python3
"""generate-index — 🤖 rebuilds docs/INDEX.md · docs/STATES.md · docs/DECISIONS.md

⭐ WHY THESE ARE GENERATED AND NOT WRITTEN. A hand-maintained index goes stale
SILENTLY and keeps being believed — an index looks authoritative by nature, so
nobody re-checks it. ⛔ The failure is not that it is wrong; it is that being
wrong changes nothing about how it reads.

Three files, one traversal, because they answer three questions about the same
tree:

  · INDEX.md      every document that exists, by folder
  · STATES.md     which blocks exist and what state each is in
  · DECISIONS.md  every decision recorded, with its status

⛔ NONE OF THEM TRAVELS. A committed index arrives listing documents that do not
exist on the new machine, and it would look authoritative there too — ⚠️ a clone
would start with a report about a system that is not its own.

Usage: generate-index [--check]
  --check   report whether the files are current, and write nothing
Exit: 0 written or current · 1 --check found one stale · 2 could not write
"""
import os
import os as _os, sys as _sys
_d = _os.path.dirname(_os.path.abspath(__file__))
while _d != _os.path.dirname(_d):
    if _os.path.exists(_os.path.join(_d, "bin", "utf8.py")):
        _sys.path.insert(0, _os.path.join(_d, "bin")); break
    _d = _os.path.dirname(_d)
import utf8                                          # noqa: F401,E402
import re
import sys
from datetime import date

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DOCS = os.path.join(ROOT, "docs")
# ⛔ `cache/` is RUNTIME STATE, not documentation. Indexing its README made the
# index point at a file that legitimately does not exist in a fresh copy — and
# an index whose own pointers break is worse than no index, because it is
# trusted more. ⚠️ Found when a probe copy, which correctly omits cache/, read
# an index that insisted the file was there.
SKIP_DIRS = {".git", "__pycache__", "node_modules", ".test-lock", ".beats",
             "cache"}
# 🤖 The generated files themselves. ⛔ Indexing them would make each run change
# what the next run indexes — a file that never converges.
GENERATED = {"INDEX.md", "STATES.md", "DECISIONS.md", "METRICS.md"}


def head(title, script, subtitle):
    return ("<!-- 🤖 GENERATED by bin/%s — DO NOT EDIT BY HAND.\n"
            "     Hand edits are lost on the next run. Regenerate: bin/%s -->\n\n"
            "# %s\n\n"
            "**Status:** current · **Type:** generated · **Updated:** %s · "
            "**Owner:** 🤖 bin/%s\n"
            "**Scope:** ⚠️ INSTANCE — rebuilt from THIS tree, never committed.\n\n"
            "## Purpose\n\n%s\n\n---\n\n"
            % (script, script, title, date.today().isoformat(), script, subtitle))


def field(text, name):
    m = re.search(r"\*\*%s:\*\*\s*([^·\n*]+)" % name, text)
    return m.group(1).strip() if m else None


def documents():
    """Every .md in the tree, with what its header declares."""
    out = []
    for dp, dn, fn in os.walk(ROOT):
        dn[:] = [d for d in dn if d not in SKIP_DIRS]
        for n in sorted(fn):
            if not n.endswith(".md") or n in GENERATED:
                continue
            p = os.path.join(dp, n)
            rel = os.path.relpath(p, ROOT).replace(os.sep, "/")
            try:
                t = open(p, encoding="utf-8", errors="replace").read(4000)
            except OSError:
                # ⬜ An unreadable document still EXISTS. Leaving it out would
                # make the index quietly short, and a count that is wrong
                # downward is never questioned.
                out.append((rel, "⬜ unreadable", "—"))
                continue
            out.append((rel, field(t, "Type") or "—", field(t, "Status") or "—"))
    return sorted(out)


def blocks():
    out = []
    bd = os.path.join(ROOT, "work", "blocks")
    for dp, dn, fn in os.walk(bd):
        dn[:] = [d for d in dn if d not in SKIP_DIRS]
        if "BLOCK.md" not in fn:
            continue          # ⬜ skipped, not a gap: no contract, no block
        p = os.path.join(dp, "BLOCK.md")
        rel = os.path.relpath(dp, ROOT).replace(os.sep, "/")
        try:
            t = open(p, encoding="utf-8", errors="replace").read()
        except OSError:
            out.append((rel, "⬜ unreadable", "—", "—"))
            continue

        def f(name):
            m = re.search(r"(?:^|·)\s*%s:\s*([^\n·]+)" % name, t, re.M)
            return m.group(1).strip() if m else "—"
        out.append((rel, f("status"), f("lane"), f("updated")))
    return sorted(out)


def decisions():
    out = []
    dd = os.path.join(ROOT, "rules", "decisions")
    if not os.path.isdir(dd):
        return out
    for n in sorted(os.listdir(dd)):
        if not n.endswith(".md") or n == "README.md":
            continue
        try:
            t = open(os.path.join(dd, n), encoding="utf-8",
                     errors="replace").read()
        except OSError:
            out.append(("rules/decisions/" + n, "⬜ unreadable", "—"))
            continue
        st = re.search(r"^status:\s*(\S+)", t, re.M)
        sup = re.search(r"^superseded-by:\s*(\S+)", t, re.M)
        out.append(("rules/decisions/" + n, st.group(1) if st else "—",
                    sup.group(1) if sup and sup.group(1) != "—" else ""))
    return out


def render_index():
    docs = documents()
    body = head("INDEX — every document in this tree", "generate-index",
                "⭐ What exists, measured from the tree rather than remembered.\n"
                "⛔ A hand-kept index goes stale silently and keeps being "
                "believed.")
    folder = None
    for rel, typ, status in docs:
        f = rel.rsplit("/", 1)[0] if "/" in rel else "."
        if f != folder:
            folder = f
            body += "\n## `%s`\n\n| Document | Type | Status |\n|---|---|---|\n" % f
        body += "| `%s` | %s | %s |\n" % (rel, typ, status)
    body += ("\n---\n\n⭐ %d document(s) found.\n\n"
             "Related: `docs/README.md` (why this is generated) · "
             "`docs/STATES.md` · `docs/METRICS.md`.\n" % len(docs))
    return body


def render_states():
    bl = blocks()
    body = head("STATES — which blocks exist and where each stands",
                "generate-index",
                "⭐ The state of the work, read from each block's own contract.\n"
                "⚠️ A block whose state is `—` declares none — nothing can act "
                "on it.")
    if not bl:
        body += ("⬜ NOT MEASURED · no block carries a contract in this tree · "
                 "nothing to report.\n\n⭐ That is the correct state for a fresh "
                 "installation, and it is said rather than shown as an empty "
                 "table.\n")
    else:
        body += "| Block | Status | Lane | Updated |\n|---|---|---|---|\n"
        for rel, st, lane, upd in bl:
            body += "| `%s` | %s | %s | %s |\n" % (rel, st, lane, upd)
        body += "\n---\n\n⭐ %d block(s).\n" % len(bl)
    body += ("\nRelated: `docs/README.md` (why this is generated) · "
             "`docs/INDEX.md` · `rules/contract-block.md`.\n")
    return body


def render_decisions():
    dec = decisions()
    body = head("DECISIONS — every decision on record", "generate-index",
                "⭐ A decision is append-only: superseded, never rewritten.\n"
                "⛔ A record edited after the fact cannot be told from one that "
                "was always right.")
    if not dec:
        body += "⬜ NOT MEASURED · no decision recorded in this tree.\n"
    else:
        body += "| Record | Status | Superseded by |\n|---|---|---|\n"
        for n, st, sup in dec:
            body += "| `%s` | %s | %s |\n" % (n, st, sup or "—")
        live = len([d for d in dec if not d[2]])
        body += ("\n---\n\n⭐ %d decision(s) · %d still standing.\n"
                 % (len(dec), live))
    body += ("\nRelated: `docs/README.md` (why this is generated) · "
             "`rules/contract-adr.md` · `docs/INDEX.md`.\n")
    return body


TARGETS = [("INDEX.md", render_index),
           ("STATES.md", render_states),
           ("DECISIONS.md", render_decisions)]


def main():
    check = "--check" in sys.argv
    stale, wrote = [], []
    # ⚠️ The date line moves every day without the tree changing, so it is
    # excluded from the comparison. ⛔ Including it reports every file as stale
    # the day after it was written, and a check that always fires is ignored.
    strip = lambda t: re.sub(r"\*\*Updated:\*\* \d{4}-\d{2}-\d{2}", "", t)

    for name, render in TARGETS:
        out = os.path.join(DOCS, name)
        body = render()
        if check:
            try:
                if strip(open(out, encoding="utf-8").read()) != strip(body):
                    stale.append(name)
            except OSError:
                stale.append(name)
            continue
        try:
            os.makedirs(DOCS, exist_ok=True)
            open(out, "w", encoding="utf-8").write(body)
            wrote.append(name)
        except OSError as e:
            print("🔴 could not write %s · %s" % (name, e.__class__.__name__))
            return 2

    if check:
        if stale:
            print("🟡 %d generated file(s) stale: %s · run bin/generate-index"
                  % (len(stale), ", ".join(stale)))
            return 1
        print("✅ %d generated file(s) current" % len(TARGETS))
        return 0
    print("🤖 %s" % " · ".join("docs/" + n for n in wrote))
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:                                     # noqa: BLE001
        print("🔴 %s crashed · %s: %s"
              % (os.path.basename(__file__), type(e).__name__, e))
        sys.exit(2)
