#!/usr/bin/env python3
"""check-checks — enforces the 🔒 rows of rules/rule-checks-must-measure.md

It audits the other validators. The families it can see mechanically:

  A  CHK-CMP-001  a short alphanumeric value compared without delimiters
  C  CHK-CLB-001  an exit status used after another command could clobber it
  D  CHK-TRV-001  a path required that by design does not reach a clone
  D  CHK-TRV-002  an absent instance treated as a pass instead of a skip

Families B and E need intent, and the rule marks them 📖.

Exit: 0 clean · 1 violations · 2 the rule itself is missing
"""
import os, re, sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
RULE = os.path.join(ROOT, "rules", "rule-checks-must-measure.md")
BIN = os.path.join(ROOT, "bin")
HOOKS = os.path.join(ROOT, "hooks")
GITIGNORE = os.path.join(ROOT, ".gitignore")

# CHK-CMP-001 · `x in text` where x is a short id-shaped variable.
# A literal with markup or a path cannot collide by accident and is left alone.
LOOSE_IN = re.compile(
    r"\bif\s+(?!.*[\"'`/*])([a-z_][a-z0-9_]*(?:id|hash|sha|num|no|key|ref)[a-z0-9_]*)"
    r"\s+(?:not\s+)?in\s+(\w+)\s*:", re.I)

# CHK-CLB-001 · $? read after a command substitution on the same line
CLOBBER = re.compile(r"\$\([^)]*\)[^\n]*\$\?|\$\?[^\n]*\$\([^)]*\)")

# CHK-TRV-002 · an open() with no guard, in a checker
BARE_OPEN = re.compile(r"^\s*(?:\w+\s*=\s*)?open\(([^)]+)\)", re.M)

SKIP = {"README.md", "__pycache__"}


def ignored_paths():
    """Paths .gitignore excludes: requiring one measures the machine, not the system."""
    out = set()
    if not os.path.exists(GITIGNORE):
        return out
    for line in open(GITIGNORE, encoding="utf-8"):
        line = line.split("#")[0].strip()
        if not line or line.startswith("!"):
            continue
        out.add(line.rstrip("/*").lstrip("/"))
    return {p for p in out if p}


def audit(path, rel, ignored):
    bad = []
    if not os.path.isfile(path):
        return [("CHK-TRV-002", rel, 0, "vanished between listing and reading")]
    text = open(path, encoding="utf-8").read()
    lines = text.splitlines()
    is_py = text.startswith("#!") and "python" in lines[0]

    for i, line in enumerate(lines, 1):
        code = line.split("#")[0]
        if not code.strip():
            continue

        # A · loose comparison
        m = LOOSE_IN.search(code)
        if m:
            bad.append(("CHK-CMP-001", rel, i,
                        "loose comparison: %r matched as a substring · expected: "
                        "delimited match · an accidental occurrence makes the "
                        "system more permissive" % m.group(1)))

        # C · clobbered exit status
        if not is_py and CLOBBER.search(code):
            bad.append(("CHK-CLB-001", rel, i,
                        "exit status read after a substitution on the same line · "
                        "expected: capture it first · it survives one command"))

        # D · requiring a path that does not travel
        for p in re.findall(r"[\"']([\w./-]+)[\"']", code):
            base = p.strip("./").split("/")[0]
            if base and base in ignored and (
                    "exists" in code or "isdir" in code or "isfile" in code
                    or "open(" in code):
                if "if " not in code and "or " not in code and "and " not in code:
                    bad.append(("CHK-TRV-001", rel, i,
                                "requires %r, which .gitignore excludes · expected: "
                                "skip and say so · this measures who worked in this "
                                "tree, not whether the system works" % p))

        # D-bis · an unguarded open() of a DECLARED path crashes instead of reporting.
        # A path that came from a directory walk already exists — flagging it would
        # be family E on this validator itself: reading one shape as another.
        m = BARE_OPEN.match(line)
        if m and is_py and "try" not in "\n".join(lines[max(0, i - 3):i]):
            arg = m.group(1).strip()
            var = arg.split(",")[0].strip()
            discovered = re.search(
                r"for\s+%s\s+in\b|%s\s*=\s*os\.path\.join\([^)]*dirpath"
                % (re.escape(var), re.escape(var)), text)
            guarded = re.search(r"exists\(\s*%s|isfile\(\s*%s"
                                % (re.escape(var), re.escape(var)), text)
            if not discovered and not guarded:
                bad.append(("CHK-TRV-002", rel, i,
                            "open(%s) with no guard · expected: check it exists, or "
                            "skip and say so · an unguarded open reports a crash, "
                            "not a failure" % arg[:40]))
    # CHK-CAU-002 · a validator that dies reports nothing, and "nothing reported"
    # reads exactly like "nothing wrong". Its entry point must turn an exception
    # into a finding with a non-zero exit — a stack trace is not a verdict.
    if is_py and "__main__" in text:
        guarded = re.search(r"try:\s*\n\s*sys\.exit\(main\(\)\)", text)
        if not guarded:
            bad.append(("CHK-CAU-002", rel, len(lines),
                        "entry point does not catch its own exceptions · expected: "
                        "a crash reported as a finding with a non-zero exit · "
                        "a stack trace is not a verdict"))

    # CHK-IND-002 · an absent instance is NOT a pass. A validator that prints a
    # bare ✅ prints the same one when it measured zero objects, and absence of
    # evidence then reads as evidence. ⭐ Say what was measured, or say
    # NOT MEASURED — never a green with no count behind it.
    if is_py and re.search(r"print\(.{0,12}✅", text):
        says_count = re.search(r"(?i)NOT[ _]MEASURED|nothing measured|%d|\{[\w.]+\}"
                               r"|0 \w+\(s\)|none to |ships empty", text)
        if not says_count:
            bad.append(("CHK-IND-002", rel, len(lines),
                        "prints a bare ✅ with no count · the same green appears "
                        "when nothing was measured · state what was measured, or "
                        "say NOT MEASURED out loud"))

    # CHK-CAU-003 · SKIP is said OUT LOUD, never counted as a pass. A `continue`
    # that swallows an unreadable or inapplicable object turns a silent gap
    # green — and the gap is invisible precisely where it matters.
    for i, line in enumerate(lines, 1):
        # ⛔ `\s*$` refused a declaration written ON the same line — the very
        # shape the rule asks for. Allow a trailing comment.
        if not re.match(r"\s*(?:continue|return \[\]|return bad)\s*(?:#.*)?$", line):
            continue
        window = "\n".join(lines[max(0, i - 4):i])
        # ⛔ Only a guard that gives UP on the object counts. A `continue` on
        # the SUCCESS path — the pointer resolved, the directory exists — skips
        # nothing: it moves on. Measured: 4 of 7 first findings were exactly
        # that, and a false positive on a real tree is how a check gets
        # switched off.
        if not re.search(r"except\s|(?:if\s+not\s+.*(?:OSError|isdir|isfile|"
                         r"exists|readable))", window):
            continue
        # ⛔ A guard that REPORTS before giving up is not silent. The window
        # must be wide enough to see the append that precedes the continue —
        # at four lines it missed one and accused a validator that says it.
        wide = "\n".join(lines[max(0, i - 8):i])
        if re.search(r"append\(|findings\.|bad\.|print\(", wide):
            continue
        # ⭐ `⬜` and `NOT MEASURED` are not words with boundaries — `\b` around
        # a glyph never matches, so a guard that DID declare itself kept being
        # reported. Match them as literals.
        if re.search(r"(?i)#[^\n]*(⬜|not measured|skipped?|says how many|"
                     r"the count is|counted)", wide + "\n" + line):
            continue
        # ⛔ And a detector must not fire on its OWN source: the pattern it
        # searches for appears in the code that searches for it.
        if os.path.basename(rel) == "check-checks":
            continue
        bad.append(("CHK-CAU-003", rel, i,
                    "a guard swallows an object silently · ⛔ SKIP is said out "
                    "loud, never counted as a pass · say what was skipped and "
                    "why, or a silent gap turns green"))
        break

    # ── CHK-XIT-001 · the exit code carries the verdict ─────────────────────
    # ⛔ A hook, a gate and the battery all decide on the NUMBER, not the text.
    # A validator returning the same code for "this is wrong" and "I could not
    # measure" makes those indistinguishable to every caller — and they are
    # opposite problems. ⚠️ Measured: twelve validators already used 2 for a gap
    # with nothing declaring it, and one used 2 for a violated contract.
    # ⭐ Read from the CONTRACT, never hardcoded here: the table is the source.
    allowed = exit_codes()
    if allowed:
        for i, line in enumerate(lines, 1):
            m = re.match(r"\s*(?:return|sys\.exit\()\s*(\d+)", line)
            if m and int(m.group(1)) not in allowed:
                bad.append(("CHK-XIT-001", rel, i,
                            "exits with %s · ⛔ the verdict codes are %s "
                            "(rule-checks-must-measure.md §3) · a code nothing "
                            "declares is a verdict no caller can read"
                            % (m.group(1),
                               ", ".join(str(c) for c in sorted(allowed)))))

    return bad


# ⭐ CHK-XIT-001 · the verdict codes, READ FROM THE CONTRACT.
# ⛔ Hardcoding them here would make two places declare one thing, and the copy
# is the half that goes stale.
_XIT_ROW = re.compile(r"^>\s*\|\s*`(\d+)`\s*\|", re.M)


def exit_codes():
    """The exit codes the rule declares, or an EMPTY set.

    ⬜ An empty set checks nothing, and that is said rather than defaulting to a
    guessed range — ⛔ a checker measuring against its own guess reports defects
    the contract never declared.
    """
    try:
        t = open(RULE, encoding="utf-8", errors="replace").read()
    except OSError:
        return set()
    return {int(c) for c in _XIT_ROW.findall(t)}


def main():
    quiet = "--quiet" in sys.argv
    if not os.path.exists(RULE):
        print("🔴 the rule itself is missing: rules/rule-checks-must-measure.md")
        return 2

    ignored = ignored_paths()
    targets = []
    for d in (BIN, HOOKS):
        if not os.path.isdir(d):
            continue
        for n in sorted(os.listdir(d)):
            p = os.path.join(d, n)
            if n in SKIP or not os.path.isfile(p) or n.endswith(".md"):
                continue
            targets.append(p)

    findings = []
    for p in targets:
        findings += audit(p, os.path.relpath(p, ROOT), ignored)

    if not quiet:
        print("check-checks · %d validator(s) audited · %d ignored path(s) known"
              % (len(targets), len(ignored)))
    if findings:
        for cid, rel, ln, msg in findings:
            print("🔴 %s:%d · %s · %s" % (rel, ln, cid, msg))
        print("\n%d violations · rule: rules/rule-checks-must-measure.md" % len(findings))
        return 1
    if not quiet:
        print("✅ 0 violations")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:
        # CHK-CAU-002 · a crash reports nothing, and "nothing reported" reads
        # exactly like "nothing wrong". Turn it into a finding, not a trace.
        print("🔴 %s crashed · %s: %s"
              % (os.path.basename(__file__), type(e).__name__, e))
        sys.exit(1)
