#!/usr/bin/env python3
"""init — turns a clone into an installation.

⭐ WHAT AN INSTALLATION IS, in one line: a clone owns nothing personal, and this
is the single moment identity enters — from the person in front of it, never
from a file that shipped from somebody else's machine.

🔴 THE FAILURE THAT SHAPES THIS FILE. When a config once travelled with a real
owner name inside, this step ran on someone else's clone and NEVER ASKED for the
owner: it found a name already written and took it as truth. ⛔ A personal value
disguised as an engine default. So what is asked is asked because it CANNOT be
derived, and what is derived is never asked.

── THE FOUR THINGS IT DOES ─────────────────────────────────────────────────────
  ① stamp each template into the place the piece table says it lives
  ② fill {{owner}} {{project}} {{date}} across the engine — ⛔ not only in the
     templates: 75 shipped documents carry them, and a header reading
     `Owner: {{owner}}` passes every check while identifying nobody
  ③ append the router import to the user's own CLAUDE.md — ⭐ APPEND, never
     overwrite: that one line is the only thing this system writes outside its
     own folder
  ④ wire what git cannot carry — the pre-push hook, and the secrets folder's
     mode

⛔ IT REFUSES TO OVERWRITE. Every generated file is skipped if it already exists;
`--force` overwrites, and says what it replaced. ⚠️ Without that rule a second
run silently destroys a configured instance, and the destruction looks like a
successful install.

Usage:
  bin/init [--force] [--owner NAME] [--dry-run]
Exit: 0 installed · 1 nothing to do or refused · 2 could not complete
"""
import os as _os, sys as _sys
_d = _os.path.dirname(_os.path.abspath(__file__))
while _d != _os.path.dirname(_d):
    if _os.path.exists(_os.path.join(_d, "bin", "utf8.py")):
        _sys.path.insert(0, _os.path.join(_d, "bin")); break
    _d = _os.path.dirname(_d)
import utf8                                          # noqa: F401,E402
import json
import os
import re
import shutil
import stat
import subprocess
import sys
from datetime import date

MENTE = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(MENTE, "bin"))
import tsvread                                                 # noqa: E402
import plat                                                    # noqa: E402
REPO = os.path.dirname(MENTE)
TEMPLATES = os.path.join(MENTE, "templates")
TABLE = os.path.join(MENTE, "pieces.tsv")
SUFFIX = ".template"
IMPORT_LINE = "@%s/CLAUDE-MENTE-OS.md" % os.path.basename(MENTE)

# ⭐ Two templates the piece table cannot place, each for a real reason, and
# declared HERE with that reason rather than left to be guessed.
#   · the router's content already ships as CLAUDE-MENTE-OS.md — what the
#     template describes is loaded through an import, not copied into place
#   · the bridges registry names its file, and the table declares the folder
#   · the gate wiring lands OUTSIDE Mente/, in the repository's own .claude/,
#     and only when there is none — so ③b places it, not the stamping loop
SPECIAL = {"CLAUDE.md": None,                       # ⛔ never stamped: see ③
           "claude-settings.json": None,            # ⛔ never stamped: see ③b
           "bridges.md": "connection/bridges/BRIDGES.md"}
# ⚠️ STAMPED PER USE, NOT AT INSTALL — and the reason is the same for both: an
# installation has zero of these until somebody starts one, and writing a blank
# copy would put an unfilled scope (or an empty block) on disk where a validator
# reads it as a real one.
#   · handoff.yml  — one manifest belongs to one delegation
#   · BLOCK.md     — bin/new-block stamps it, once per unit of work
#   · CAMPAIGN.md  — bin/new-campaign, once per campaign
NOT_INSTALLED = {"handoff.yml", "BLOCK.md", "CAMPAIGN.md"}



def write(path, body):
    """Write a generated file with the line endings it was authored with.

    🔴 THE FAILURE, measured 2026-09-06 on a real Windows install. Every file
    this script generated was written through a plain `open(..., "w")`, and on
    Windows Python translates each "\n" to "\r\n" — ⛔ so the Claude Code skill
    landed with CRLF, its YAML frontmatter did not parse, and `/session-wrap`
    simply did not exist in the person's command menu. ⚠️ The install reported
    success and the command was gone.

    ⭐ The repository already refuses conversion (`.gitattributes` is `* -text`)
    for exactly this reason; the installer was the one place still converting.
    ⛔ `newline=""` is what turns that off — never omit it on a generated file.

    ⚠️ ONE writer, not five. CHK-SHR-001: this bug existed in five separate
    `open(...)` calls, and fixing four of them would have looked identical.
    """
    with open(path, "w", encoding="utf-8", newline="") as fh:
        fh.write(body)

def die(msg, code=2):
    print("🔴 %s" % msg, file=sys.stderr)
    sys.exit(code)


def declared_paths():
    """Every path the piece table declares, by basename.

    ⭐ DERIVED, NOT LISTED. A list of destinations inside this file is a list
    that goes stale: add a template, forget the list, and the file is never
    installed while nothing says so. The piece table already exists to answer
    "where does this live" — asking it means a new template is placed the moment
    it is declared.
    """
    out = {}
    # ⭐ CHK-SHR-001 · ONE reader (bin/tsvread.py). ⛔ Six copies had
    # patched the header four different ways.
    for n, f in tsvread.rows(TABLE, want=2):
        p = f[1]
        if p.startswith("templates/"):
            continue          # the blueprint itself, not a destination
        out.setdefault(os.path.basename(p), p)
    return out


def plan():
    """(template path, destination) for everything this installs.

    ⛔ A template whose destination cannot be resolved is a FAILURE, never a
    silent skip: it means the engine ships a blueprint nothing will ever stamp,
    and the install would look complete while a file was missing.
    """
    known = declared_paths()
    out, unresolved = [], []
    for name in sorted(os.listdir(TEMPLATES)):
        if not name.endswith(SUFFIX):
            continue
        produced = name[:-len(SUFFIX)]
        if produced in NOT_INSTALLED:
            continue
        if produced in SPECIAL:
            dest = SPECIAL[produced]
            if dest is None:
                continue
        elif produced in known:
            dest = known[produced]
        else:
            unresolved.append(produced)
            continue
        out.append((os.path.join(TEMPLATES, name), os.path.join(MENTE, dest)))
    return out, unresolved


def ask(prompt):
    """Ask the person in front of the terminal.

    🔴 REFUSES WHEN THERE IS NO TERMINAL rather than choosing a default. ⛔ A
    default owner is exactly the leak this whole step exists to prevent: it
    would write a name nobody chose into every generated document, and every
    check downstream would confirm it as correct.
    """
    if not sys.stdin.isatty():
        # 🔴 THE MESSAGE TAUGHT THE WAY AROUND ITSELF. Measured 2026-09-05 on a
        # real install: an assistant ran this without a terminal, read
        # "or pass --owner NAME", INVENTED a name from the folder it was sitting
        # in, and installed. The owner was never asked. ⛔ The guard held and the
        # hint defeated it — a refusal that names its own bypass is a suggestion.
        die("no terminal — the owner's name has to come from the person.\n"
            "   👉 ASK THEM, then run:  bin/init --owner \"<their answer>\"\n"
            "   ⛔ Do NOT derive it from the folder, the git config, or the "
            "account name.\n"
            "   ⭐ This is the one value the engine cannot compute: a name "
            "nobody chose\n"
            "      goes into every generated document and every check "
            "downstream confirms\n"
            "      it as correct.", 2)
    try:
        answer = input(prompt).strip()
    except (EOFError, KeyboardInterrupt):
        die("cancelled — nothing was written", 1)
    return answer or die("an owner name is required", 1)


def substitute(text, values):
    for k, v in values.items():
        text = text.replace("{{%s}}" % k, v)
    return text



# ⚠️ The scaffolding comment every template opens with: an instruction to
# whoever EDITS the mould, addressed to nobody once it is stamped.
_SCAFFOLD = re.compile(r"\A<!--\s*⚠️\s*TEMPLATE\s*—.*?-->\s*\n", re.S)
# ⚠️ A YAML template cannot use an HTML comment, so its scaffolding is a run of
# `#` lines instead — 🔴 found by the probe, which reads the RESULT and does not
# care what the comment syntax was.
_SCAFFOLD_HASH = re.compile(
    r"\A(?:#[^\n]*\n)*?#[^\n]*THIS IS THE TEMPLATE[^\n]*\n(?:#[^\n]*\n)*\s*")


def strip_scaffold(text):
    """Remove the template's own instructions before it becomes a real file.

    🔴 THE FAILURE, measured 2026-09-07 on a real installation. Nine templates
    open with `<!-- ⚠️ TEMPLATE — bin/init copies this to … -->`, and the
    installer copied it through: the person's own `memory/RESUME.md` began by
    saying it was a template and that "you never write this file by hand".
    ⛔ No validator caught it — `check-document` reads the header, never
    whether a file is still its own mould.
    ⚠️ And the assistant read it as an instruction: the scaffolding was
    teaching it that the memory was not its to fill in.
    """
    text = _SCAFFOLD.sub("", text, count=1)
    return _SCAFFOLD_HASH.sub("", text, count=1)

def fill_engine(values, dry):
    """② Fill the placeholders across the SHIPPED files.

    🔴 THE HALF THAT IS EASY TO MISS. Stamping the templates leaves 75 engine
    documents still reading `Owner: {{owner}}` — and that passes every check,
    because a placeholder is syntactically a valid value. ⚠️ The installation
    then looks complete and identifies nobody.
    """
    touched = 0
    for dp, dn, fn in os.walk(MENTE):
        # ⚠️ `cache/` is excluded from most walks because it holds runtime
        # state — ⛔ but its README ships as engine doctrine and carries the
        # same placeholders. Excluding the folder left exactly one document in
        # the tree still reading `Owner: {{owner}}` after a complete install.
        # ⭐ Only the blueprints are skipped: a filled template would stop being
        # a blueprint, and the next --force would stamp somebody's name.
        dn[:] = [d for d in dn if d not in {".git", "__pycache__", "templates"}]
        for n in fn:
            if not n.endswith((".md", ".tsv", ".yml")):
                continue
            p = os.path.join(dp, n)
            try:
                text = open(p, encoding="utf-8", errors="replace").read()
            except OSError:
                continue          # ⬜ counted below as untouched, never as done
            new = substitute(text, values)
            if new == text:
                continue
            touched += 1
            if not dry:
                try:
                    write(p, new)
                except OSError:
                    touched -= 1
    return touched


# 🔴 THE STARTUP GOES IN THE FILE THAT IS ACTUALLY LOADED, measured 2026-09-07.
# The engine's startup lived behind `@Mente/CLAUDE-MENTE-OS.md`, so the project's
# own CLAUDE.md was 136 bytes: two lines and an import. ⛔ An import is a
# pointer, not an instruction that runs — the assistant reached the first turn
# never having been told to read RESUME, check for an open block, or how to end
# a session. The owner said it exactly: "it is installed, it uses it now and
# then, but it has not READ how it must behave or where to begin."
# ⭐ The instance that DOES work (measured on a mature one) carries the startup
# INSIDE its CLAUDE.md — 8.5 KB, loaded by the host on its own. That is the
# whole difference: the same words, one hop closer.
# ⚠️ Kept short on purpose. Everything that is not needed on turn one stays
# behind the import; what is here is what decides the first move.
STARTUP_BLOCK = """<!-- Mente OS · added by Mente/bin/init. Safe to delete this
     whole block if you remove the Mente/ folder. -->

## 🚀 STARTUP — do this before the first answer, without being asked

1. **READ FIRST** `Mente/memory/RESUME.md` — where we left off and the next
   step. ⭐ In most sessions it is all you need.
2. **Is a piece of work open?** `Mente/work/blocks/active/*/BLOCK.md` — if one
   is, load its `§A-E` and work INSIDE its `§B` boundary. ⛔ If `§A-E` is not
   enough, say so — do not infer.
3. ⛔ **Nothing is written outside an open block.** A gate refuses it. Ask them
   what the work is, open a block, and ask THEM what it may and may not touch.
4. **The deliverable lives in the block's own folder**, never in a new folder at
   the repository root — ⚠️ measured: a run invented `docs/` and the work was
   invisible to every check.

## ⌨️ What they can ask for, in their words

| They say | You run |
|---|---|
| *"is Mente OS on?"* | `Mente/bin/status` |
| *"turn it off"* / *"turn it back on"* | `Mente/bin/off` · `Mente/bin/on` — ⛔ deletes nothing |
| *"where were we?"* / *"what's pending?"* | read `RESUME.md` · `PENDING.md` |
| ⭐ *"let's close the session"* | `/session-wrap` — **before** the conversation resets |
| before `/clear` | `Mente/bin/check-clear-ready` — ⛔ it refuses if something would be lost |

⚠️ **Say the session-close one out loud once.** ⛔ It is the only habit whose
cost is invisible until too late: the files survive a reset, the reasoning does
not.

## 🗣️ How to answer

⭐ The voice is `Mente OS` (`.claude/output-styles/`) and it is already selected.
🔴 Measured 2026-09-07: an assistant installed it, read it, and kept answering
in its own — a style placed but not obeyed is the same document nobody read.

📖 The rest — the pieces, the gates, the contracts — is in
"""
def wire_import(dry):
    """③ Append the router import to the user's own CLAUDE.md.

    ⭐ APPEND, NEVER OVERWRITE. That single line is the only thing this system
    writes outside its own folder, and the file it writes into is the user's.
    ⛔ Overwriting it would destroy rules they already had, and the loss would
    be invisible — the file would still be there, still be read, and be wrong.
    """
    target = os.path.join(REPO, "CLAUDE.md")
    try:
        current = open(target, encoding="utf-8", errors="replace").read()
    except OSError:
        current = None
    if current is not None and IMPORT_LINE in current:
        return "already imported"
    if dry:
        return "would append the startup block and the import"
    try:
        # ⚠️ newline="" here too: this appends to the user's OWN CLAUDE.md,
        # so a translated line ending would show up as a change in THEIR
        # repository, not ours. ⛔ The one line this engine writes outside
        # its folder is the last one that should look like a diff.
        with open(target, "a", encoding="utf-8", newline="") as fh:
            if current:
                fh.write("\n")
            # ⭐ THE LINE SAYS WHERE IT CAME FROM AND HOW TO UNDO IT. 🔴 Measured
            # 2026-09-02: someone deleted the Mente/ folder, started again, and
            # their assistant behaved as if a half-finished install were still
            # there — because this line survived, pointing at a file that was
            # gone. ⛔ A bare `@Mente/...` explains nothing to whoever finds it,
            # and an unexplained leftover reads as memory the machine should
            # not have.
            fh.write(STARTUP_BLOCK)
            fh.write("%s\n" % IMPORT_LINE)
    except OSError as e:
        return "⚠️ could not write CLAUDE.md (%s)" % e.__class__.__name__
    return "created" if current is None else "appended"


def wire_gates(dry):
    """③b Install the gate wiring for Claude Code — ⛔ only if there is none.

    🔴 THE FAILURE THAT MADE THIS A STEP. `.claude/settings.json` used to SHIP
    inside this repository, which meant a `git clone` alone wired five gates
    into somebody's assistant — before `bin/init`, before they had agreed to
    anything. ⚠️ Measured 2026-09-02: a reviewer cloned the repo to READ the
    code, and the handoff gate started refusing their own subagents. They were
    right to call it aggressive: nobody had asked them.

    ⭐ Same doctrine as the CLAUDE.md router above: written only at install,
    ⛔ never over a file that already exists. Two settings files at the same
    level do not merge — one wins and silently drops the other's rules — so an
    existing configuration is left alone and the person is told to merge.

    ⚠️ The template says `python3`, which is NOT a command on most Windows
    installs. The interpreter running this very script is, so it is stamped in.
    """
    src = os.path.join(TEMPLATES, "claude-settings.json.template")
    dest = os.path.join(REPO, ".claude", "settings.json")
    if not os.path.exists(src):
        return "⬜ no template · gates NOT wired"
    if os.path.exists(dest):
        # ⬜ NOT a pass and NOT a failure: their file stands, and the gates
        # this engine ships are simply not active until they merge it.
        return ("⬜ .claude/settings.json already exists · left untouched · "
                "⚠️ the gates are NOT active — merge `hooks` from %s"
                % plat.rel(src, REPO))
    if dry:
        return "would wire the gates into .claude/settings.json"
    unverified = ""
    try:
        body = open(src, encoding="utf-8").read()
        # 🔴 AN INTERPRETER THAT WAS SEEN TO RUN, never one that merely exists.
        # Measured 2026-09-07: `sys.executable` was a Microsoft Store execution
        # alias — a 2-byte stub that a terminal can start and a hook cannot —
        # so every gate was stamped with it and NOT ONE ever ran. ⚠️ The file
        # was there; `Mente/.beats/` never was.
        py = plat.python()
        sh = plat.bash()
        if not py:
            # ⬜ CHK-CAU-003 · said out loud. ⛔ Stamping a guess here buys a
            # settings file that looks wired and protects nothing.
            return ("⬜ gates NOT wired · no working python found · "
                    "⚠️ install one, then re-run bin/init --force")
        # 🔴 THE INTERPRETER KEEPS ITS OWN QUOTES, measured 2026-09-07 on a
        # real Windows install. This used to strip the closing quote with
        # `[:-1]` so the path would run on into the script argument — which
        # works until the path has a SPACE in it. `C:\Program Files\Git\bin\
        # bash.exe` then arrived as an unterminated quote, the shell split it,
        # and the session hook died with `C:Program: command not found`.
        # ⛔ Not one beat from `session-start` on that machine, so RESUME.md
        # was never written — and the memory the whole system rests on stayed
        # the shipped template.
        # ⭐ The interpreter is quoted INSIDE the JSON string, not around it.
        # ⚠️ The value is already `"bash \"$DIR/x.sh\""` — a JSON string whose
        # content is a shell command. So the path needs shell quotes, escaped
        # for JSON, and the surrounding JSON quote stays where it was.
        # 🔴 Measured while fixing this: quoting it as a JSON value instead
        # produced `"/usr/bin/bash" \"...\""` — a settings file that no longer
        # parses at all, which is worse than the broken path it replaced.
        def _cmd(argv):
            inner = " ".join(a.replace("\\", "\\\\").replace('"', '\\"')
                             for a in argv)
            return '"\\"%s\\" ' % inner if " " in inner else '"%s ' % inner
        body = body.replace('"python3 ', _cmd(py))
        if sh:
            body = body.replace('"bash ', _cmd(sh))
        else:
            unverified = " · ⬜ bash NOT verified · the session hook may not run"
        os.makedirs(os.path.dirname(dest), exist_ok=True)
        write(dest, body)
    except (OSError, ValueError) as e:
        return "⚠️ could not wire the gates (%s)" % e.__class__.__name__
    return "wired into .claude/settings.json" + unverified


def install_voice(dry):
    """③d Place the output style, and SELECT it — both, or neither counts.

    🔴 THE FAILURE, measured 2026-09-06 on a real installation. The engine ships
    `memory/principles/owner-0-voice.md` — the whole doctrine of how it speaks —
    and NOTHING read it. Zero mentions of `outputStyle` in this installer and in
    the settings template, so a fresh install answered in the assistant's
    default voice while carrying 264 lines describing another one. ⛔ The owner
    said it plainly: "the way of answering is not active".

    ⚠️ TWO WRITES, and one without the other is nothing: the file gives the host
    something to load, the setting is what makes it load. ⭐ A style placed and
    not selected is the same document nobody reads, one folder further along.

    ⛔ Never over an existing style of theirs, and ⛔ never over an
    `outputStyle` they already chose — that is their voice, not ours.
    """
    src_root = os.path.join(TEMPLATES, "output-styles")
    if not os.path.isdir(src_root):
        return None
    out, placed = [], []
    for name in sorted(os.listdir(src_root)):
        if not name.endswith(".md" + SUFFIX):
            # ⬜ CHK-CAU-003 · said out loud, never swallowed.
            out.append("⬜ %s is not a style template · NOT installed" % name)
            continue
        stem = name[:-len(SUFFIX)]
        dest = os.path.join(REPO, ".claude", "output-styles", stem)
        if os.path.exists(dest):
            out.append("⬜ %s already there · left untouched" % stem)
            continue
        if dry:
            placed.append(stem)
            continue
        try:
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            write(dest, open(os.path.join(src_root, name),
                             encoding="utf-8").read())
            placed.append(stem)
        except OSError as e:
            return "⚠️ could not place the voice (%s)" % e.__class__.__name__
    if placed:
        out.append("%s %s" % ("would place" if dry else "placed",
                              ", ".join(placed)))

    # ── ⭐ AND SELECT IT · the half that makes the other half real ──────────
    cfg = os.path.join(REPO, ".claude", "settings.json")
    if dry:
        out.append("would select it as the output style")
        return "voice (Claude Code): " + " · ".join(out)
    try:
        data = {}
        if os.path.isfile(cfg):
            data = json.loads(open(cfg, encoding="utf-8").read())
        if not isinstance(data, dict):
            # ⬜ Their file, in a shape this cannot merge into. Say so.
            out.append("⬜ settings.json is not an object · NOT selected")
            return "voice (Claude Code): " + " · ".join(out)
        if data.get("outputStyle"):
            out.append("⬜ an output style is already chosen · left untouched")
            return "voice (Claude Code): " + " · ".join(out)
        data["outputStyle"] = "Mente OS"
        os.makedirs(os.path.dirname(cfg), exist_ok=True)
        write(cfg, json.dumps(data, indent=2, ensure_ascii=False) + "\n")
        out.append("selected")
    except (OSError, ValueError) as e:
        out.append("⚠️ could not select it (%s)" % e.__class__.__name__)
    return "voice (Claude Code): " + " · ".join(out)


def install_skills(dry):
    """③c Place the assistant skills this engine ships — ⛔ only where there is none.

    🔴 THE FAILURE THAT MADE THIS A STEP, and it is the same one `.claude/
    settings.json` already taught: the skill used to SHIP ACTIVE inside the
    repository. A `git clone` alone loaded it into somebody's assistant, before
    `bin/init`, before they had agreed to anything.

    ⚠️ AND IT BROKE ISOLATION, which is worse. Measured 2026-09-06: the owner
    keeps several installations, and every clone carried the same skill — so N
    installations meant N copies of one skill all writing into the SAME shared
    folder. ⛔ Deleting an installation did not remove what its skill had
    written outside it. An engine that promises "delete the folder and it is
    gone" cannot ship a file that outlives the folder.

    ⭐ Same doctrine as the router and the gates: written only at install, ⛔
    never over a file that already exists. A skill of theirs with the same name
    is theirs, and this step says so rather than replacing it.
    """
    src_root = os.path.join(TEMPLATES, "skills")
    if not os.path.isdir(src_root):
        return None
    placed, kept = [], []
    for name in sorted(os.listdir(src_root)):
        src = os.path.join(src_root, name, "SKILL.md.template")
        if not os.path.isfile(src):
            # ⬜ CHK-CAU-003 · said out loud. A folder under templates/skills/
            # with no SKILL.md.template is a skill that will never be installed,
            # and skipping it in silence is how it stays missing.
            kept.append("⬜ %s has no SKILL.md.template · NOT installed" % name)
            continue
        dest = os.path.join(REPO, ".claude", "skills", name, "SKILL.md")
        if os.path.exists(dest):
            kept.append(name)
            continue
        if dry:
            placed.append(name)
            continue
        try:
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            write(dest, open(src, encoding="utf-8").read())
            placed.append(name)
        except OSError as e:
            return "⚠️ could not install skills (%s)" % e.__class__.__name__
    if not placed and not kept:
        return None
    out = []
    if placed:
        out.append("%s %s" % ("would install" if dry else "installed",
                              ", ".join(placed)))
    if kept:
        # ⬜ Their file stands. Not a pass and not a failure.
        out.append("⬜ %s already there · left untouched" % ", ".join(kept))
    return "skills (Claude Code): " + " · ".join(out)


def declare_registry(dry, wired):
    """③c Record, in the instance config, WHERE the gates were wired.

    🔴 THE GAP THIS CLOSES, measured 2026-09-05 on a fresh clone: ③b writes
    `.claude/settings.json` and the gates run — but `hooks.registry` stayed
    `null`, so `bin/check-health` reported the hook wiring as
    ⬜ NOT MEASURED on every new installation. The engine knew the path it had
    just written to and did not say so, which leaves the one guard that watches
    the guards permanently blind on a tree nobody has hand-edited.

    ⛔ Declared only when ③b ACTUALLY wired the file. If their own settings
    were left untouched, this engine did not put the gates there and must not
    claim a registry it did not create — a wrong path here is worse than null,
    because null reports NOT MEASURED while a wrong path reports a red.
    """
    cfg = os.path.join(MENTE, "mente.config.yml")
    if not wired.startswith("wired") and not wired.startswith("would wire"):
        return None                     # ⬜ their file stands · nothing to declare
    if not os.path.isfile(cfg):
        return None
    # ⭐ Relative to the REPOSITORY, not to Mente/ — that is where
    # `bin/check-health` resolves it from (`dirname(ROOT)`). ⛔ Not absolute:
    # an absolute path is this machine's, and the config is the instance's.
    rel = plat.rel(os.path.join(REPO, ".claude", "settings.json"), REPO)
    if dry:
        return "would declare hooks.registry"
    try:
        text = open(cfg, encoding="utf-8").read()
        # ⭐ Only the null default is replaced. An owner who already pointed this
        # somewhere is answering for their own host, and ⛔ this step never
        # overwrites an answer a person gave.
        pat = r"(?m)^(hooks:\n(?:[ \t]*#.*\n)*[ \t]*registry:)[ \t]*null[ \t]*$"
        new = re.sub(pat, lambda m: m.group(1) + ' "%s"' % rel, text, count=1)
        if new == text:
            return None
        write(cfg, new)
    except OSError as e:
        return "⚠️ could not declare hooks.registry (%s)" % e.__class__.__name__
    return "hooks.registry → %s" % rel


def wire_hook(dry, name="pre-push"):
    """④ Link the layer that cannot be walked around.

    🔴 A HOOK FILE THAT IS NOT LINKED NEVER RUNS, and looks installed. Git
    cannot carry the link, so nothing but this step can create it — and until
    it exists the only defence left is the layer a pattern over command text
    can be walked past.
    """
    src = os.path.join(MENTE, "hooks", "%s.sh" % name)
    hooks = os.path.join(REPO, ".git", "hooks")
    if not os.path.exists(src):
        return "⬜ no %s.sh to link" % name
    if not os.path.isdir(hooks):
        return "⬜ not a git repository — %s not wired" % name
    link = os.path.join(hooks, name)
    if os.path.exists(link):
        return ("already wired"
                if os.path.realpath(link) == os.path.realpath(src)
                else "⚠️ .git/hooks/%s points elsewhere — left untouched" % name)
    if dry:
        return "would link %s" % name
    # ⭐ A SYMLINK IS THE PREFERRED SHAPE, NOT THE ONLY ONE. 🔴 Measured on
    # Windows 2026-09-02: os.symlink needs SeCreateSymbolicLinkPrivilege, which
    # a normal account does not have unless Developer Mode is on — so init
    # reported "⚠️ could not link" and BOTH git hooks silently did not exist.
    # ⛔ The user then faced a choice about OUR platform gap, which is not a
    # decision a user should ever be handed.
    # ⭐ A git hook only has to be an executable file. When the link is refused,
    # a two-line launcher does the same job on every system.
    try:
        os.symlink(os.path.relpath(src, hooks), link)
        return "wired"
    except (OSError, NotImplementedError, AttributeError):
        pass
    try:
        with open(link, "w", encoding="utf-8", newline="\n") as fh:
            fh.write('#!/usr/bin/env bash\n'
                     '# ⭐ Written by bin/init because this system refused a\n'
                     '# symlink (Windows without Developer Mode). It runs the\n'
                     '# same hook — the shape differs, the behaviour does not.\n'
                     'exec "$(dirname "$0")/%s" "$@"\n'
                     % os.path.relpath(src, hooks).replace(os.sep, "/"))
        os.chmod(link, 0o755)
    except OSError as e:
        return "⚠️ could not wire (%s)" % e.__class__.__name__
    return "wired (launcher — this system refused a symlink)"


def harden(dry):
    """④ Make the credential folder private.

    ⚠️ Git stores only the executable bit, so a cloned secrets/ arrives at
    whatever the umask gives. ⭐ Only TIGHTENS: an owner who hardened it further
    made a decision this step knows nothing about.
    """
    d = os.path.join(MENTE, "secrets")
    if not os.path.isdir(d):
        return None

    # 🔴 NEVER ANNOUNCE A PROTECTION THAT WAS NOT APPLIED. Measured on Windows
    # 2026-09-02: this printed `secrets/ 777 → 700` and the folder stayed open
    # to every account on the machine — os.chmod on an NTFS directory is
    # accepted and does nothing. ⛔ The owner was told their credential store
    # was private. A false assurance is worse than none: it ends the question.
    # ⚠️ ASKED ABOUT THIS FOLDER, not about the OS. 🔴 Measured 2026-09-05: from
    # a POSIX kernel over an NTFS mount the pathless call answered "yes, modes
    # are real", so this went on to chmod and then reported a red the owner
    # could never clear. ⭐ The folder being hardened is the one that decides.
    if not plat.modes_are_real(d):
        return ("⬜ secrets/ · NOT MEASURED · this platform does not enforce "
                "file modes · ⚠️ keep credentials out of a shared or synced "
                "folder — the engine cannot make this one private for you")

    mode = stat.S_IMODE(os.stat(d).st_mode)
    if not mode & 0o077:
        return None
    if dry:
        return "would tighten secrets/ from %o to 700" % mode
    try:
        os.chmod(d, mode & 0o700)
    except OSError as e:
        return "⚠️ could not tighten secrets/ (%s)" % e.__class__.__name__

    # ⭐ SAY WHAT IS TRUE AFTER, NOT WHAT WAS ASKED FOR. Re-reading the mode is
    # the difference between reporting an action and reporting a result — and
    # the Windows failure was exactly a call that succeeded and changed nothing.
    after = stat.S_IMODE(os.stat(d).st_mode)
    if after & 0o077:
        return ("🔴 secrets/ is still %o · the change was accepted and did NOT "
                "take effect · ⚠️ do not keep credentials here until it does"
                % after)
    return "secrets/ %o → %o" % (mode, after)


def surroundings():
    """⑤ What is AROUND this installation that changes what it means.

    🔴 BOTH MEASURED ON ONE REAL WINDOWS MACHINE, 2026-09-05. Neither is a
    fault in the clone, and neither can be fixed by the engine — ⛔ which is
    exactly why they must be SAID. A person who is told can move the folder in
    ten seconds; a person who is not finds out when it costs something.

    ⚠️ These are warnings, never refusals. Refusing somebody's own filesystem
    layout is not this installer's call.
    """
    out = []

    # ── AN OUTER REPOSITORY ────────────────────────────────────────────────
    # 🔴 Somebody had run `git init` in C:\Users\<user>, so the whole profile
    # was one repository. ⛔ Two consequences, and the second is the dangerous
    # one: the git hooks land in the OUTER .git/hooks and govern every project
    # under it, and a stray `git add .` there stages the person's entire home.
    try:
        r = subprocess.run(("git", "rev-parse", "--show-toplevel"), cwd=REPO,
                           capture_output=True, text=True, timeout=10)
        top = r.stdout.strip()
    except (OSError, subprocess.SubprocessError) as e:
        # ⬜ CHK-CAU-003 · said out loud. Not knowing is not the same as fine.
        out.append("⬜ NOT MEASURED · could not ask git where this repository "
                   "starts (%s) · whether an outer repository governs this "
                   "folder was NOT checked" % e.__class__.__name__)
        top = ""
    if top and os.path.normcase(os.path.realpath(top)) != os.path.normcase(
            os.path.realpath(REPO)):
        out.append("🔴 an OUTER git repository governs this folder: %s\n"
                   "   ⛔ The git hooks would land in ITS .git/hooks and apply "
                   "to everything under it,\n"
                   "   not just this install. ⚠️ If that is not deliberate, "
                   "move this folder outside it\n"
                   "   — or run `git init` here first so this clone owns its "
                   "own history." % top)

    # ── A SYNCED FOLDER ────────────────────────────────────────────────────
    # ⚠️ The engine already says "keep credentials out of a shared or synced
    # folder". 🔴 On the measured machine it was already IN one and said
    # nothing — a generic caution where a specific one was available.
    SYNCED = ("onedrive", "dropbox", "google drive", "googledrive", "icloud",
              "nextcloud", "pcloud", "sync.com", "box sync", "mega")
    low = REPO.replace("\\", "/").lower()
    hit = next((n for n in SYNCED if "/" + n in low or low.startswith(n)), None)
    if hit:
        out.append("⚠️  this folder is inside a SYNCED drive (%s)\n"
                   "   ⛔ Whatever lands in secrets/ is uploaded to that "
                   "service and shared with every\n"
                   "   device on the account. ⭐ On a platform that does not "
                   "enforce file modes, the engine\n"
                   "   cannot make that folder private for you — "
                   "keep credentials somewhere else." % hit.title())
    return out


def main():
    force = "--force" in sys.argv
    dry = "--dry-run" in sys.argv
    owner = None
    if "--owner" in sys.argv:
        i = sys.argv.index("--owner")
        owner = sys.argv[i + 1] if i + 1 < len(sys.argv) else None

    if not os.path.isdir(TEMPLATES):
        die("no templates/ — this clone has nothing to install from")
    if not os.path.exists(TABLE):
        die("no pieces.tsv — nothing declares where the pieces live")

    # ⭐ SAID BEFORE ANYTHING IS WRITTEN. A warning that arrives after the hooks
    # are wired is a warning about a decision already taken.
    for w in surroundings():
        print("   %s" % w, file=sys.stderr)

    items, unresolved = plan()
    if unresolved:
        die("%d template(s) declare no destination: %s\n"
            "   ⛔ A blueprint nothing stamps is a file the install silently "
            "leaves out.\n"
            "   Declare its destination in pieces.tsv."
            % (len(unresolved), ", ".join(unresolved)))

    # ⭐ Asked ONLY when it cannot be found, and after the plan is known: no
    # question is worth asking if the install would fail anyway.
    if owner is None:
        owner = ask("Owner name (how you are referred to in the docs): ")
    values = {"owner": owner,
              # ⭐ Derived, never asked: the directory already answers it, and a
              # question whose answer is on screen trains people to hit enter.
              "project": os.path.basename(REPO) or "project",
              "date": date.today().isoformat()}

    wrote, kept = [], []
    for src, dest in items:
        rel = plat.rel(dest, MENTE)
        if os.path.exists(dest) and not force:
            kept.append(rel)
            continue
        if dry:
            wrote.append(rel)
            continue
        try:
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            body = strip_scaffold(
                substitute(open(src, encoding="utf-8").read(), values))
            write(dest, body)
            shutil.copymode(src, dest)
            wrote.append(rel)
        except OSError as e:
            die("could not write %s · %s" % (rel, e.__class__.__name__))

    filled = fill_engine(values, dry)
    imported = wire_import(dry)
    gated = wire_gates(dry)
    # ⭐ BOTH git hooks, not one. ⛔ pre-commit.sh shipped implementing
    # SHP-LCK-001 — the rule that refuses a commit on the base branch — and
    # nothing installed it: a hook file that is not linked never runs and looks
    # installed, which is the failure this whole step exists for.
    hooked = wire_hook(dry)
    hooked_commit = wire_hook(dry, "pre-commit")
    # ⭐ After ③b: same doctrine, same place — the repository's own .claude/.
    skilled = install_skills(dry)
    # ⭐ AFTER ③b too, and for the same reason: it edits the file ③b writes.
    # ⚠️ Order matters — selecting a style before the settings file exists
    # would create a second one beside it, and two files at the same level do
    # not merge: the one that wins silently drops the other's rules.
    voiced = install_voice(dry)
    # ⭐ After ③b, because it records where ③b actually wrote.
    declared = declare_registry(dry, gated)
    tightened = harden(dry)

    head = "🔎 dry run — nothing was written\n" if dry else ""
    print("%s%s %d file(s) %s · %d kept · %d document(s) filled in"
          % (head, "🤖", len(wrote), "would be written" if dry else "written",
             len(kept), filled))
    for r in wrote:
        print("   + %s" % r)
    if kept:
        # ⛔ Named, never counted in silence: a file that was NOT written is the
        # one thing a second run must be explicit about, or the person believes
        # they just reinstalled and they did not.
        print("   ⬜ kept (already there — use --force to replace): %s"
              % ", ".join(kept))
    print("   · router import: %s" % imported)
    print("   · gates (Claude Code): %s" % gated)
    print("   · layer 2 hook (pre-push):  %s" % hooked)
    print("   · base-branch hook (pre-commit): %s" % hooked_commit)
    if skilled:
        print("   · %s" % skilled)
    if voiced:
        print("   · %s" % voiced)
    if declared:
        print("   · %s" % declared)
    if tightened:
        print("   · %s" % tightened)
    if not dry:
        print("\n👉 next: bin/check-health · bin/probes/run-all.py")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except SystemExit:
        raise
    except Exception as e:                                     # noqa: BLE001
        print("🔴 %s crashed · %s: %s"
              % (os.path.basename(__file__), type(e).__name__, e),
              file=sys.stderr)
        sys.exit(2)
