#!/usr/bin/env python3
"""check-document — enforces the 🔒 rows of rules/contract-document.md

Every rule it checks names the contract ID it comes from, so a failure is
actionable without opening the code.

Exit: 0 clean · 1 violations · 2 the contract itself is missing
"""
import os, re, sys
from datetime import date

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
CONTRACT = os.path.join(ROOT, "rules", "contract-document.md")

STATUSES = {"draft", "current", "superseded", "fossil"}

# DOC-SIZ-001 · the ceiling table of contract-document §3.
# Read from the contract itself, never duplicated here — a copy would diverge.
FALLBACK_CEILINGS = {}

SKIP_DIRS = {".git", "__pycache__", "node_modules", ".venv", "cache"}
SKIP_NAMES = {"CHANGELOG.md"}
# ⛔ A decision record is NOT a document in this contract's sense: it carries
# `date/status/decided-by`, never `Status/Type/Updated/Owner`, and its shape is
# governed by contract-adr.md with its own validator. Measured: the first
# record the engine shipped was rejected here for missing a header its own
# contract never asks for. ⭐ One shape, one contract — the same boundary that
# keeps check-decisions on its own reader.
SKIP_DIR_PATHS = {"rules/decisions"}

# ⭐ SHAPES ANOTHER CONTRACT OWNS, with its own validator. A block declares its
# identity in §A — id, type, intent, status, lane, owner, dates — and
# contract-block measures every one of those fields. ⛔ Demanding the four-field
# document header ON TOP is a second contract for one file: the two would
# disagree, and the block would be simultaneously valid and invalid.
# 🔴 Measured end to end: a freshly scaffolded block passed check-block and
# failed check-document, on creation, with nothing wrong with it.
# ⚠️ By FILENAME, not by folder: blocks live under active/, blocked/ and
# archive/, and a folder list would miss whichever state was added later.
# ⚠️ A campaign declares its identity as FIELDS too, and contract-campaign
# measures every one — same reasoning, same exemption.
OWNED_ELSEWHERE = {"BLOCK.md", "CAMPAIGN.md"}

# DOC-CNT-005 · a credential shape. ⛔ `-p` is deliberately absent: a
# one-letter flag matched a directory name in a real file (rule-config-hygiene §2).
CREDENTIAL = re.compile(
    r"(?:--password|--token|--secret|--api[_-]?key)[= ]+['\"]?(?!\$|<|\.\.\.)"
    r"[A-Za-z0-9!@#$%^&*_+./-]{8,}"
    r"|\b(?:password|passwd|api[_-]?key|secret|token)\s*[:=]\s*"
    r"['\"](?!\$|<|\.\.\.|⬜)[^'\"]{8,}['\"]"
    r"|\b(?:sk|pk|ghp|xox[bap])[-_][A-Za-z0-9]{16,}", re.I)
# ⭐ A placeholder is not a credential. Without this the rule fires on its own
# documentation — and a rule that cannot describe itself gets deleted, not obeyed.
EXAMPLE_SAFE = re.compile(r"⬜|<[^>]+>|\.\.\.|xxx+|your[-_]|example|placeholder|\$\{?\w",
                          re.I)

def stale_threshold():
    """⬜ How old a `current` document may be before it is stale. Read from the
    contract, never fixed here — and ⛔ if no threshold is declared, NOTHING is
    measured: the rule says so instead of inventing a number."""
    try:
        t = open(os.path.join(ROOT, "rules", "contract-document.md"),
                 encoding="utf-8", errors="replace").read()
    except OSError:
        return 0
    m = re.search(r"⬜ staleness threshold[^|]*\|\s*(\d+)", t)
    return int(m.group(1)) if m else 0


STALE_DAYS = stale_threshold()

HDR = re.compile(r"^\*\*(Status|Type|Updated|Owner):\*\*\s*(.+?)\s*(?:·|$)", re.M)
FIELD = re.compile(r"\*\*(Status|Type|Updated|Owner):\*\*\s*([^·\n]+)")
ISO = re.compile(r"^\d{4}-\d{2}-\d{2}$")
BIS = re.compile(r"^#{2,4}\s+\d+-(bis|ter|quater)\b", re.M | re.I)
BADNAME = re.compile(r"[_ ]|-(v\d+|final|new|old|copy)\.|^\d{4}-\d{2}-\d{2}-", re.I)
LIVENUM = re.compile(r"\b\d+\s*/\s*\d+\b|\b\d+\s+checks?\b", re.I)
# ⬜ before a pointer marks a piece the engine has not written yet: flagging it
# would report a promise as a defect, and noise is how a validator stops being read.
PLANNED = re.compile(r"⬜[^\n]{0,90}$")

# Names that denote a KIND of file, not one file: the instance creates them at
# install time, and a bare mention of one is not a pointer to anything.
# A checker that cannot tell "points at a file" from "names a type of file"
# reports every mention as broken — which is the loudest way to be ignored.
# ⭐ Names that denote a KIND of file the INSTANCE creates, never one the
# engine ships. ⛔ Hand-maintaining this list is the trap rule-config-hygiene
# names: a fixed list of what is fine is a hole with a schedule. So the
# instance-created half is DERIVED from templates/ — if a template exists, the
# file it produces is the instance's and a clean clone legitimately lacks it.
#
# Measured on a clean clone: seven documents cited `mente.config.yml` and
# `cuentas.tsv`, both correctly .gitignored as instance files, and the checker
# called all seven broken pointers. ⚠️ In the tree where it was written it
# reported zero — the files were there.
_SHAPES = {"BLOCK.md", "README.md", "SUMMARY.md", "connections.md",
           "CHANGELOG.md", "MEMORY.md", "VERSION"}


def _instance_files():
    """Every file an INSTALLATION produces rather than receives.

    ⭐ TWO SOURCES, both already declarative, and the second was missing:
      · templates/ — if a template produces it, an install produces it
      · .gitignore — ⛔ if it must not travel, a clone legitimately lacks it

    🔴 Found on a clean clone: the generated index, states, decisions and
    metrics files have no template — a generator writes them — so citing them
    was reported as a broken pointer in every clone, and only in a clone. ⚠️ The
    working tree had them, so the defect was invisible exactly where the work
    happens.
    ⭐ check-structure already derived its exemption from both; this one knew
    only half, and two pieces answering the same question differently is how one
    of them ends up wrong.
    """
    out = set()
    tdir = os.path.join(ROOT, "templates")
    if os.path.isdir(tdir):
        for n in os.listdir(tdir):
            if n.endswith(".template"):
                out.add(n[:-len(".template")])
    try:
        for line in open(os.path.join(ROOT, ".gitignore"),
                         encoding="utf-8", errors="replace"):
            line = line.split("#")[0].strip()
            if not line or line.startswith("!"):
                continue
            out.add(line.lstrip("/").rstrip("/*").split("/")[-1])
    except OSError:
        pass
    out.discard("")
    return out


GENERIC = _SHAPES | _instance_files()


def read_ceilings(text):
    """DOC-SIZ-001 · the ceilings live in the contract, and are read from it."""
    out = {}
    for line in text.splitlines():
        m = re.match(r"^\|\s*`([a-z-]+)`\s*\|\s*\*{0,2}(?:⭐\s*)?\*{0,2}(\d+|none)", line)
        if m:
            out[m.group(1)] = None if m.group(2) == "none" else int(m.group(2))
    return out


def check(path, rel, ceilings, quiet):
    bad = []
    try:
        text = open(path, encoding="utf-8").read()
    except Exception as e:
        return [("DOC-HDR-001", rel, 0, "unreadable: %s" % e)]
    lines = text.splitlines()
    head = "\n".join(lines[:12])
    f = dict(FIELD.findall(head))
    f = {k: v.strip() for k, v in f.items()}

    # DOC-HDR-001 · all four fields
    missing = [k for k in ("Status", "Type", "Updated", "Owner") if k not in f]
    if missing:
        bad.append(("DOC-HDR-001", rel, 1,
                    "header missing %s · expected: all four · got: %d of 4"
                    % (", ".join(missing), 4 - len(missing))))
        return bad  # nothing else can be judged without them

    st = f["Status"].strip("*` ")
    ty = f["Type"].strip("*` ")

    # DOC-HDR-002 · Status in the allowed set
    if st not in STATUSES:
        bad.append(("DOC-HDR-002", rel, 1,
                    "Status not allowed · expected one of %s · got: %r"
                    % ("|".join(sorted(STATUSES)), st)))

    # DOC-HDR-003 · Type declared in the contract's ceiling table
    if ceilings and ty not in ceilings:
        bad.append(("DOC-HDR-003", rel, 1,
                    "Type not in the contract's table · got: %r · "
                    "no ceiling can be applied" % ty))

    # DOC-HDR-004 · ISO date
    upd = f["Updated"].strip("*` ")
    if not ISO.match(upd) and "{{" not in upd:
        bad.append(("DOC-HDR-004", rel, 1,
                    "Updated not ISO · expected YYYY-MM-DD · got: %r" % upd))

    # DOC-HDR-005 · superseded names its replacement
    if st == "superseded" and "superseded by" not in text.lower():
        bad.append(("DOC-HDR-005", rel, 1,
                    "superseded with no replacement named · a dead end"))

    # DOC-SIZ-001 · the ceiling for its type
    cap = ceilings.get(ty)
    if cap and len(lines) > cap:
        # ⭐ DOC-SIZ-001 says a file over its ceiling owes a SPLIT, and that the
        # split is NAMED WORK rather than a warning. ⛔ Until now the rule only
        # printed that sentence — nothing checked the work was ever named, so
        # the honest answer and the ignored one looked identical.
        # ⬜ Where pending work is recorded is the installation's; the engine
        # fixes that it IS recorded, and that the record names this file.
        named = False
        for q in (os.path.join(ROOT, "docs", "ENGINE-BACKLOG.md"),
                  os.path.join(ROOT, "memory", "PENDIENTES.md")):
            try:
                if os.path.basename(rel) in open(q, encoding="utf-8",
                                                 errors="replace").read():
                    named = True
                    break
            except OSError:
                continue      # ⬜ no such record here · nothing to read
        if not named:
            bad.append(("DOC-SIZ-001", rel, len(lines),
                        "over its ceiling · type %s allows %d · got: %d · ⛔ and "
                        "the split is NOT named anywhere · a ceiling crossed "
                        "without recorded work is a limit that stopped being one"
                        % (ty, cap, len(lines))))

    # DOC-BOD-001 · Purpose and Related
    if not re.search(r"^#{2,3}.*\b(Purpose|WHAT THIS FILE IS|What (this|a|an) )\b", text, re.M | re.I):
        bad.append(("DOC-BOD-001", rel, 1, "no Purpose section"))
    if not re.search(r"^Related:", text, re.M):
        bad.append(("DOC-BOD-001", rel, len(lines), "no Related line"))

    # DOC-BOD-002 · no -bis / -ter / -quater numbering
    m = BIS.search(text)
    if m:
        ln = text[:m.start()].count("\n") + 1
        bad.append(("DOC-BOD-002", rel, ln,
                    "section numbered -bis/-ter/-quater · the split signal"))

    # DOC-CNT-002 · no live number in prose
    for i, line in enumerate(lines, 1):
        if line.lstrip().startswith(("|", ">", "```", "#")):
            continue
        m = LIVENUM.search(line)
        if m and "20" not in m.group(0):
            bad.append(("DOC-CNT-002", rel, i,
                        "live number in prose: %r · cite its source instead"
                        % m.group(0)))
            break

    # DOC-CNT-004 · a path must not merely carry a directory — it must RESOLVE.
    # A well-formed pointer to nothing reads as a promise.
    here = os.path.dirname(path)
    seen_refs = set()
    # ⭐ TWO SHAPES, because an extension is not what makes a pointer.
    #   · a filename with a known extension, anywhere
    #   · ⛔ a path INTO an engine folder with no extension at all — every
    #     `bin/check-x` reference. Measured: 170 of those in this tree, none of
    #     them checked, and 24 resolved to nothing. Among them QUICKSTART.md —
    #     the first file a newcomer reads — naming six commands of which one
    #     existed, and a validator's own README documenting a module import
    #     that was never written.
    # ⚠️ Restricted to the engine's own folder names on purpose: a bare `a/b`
    # could be anything, and a checker that guesses reports prose as a defect.
    POINTER = re.compile(
        r"`([A-Za-z0-9_][A-Za-z0-9_./-]*\.(?:md|template|tsv|yml|py|sh))`"
        r"|`((?:bin|hooks|rules|templates|docs|work|memory|Cerebro|connection"
        r"|secrets|cache)/[A-Za-z0-9_./-]+)`")
    for m in POINTER.finditer(text):
        ref = (m.group(1) or m.group(2)).rstrip("/")
        if os.path.basename(ref) == ref and ref in _SHAPES:
            continue          # a kind of file, not a pointer to one
        # ⭐ An INSTANCE file stays an instance file when cited with its path.
        # ⛔ Requiring a bare name conflated two different exemptions: "this
        # names a type" and "this names a file the installation creates".
        # Measured on a clean clone: `Mente/cuentas.tsv` was reported broken
        # while the bare `cuentas.tsv` was not, for the same missing file.
        if os.path.basename(ref) in _instance_files():
            continue
        if any(os.path.exists(os.path.join(b, ref))
               for b in (here, ROOT, os.path.join(here, ".."),
                         os.path.join(here, "../.."), os.path.join(here, "../../.."))):
            continue
        if PLANNED.search(text[max(0, m.start() - 90):m.start()]):
            continue          # ⬜ marks a piece the engine has not written yet
        # ⭐ A CONTRAST REFERENCE names where something ELSE belongs — "that is
        # `docs/plans/`", "not here, that is X". ⛔ It is a destination an
        # installation may create, not a claim that a file is there, and
        # reporting it would push writers to stop drawing the line at all.
        # ⚠️ Recognised by the FOLDER form (a trailing slash) plus the phrasing
        # that precedes it, never by the path alone.
        if ref.endswith("/") or m.group(0).endswith("/`"):
            lead = text[max(0, m.start() - 60):m.start()].lower()
            if re.search(r"that is|belongs in|goes in|not here|instead|against",
                         lead):
                continue
        ln = text[:m.start()].count("\n") + 1
        # ⚠️ Deduplicated rather than stopped. The first version broke after
        # one finding per file, so a document with six broken pointers reported
        # one and looked almost right — ⛔ and the five behind it were invisible
        # until the first was fixed, which is how a fix reveals more work
        # instead of finishing it.
        if ref in seen_refs:
            continue
        seen_refs.add(ref)
        bad.append(("DOC-CNT-004", rel, ln,
                    "pointer does not resolve: %r · expected a path readable from "
                    "here or from the root · a pointer to nothing reads as a promise"
                    % ref))

    # DOC-IDS-001 · an id is an ADDRESS. ⛔ Two rows sharing one id means a
    # citation resolves to whichever the reader finds first, and both rules
    # look correct in isolation. ⚠️ Measured: a contract carried the same id
    # twice after a rule was added beside an existing one, and nothing said so.
    seen_ids = {}
    for i, line in enumerate(text.split("\n"), 1):
        m = re.match(r"\|\s*`([A-Z]{3}-[A-Z]+-\d+)`\s*\|", line)
        if not m:
            continue
        if m.group(1) in seen_ids:
            bad.append(("DOC-IDS-001", rel, i,
                        "id %s is used twice (also line %d) · ⭐ an id is an "
                        "ADDRESS: two rows sharing one means a citation "
                        "resolves to whichever is found first, and both rules "
                        "read as correct alone" % (m.group(1), seen_ids[m.group(1)])))
            break
        seen_ids[m.group(1)] = i

    # DOC-CNT-005 · no credential, not even as an example. ⛔ What is written
    # into a document stays in history: purging the file does not un-publish it.
    for i, line in enumerate(text.split("\n"), 1):
        m = CREDENTIAL.search(line)
        if m and not EXAMPLE_SAFE.search(line):
            bad.append(("DOC-CNT-005", rel, i,
                        "credential-shaped value: %r · a document is not the "
                        "place, not even as an example — what is written stays "
                        "in history, and the answer is ROTATION, not deletion"
                        % m.group(0)[:40]))
            break

    # DOC-NAM-007 · a filename never names a person. ⭐ It outlives whoever
    # installed the system, and a person's name in a path is a permanent label.
    stem = os.path.basename(rel).rsplit(".", 1)[0]
    owner = (f.get("Owner") or "").strip().strip("*`").lower()
    if owner and owner not in ("", "—", "-") and not owner.startswith("⬜"):
        first = re.split(r"[\s,·]", owner)[0]
        if len(first) > 2 and re.search(r"(^|-)%s(-|$)" % re.escape(first),
                                        stem, re.I):
            bad.append(("DOC-NAM-007", rel, 1,
                        "the filename names a person (%r) · name the subject, "
                        "not who owns it — the file outlives whoever installed "
                        "the system, and the owner already lives in the header"
                        % first))

    # DOC-LIF-001 · `current` with an old `Updated` is stale, not current.
    # ⬜ The threshold is the installation's: read from §5 of the contract, so
    # raising it is a documented act. ⛔ Without a declared threshold nothing is
    # measured — and this rule says so rather than inventing a number.
    if f.get("Status", "").strip().lower() == "current" and STALE_DAYS:
        d = (f.get("Updated") or "").strip()
        if re.fullmatch(r"\d{4}-\d{2}-\d{2}", d):
            age = (date.today() - date.fromisoformat(d)).days
            if age > STALE_DAYS:
                bad.append(("DOC-LIF-001", rel, 1,
                            "declares `current` and was last updated %d days "
                            "ago (threshold %d) · re-verify it or restate what "
                            "changed — a stale `current` is worse than no "
                            "status, because it is believed"
                            % (age, STALE_DAYS)))

    # DOC-AUT-002 · a generated document is overwritten by its generator
    m_auth = re.search(r"\*\*Authority:\*\*\s*([^\n·]+)", head)
    auth = (m_auth.group(1).strip("*` ").lower() if m_auth else "")
    # Search the BODY, not the header: the header holds the declaration itself,
    # so a check that reads it finds its own field and always passes. A rule that
    # satisfies itself is the purest form of a check that cannot fail.
    body = text[len(head):]
    if auth == "generated" and not re.search(
            r"do not edit|never written|never edited|regenerat", body, re.I):
        bad.append(("DOC-AUT-002", rel, 1,
                    "declares Authority: generated but does not say so in its body · "
                    "a hand edit here disappears at the next run, with no error"))

    # DOC-OPS-001 · a supersede link points both ways
    m = re.search(r"\*\*Supersedes?:\*\*\s*([^\n·]+)", head)
    if m and m.group(1).strip("*` ") not in ("—", "-", ""):
        target = m.group(1).strip("*`— ")
        cands = [os.path.join(b, target) for b in (here, ROOT)]
        found = next((c for c in cands if os.path.exists(c)), None)
        if not found:
            bad.append(("DOC-OPS-001", rel, 1,
                        "supersedes %r, which does not exist" % target))
        elif "superseded by" not in open(found, encoding="utf-8").read().lower():
            bad.append(("DOC-OPS-001", rel, 1,
                        "one-sided supersede link · %s does not point back · "
                        "one of the two is wrong" % target))

    # DOC-NAM-001 / 003 / 004 / 007 · the filename
    base = os.path.basename(rel)
    if base not in SKIP_NAMES and base != base.lower() and not base.isupper():
        if not re.match(r"^[A-Z][A-Z0-9_.-]*$", base.split(".")[0]):
            bad.append(("DOC-NAM-006", rel, 0,
                        "mixed case in a non entry-point name: %r" % base))
    # An underscore is wrong in any name — including an entry point.
    # The earlier guard let an all-caps name through, which is a different rule.
    if "_" in base.split(".")[0]:
        bad.append(("DOC-NAM-001", rel, 0, "underscore in name · use hyphens: %r" % base))
    if re.search(r"-(v\d+|final|new|old|copy)(\.|$)", base, re.I):
        bad.append(("DOC-NAM-004", rel, 0,
                    "version suffix in name: %r · two documents for one subject" % base))
    if re.search(r"\d{4}-\d{2}-\d{2}", base):
        bad.append(("DOC-NAM-003", rel, 0, "date in filename: %r" % base))

    return bad


def capability_map():
    """DOC-CAP-001/002 · does the capability map agree with the tree?

    ⭐ TWO DIRECTIONS, AND THE SECOND IS THE ONE THAT GETS FORGOTTEN.
      · a row that names a piece which does not exist, unmarked → the reader
        runs a command that is not there
      · ⛔ a piece that exists and the map never names → quieter and longer
        lived: it works, nothing points at it, and somebody rebuilds it because
        they could not find it

    ⚠️ Only a script notices the second one — reading the map cannot reveal what
    the map left out.

    ⭐ `⬜` is the marker for "planned, not built", and a marked row is CORRECT:
    the map is allowed to describe what the engine will enforce, as long as the
    reader can tell that from what it enforces today.
    """
    cap = os.path.join(ROOT, "CAPABILITIES.md")
    if not os.path.exists(cap):
        return None                    # ⬜ said out loud by the caller
    try:
        lines = open(cap, encoding="utf-8", errors="replace").read().splitlines()
    except OSError:
        return None
    bad = []
    named = set()
    for n, line in enumerate(lines, 1):
        for m in re.finditer(r"`((?:bin|hooks)/[A-Za-z0-9_.-]+)", line):
            piece = m.group(1)
            named.add(piece)
            if os.path.exists(os.path.join(ROOT, piece)):
                continue
            # ⭐ A row that MARKS itself as unbuilt is doing the right thing.
            if "⬜" in line:
                continue
            bad.append(("DOC-CAP-001", "CAPABILITIES.md", n,
                        "names %s, which does not exist and is not marked ⬜ · "
                        "a planned row read as a working one sends the reader to "
                        "run nothing" % piece))
    # DOC-CAP-002 · the other direction. ⚠️ Only what an agent would RUN counts:
    # a shared helper is not a capability, and demanding it be listed would turn
    # the map into a file listing.
    for folder in ("bin", "hooks"):
        d = os.path.join(ROOT, folder)
        if not os.path.isdir(d):
            # ⬜ CHK-CAU-003 · a folder that is not there is not "nothing to
            # check": it means NO capability from it can be verified, and a map
            # measured against half the tree looks exactly like a correct one.
            bad.append(("DOC-CAP-002", "CAPABILITIES.md", 0,
                        "⬜ NOT MEASURED · %s/ does not exist · nothing in it "
                        "was compared against the map" % folder))
            continue
        for name in sorted(os.listdir(d)):
            f = os.path.join(d, name)
            if (not os.path.isfile(f) or name.startswith(("_", "."))
                    or name.endswith(".md") or not os.access(f, os.X_OK)):
                continue
            if "%s/%s" % (folder, name) not in named:
                bad.append(("DOC-CAP-002", "CAPABILITIES.md", 0,
                            "%s/%s exists, is executable, and the map never "
                            "names it · a piece nobody can find is a piece "
                            "nobody uses" % (folder, name)))
    return bad


def main():
    quiet = "--quiet" in sys.argv
    if not os.path.exists(CONTRACT):
        print("🔴 the contract itself is missing: rules/contract-document.md")
        return 2
    ceilings = read_ceilings(open(CONTRACT, encoding="utf-8").read())
    if not ceilings:
        print("🔴 no ceiling table found in the contract · DOC-SIZ-001 cannot be checked")
        return 2

    cap = capability_map()
    findings = list(cap) if cap else []
    if cap is None and not quiet:
        print("⬜ NOT MEASURED · no CAPABILITIES.md · whether the map matches "
              "the tree was not checked")
    checked = 0
    for dirpath, dirnames, filenames in os.walk(ROOT):
        dirnames[:] = [d for d in dirnames if d not in SKIP_DIRS]
        _rel = os.path.relpath(dirpath, ROOT).replace(os.sep, "/")
        if _rel in SKIP_DIR_PATHS:
            continue          # ⬜ governed by contract-adr.md, not by this one
        for name in sorted(filenames):
            if not name.endswith(".md") or name in OWNED_ELSEWHERE:
                continue
            path = os.path.join(dirpath, name)
            rel = os.path.relpath(path, ROOT)
            checked += 1
            findings += check(path, rel, ceilings, quiet)

    if not quiet:
        print("check-document · %d documents · %d ceilings declared" % (checked, len(ceilings)))
    if findings:
        for cid, rel, ln, msg in findings:
            print("🔴 %s:%d · %s · %s" % (rel, ln, cid, msg))
        print("\n%d violations · rule: rules/contract-document.md" % len(findings))
        return 1
    if not quiet:
        print("✅ 0 violations")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except Exception as e:
        # CHK-CAU-002 · a crash reports nothing, and "nothing reported" reads
        # exactly like "nothing wrong". Turn it into a finding, not a trace.
        print("🔴 %s crashed · %s: %s"
              % (os.path.basename(__file__), type(e).__name__, e))
        sys.exit(1)
